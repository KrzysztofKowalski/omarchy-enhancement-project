+				if (devinfo->state == BRCMFMAC_PCIE_STATE_UP)
+					brcmf_proto_msgbuf_rx_trigger(
 							&devinfo->pdev->dev);
+			}
 		}
 	}
 	brcmf_pcie_bus_console_read(devinfo, false);
@@ -1838,6 +2076,9 @@
 	return 0;
 }
 
+/* BCM4360 test.308 phase 3: txdata over the olmsg ring (type 0x11 TX frame
+ * per wl.ko wlc_ol_armtx @0x7f8b4) is deferred until dcmds work -- keep the
+ * stub so nothing accidentally pushes data on an unverified transport. */
 static int brcmf_pcie_tx(struct device *dev, struct sk_buff *skb)
 {
 	return 0;
@@ -1847,6 +2088,27 @@
 static int brcmf_pcie_tx_ctlpkt(struct device *dev, unsigned char *msg,
 				uint len)
 {
+	struct brcmf_bus *bus_if = dev_get_drvdata(dev);
+	struct brcmf_pciedev_info *devinfo = bus_if->bus_priv.pcie->devinfo;
+	int ret;
+
+	if (!bcm4360_olmsg_active(devinfo))
+		return 0;	/* msgbuf path does not use txctl */
+
+	/* At most one outstanding ctl (bcdc serializes queries); arm the
+	 * pending state BEFORE the doorbell so an immediate D2H response
+	 * (ISR runs in a thread) still matches. */
+	devinfo->olmsg_resp_seq = devinfo->olmsg_seq;
+	devinfo->olmsg_resp_pending = true;
+	devinfo->olmsg_resp_len = 0;
+
+	ret = bcm4360_olmsg_write(devinfo, BCM4360_OLMSG_TYPE_CDC_DCMD,
+				  msg, len);
+	if (ret) {
+		devinfo->olmsg_resp_pending = false;
+		return ret;
+	}
+	devinfo->olmsg_seq++;
 	return 0;
 }
 
@@ -1854,7 +2116,28 @@
