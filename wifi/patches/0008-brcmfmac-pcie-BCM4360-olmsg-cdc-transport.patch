+		msecs_to_jiffies(BCM4360_OLMSG_CTL_RESP_TIMEOUT_MS));
+	if (timeleft == 0) {
+		devinfo->olmsg_resp_pending = false;
+		brcmf_err(bus_if, "olmsg: ctl response timeout\n");
+		return -ETIMEDOUT;
+	}
+	if (timeleft < 0) {
+		devinfo->olmsg_resp_pending = false;
+		return -ERESTARTSYS;
+	}
+	memcpy(msg, devinfo->olmsg_resp_data,
+	       min(len, devinfo->olmsg_resp_len));
+	return devinfo->olmsg_resp_len;
 }
 
 
