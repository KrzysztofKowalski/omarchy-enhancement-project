 static void bcm4360_t315_prerelease_probe(struct brcmf_pciedev_info *devinfo,
 					  u32 db_val)
 {
 	u32 t315_mbmask;
 	u32 t315_rd;
+	u32 t316_is;
+	u32 t316_im;
 
 	/* (P3) reset-state MAILBOXMASK, read-only: kimptoc T284 read
 	 * 0x318 here PRE-set_active (anomaly A0, kimptoc-test28-comparison
 	 * sec.4-A0) and 0 post-set_active (the ARM release clears the
 	 * mask); reproduce the read on our substrate. */
-	pr_emerg("BCM4360 test.315: P3 MAILBOXMASK read (BAR0+0x4C, ARM halted) now\n");
+	pr_emerg("BCM4360 test.315/316: P3 MAILBOXMASK read (BAR0+0x4C, ARM halted) now\n");
 	t315_mbmask = brcmf_pcie_read_reg32(devinfo,
 					    BRCMF_PCIE_PCIE2REG_MAILBOXMASK);
-	pr_emerg("BCM4360 test.315: P3 MAILBOXMASK=0x%08x (0x318 = kimptoc anomaly A0 reproduced; 0 = reset state)\n",
+	pr_emerg("BCM4360 test.315/316: P3 MAILBOXMASK=0x%08x (0x318 = kimptoc anomaly A0 reproduced; 0 = reset state)\n",
 		 t315_mbmask);
 
 	/* (P1) pre-release H2D doorbell: PLAIN write, NOT the |= RMW of
@@ -1757,15 +1776,41 @@
 	 * the fw consumes it in the first milliseconds of boot -- the
 	 * T279 post-poll doorbell was dead in every test, fire #7
 	 * included. */
-	pr_emerg("BCM4360 test.315: P1 pre-release doorbell MAILBOXINT (BAR0+0x48) := 0x%08x now (LAST LINE if this write kills the machine)\n",
+	pr_emerg("BCM4360 test.315/316: P1 pre-release doorbell MAILBOXINT (BAR0+0x48) := 0x%08x now (LAST LINE if this write kills the machine)\n",
 		 db_val);
 	brcmf_pcie_write_reg32(devinfo, BRCMF_PCIE_PCIE2REG_MAILBOXINT,
 			       db_val);
-	pr_emerg("BCM4360 test.315: P1 doorbell posted -- readback now\n");
+	pr_emerg("BCM4360 test.315/316: P1 doorbell posted -- readback now\n");
 	t315_rd = brcmf_pcie_read_reg32(devinfo,
 					BRCMF_PCIE_PCIE2REG_MAILBOXINT);
-	pr_emerg("BCM4360 test.315: P1 readback=0x%08x (db_val=0x%08x; ==db_val => latched unconsumed; 0 => cleared/consumed)\n",
+	pr_emerg("BCM4360 test.315/316: P1 readback=0x%08x (db_val=0x%08x; ==db_val => latched unconsumed; 0 => cleared/consumed)\n",
 		 t315_rd, db_val);
+
+	/* (P1-T, test.316) mirror check: two windowed SB-side reads in the
+	 * same pre-release window (ARM still halted), immediately after the
+	 * P1 readback. Fire #9: the P1 readback measured 0x3 (the 0xFFFFFFFF
+	 * write masked down to the two doorbell bits) but post-set_active
+	 * mbint=0 -- chip_set_active CLEARS the mailbox, the frozen fw never
+	 * saw the doorbell. Question: was kimptoc's intstatus=0x300 (his
+	 * pre-set_active read, T284-era) a HW mirror of HIS OWN pre-release
+	 * MAILBOXINT write, or a fw-side latch? intstatus=0x300 HERE
+	 * (pre-release, no fw ISR could have run yet, and our P1 write just
+	 * latched mbint=0x3) => mirror; ~0/0x80 => no mirror -- kimptoc's
+	 * 0x300 was a fw-side latch of an fw that ran past 637. Same
+	 * windowed single-read class as the T315 discriminator (proven live
+	 * in fires #6-#9); stalling reads: fire ONLY with CTO 10-100 ms. */
+	pr_emerg("BCM4360 test.315/316: P1-T SB intstatus read (BAR0+0x20, pre-release) now\n");
+	t316_is = brcmf_pcie_read_reg32(devinfo,
+					BCM4360_OLMSG_SB_INTSTATUS);
+	pr_emerg("BCM4360 test.315/316: P1-T SB intstatus=0x%08x\n",
+		 t316_is);
+	pr_emerg("BCM4360 test.315/316: P1-T SB intmask read (BAR0+0x24, pre-release) now\n");
+	t316_im = brcmf_pcie_read_reg32(devinfo,
+					BCM4360_OLMSG_SB_INTMASK);
+	pr_emerg("BCM4360 test.315/316: P1-T SB intmask=0x%08x\n",
+		 t316_im);
+	pr_emerg("BCM4360 test.315/316: P1-T mirror check: intstatus=0x%08x intmask=0x%08x mbint=0x%08x -- intstatus=0x300 pre-release => kimptoc 0x300 = HW mirror of his own pre-release write; 0x80 => no mirror (kimptoc 0x300 = fw-side latch, his fw ran past 637)\n",
+		 t316_is, t316_im, t315_rd);
 }
 
 /* ==== BCM4360 test.315: DISCRIMINATOR (immediately after set_active) ====
@@ -1853,11 +1898,13 @@
 			brcmf_chip_resetcore(core, 0, 0, 0);
 	}
 
-	/* test.315 P3+P1: between the test276 shared_info write and the
-	 * ARM release -- the only window in which the fw ever answered a
-	 * host doorbell (kimptoc test.28). The set_active return value is
-	 * kept unchanged, so the -EIO fail path is identical. */
-	if (devinfo->ci->chip == BRCM_CC_4360_CHIP_ID && bcm4360_test315)
+	/* test.315/316 P3+P1+P1-T: between the test276 shared_info write and
+	 * the ARM release -- the only window in which the fw ever answered a
+	 * host doorbell (kimptoc test.28). test.316 P1-T reuses the same
+	 * block (test315 || test316). The set_active return value is kept
+	 * unchanged, so the -EIO fail path is identical. */
+	if (devinfo->ci->chip == BRCM_CC_4360_CHIP_ID &&
+	    (bcm4360_test315 || bcm4360_test316))
 		bcm4360_t315_prerelease_probe(devinfo, bcm4360_test315_db_val);
 
 	t315_active = brcmf_chip_set_active(devinfo->ci, resetintr);
@@ -3060,7 +3107,25 @@
 	 */
 	brcmf_pcie_write_ram32(devinfo, devinfo->ci->ramsize - 4, 0);
 
-	if (nvram) {
+	if (bcm4360_test316 && nvram &&
+	    devinfo->ci->chip == BRCM_CC_4360_CHIP_ID) {
+		/* BCM4360 test.316 R3b: skip the WHOLE NVRAM download -- no
+		 * vars buffer copy and no end token (the token is the last
+		 * 4 B of that same buffer, so it would land at
+		 * TCM[ramsize-4]; the write_ram32(ramsize-4, 0) above leaves
+		 * the sharedram marker at 0, exactly the no-NVRAM state).
+		 * This is the exact kimptoc test.28 substrate: his fw had NO
+		 * NVRAM (bmac_attach err 15 -> TRAP) and still ran past 637
+		 * console bytes. PRECEDENCE over the test.315 R3a strip:
+		 * with test316=1 the vars buffer never leaves host RAM, so
+		 * a strip (if test315 is set too) is moot. The test276
+		 * varsz/vars16 snapshot below then reads zeros -- expected,
+		 * and the fw sees the same (varsz=0). CPU-only, zero MMIO;
+		 * the buffer is freed un-downloaded (for 4360 the fwseed
+		 * branch below is inactive anyway -- WCC sets fw_seed=0). */
+		pr_emerg("BCM4360 test.316: R3b NVRAM download SKIPPED (no vars, no token -- kimptoc test.28 replication; T276 varsz/vars16 snapshot will read zeros -- expected)\n");
+		brcmf_fw_nvram_free(nvram);
+	} else if (nvram) {
 		brcmf_dbg(PCIE, "Download NVRAM %s\n", devinfo->nvram_name);
 		address = devinfo->ci->rambase + devinfo->ci->ramsize -
 			  nvram_len;
@@ -3370,6 +3435,92 @@
 							 BCM4360_T277_BUFFER_DUMP_BYTES,
 							 chunk);
 					}
+
+					/* BCM4360 test.316 console TAIL: the
+					 * last min(wr_idx, 96) bytes of the
+					 * console buffer, ending at wr_idx.
+					 * Only the HEAD (first 128 B) of the
+					 * console is known so far -- the last
+					 * fw print before the stall is the key
+					 * evidence (wr_idx=0x27d=637 in fires
+					 * #6-#9). Same TCM dword-read mechanism
+					 * as the HEAD dump above; the read
+					 * starts 4 B aligned (<=3 B of earlier
+					 * console text printed in front, the
+					 * printed span ends exactly at wr_idx).
+					 * INDEPENDENT of bcm4360_test316 --
+					 * runs whenever this POST-POLL dump
+					 * runs. */
+					if (bcm4360_test316_console_tail) {
+						u32 t316_buf = t277_struct[0];
+						u32 t316_bsz = t277_struct[1];
+						u32 t316_wr = t277_struct[2];
+						u32 t316_n =
+							min_t(u32, t316_wr,
+									(u32)BCM4360_T316_CONSOLE_TAIL_BYTES);
+						u32 t316_start =
+							t316_wr - t316_n;
+						u32 t316_aread =
+							t316_start & ~3u;
+						u32 t316_dwords =
+							(t316_wr - t316_aread + 3) / 4;
+						u32 t316_span =
+							t316_wr - t316_aread;
+						u32 t316_tail_u32[
+							BCM4360_T316_CONSOLE_TAIL_BYTES / 4 + 1];
+						u8 *t316_valid =
+							(u8 *)t316_tail_u32 +
+							(t316_aread - t316_start);
+						u32 t316_k;
