+									 t316_wr,
+									 (int)min_t(u32, t316_span, 64),
+									 t316_valid);
+							if (t316_span > 64)
+								pr_emerg("BCM4360 test.316: POST-POLL console TAIL hex cont [+%u..+%u): %*ph\n",
+										 t316_start + 64,
+										 t316_wr,
+										 (int)(t316_span - 64),
+										 t316_valid + 64);
+							pr_emerg("BCM4360 test.316: POST-POLL console TAIL [+%u..+%u) ascii: %*pE\n",
+									 t316_start,
+									 t316_wr,
+									 (int)t316_span,
+									 t316_valid);
+						}
+					}
 				}
 			}
 		}
