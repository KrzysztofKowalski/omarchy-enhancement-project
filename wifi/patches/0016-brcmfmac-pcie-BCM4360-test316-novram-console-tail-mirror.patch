+									 t316_bsz,
+									 t316_wr,
+									 devinfo->ci->ramsize);
+						} else {
+							pr_emerg("BCM4360 test.316: POST-POLL console TAIL read (TCM @0x%08x, last %u B ending at wr_idx=%u, %u dwords) now\n",
+									 t316_buf +
+											t316_aread,
+									 t316_n,
+									 t316_wr,
+									 t316_dwords);
+							for (t316_k = 0;
+									 t316_k < t316_dwords;
+									 t316_k++)
+										t316_tail_u32[t316_k] =
+												brcmf_pcie_read_ram32(
+											devinfo,
+											t316_buf +
+											t316_aread +
+											t316_k * 4);
+							pr_emerg("BCM4360 test.316: POST-POLL console TAIL [+%u..+%u) hex: %*ph\n",
