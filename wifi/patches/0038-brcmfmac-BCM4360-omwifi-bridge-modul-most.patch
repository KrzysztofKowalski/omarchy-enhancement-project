+/* Dump of the D2H ring contents (host RAM, ZERO MMIO) -- a diagnostic
+ * command: it reads the same as om_d2h_scan but does NOT move rd, so
+ * the data is not lost when the command is repeated. */
+static void om_op_d2h(struct om_bridge *b, int argc, char **argv)
+{
+	u32 rd, wr, n, off;
+	u32 wiadomosci = 0;
+
+	if (!b->dma_va) {
+		om_blad(b, "d2h: no DMA buffer\n");
+		return;
+	}
+	rd = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD);
+	wr = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR);
+	om_odp(b, "d2h: D2H ring rd=%u wr=%u (host RAM read, zero MMIO; I do NOT move rd)\n",
+	       rd, wr);
+	if (!wr || wr > OM_RING_ROZMIAR) {
+		om_odp(b, "d2h: empty -- the fw wrote nothing (the H2D->fw channel is one-way; the only known D2H message is TRAP_IND)\n");
+		return;
+	}
+	n = (wr >= rd) ? (wr - rd) : (OM_RING_ROZMIAR - rd + wr);
+	for (off = 0; off + OM_OLMSG_HDR <= n && wiadomosci < 32; ) {
+		u32 typ = om_buf_rd32(b, OM_RING_DATA_D2H + off);
+		u32 seq = om_buf_rd32(b, OM_RING_DATA_D2H + off + 4);
+		u32 len = om_buf_rd32(b, OM_RING_DATA_D2H + off + 8);
+
+		if (off + OM_OLMSG_HDR + len > OM_RING_ROZMIAR) {
+			om_blad(b, "d2h: header @+0x%04x incoherent (len %u) -- aborting\n",
+				OM_RING_DATA_D2H + off, len);
+			break;
+		}
+		om_odp(b, "d2h: #%u @buf+0x%04x type=0x%08x seq=%u len=%u\n",
+		       wiadomosci, OM_RING_DATA_D2H + off, typ, seq, len);
+		if (len) {
+			u32 v[4] = { 0, 0, 0, 0 };
+			u32 nn = (len > 16) ? 16 : len;
+			u32 i;
+
+			for (i = 0; i + 4 <= nn; i += 4)
+				v[i / 4] = om_buf_rd32(b, OM_RING_DATA_D2H + off + OM_OLMSG_HDR + i);
+			om_odp(b, "d2h:    payload[0..%u): %08x %08x %08x %08x%s\n",
+			       nn, v[0], v[1], v[2], v[3], len > 16 ? " ..." : "");
+		}
+		off += OM_OLMSG_HDR + len;
+		wiadomosci++;
+	}
+	if (!wiadomosci)
+		om_odp(b, "d2h: the ring declares wr=%u but no header could be recognized\n", wr);
+}
