+/* ======================================================== urzadzenie znakowe */
+
+static ssize_t om_fop_read(struct file *f, char __user *ubuf, size_t count, loff_t *pos)
+{
+	struct om_bridge *b;
+	size_t n;
+
+	if (mutex_lock_interruptible(&om_lock))
+		return -ERESTARTSYS;
+	b = om;
+	if (!b) {
+		mutex_unlock(&om_lock);
+		return -ENODEV;
+	}
+	if (b->resp_pos >= b->resp_len) {
+		mutex_unlock(&om_lock);
+		return 0;			/* EOF -- `cat` konczy prace */
+	}
+	n = min(count, b->resp_len - b->resp_pos);
+	if (copy_to_user(ubuf, b->resp + b->resp_pos, n)) {
+		mutex_unlock(&om_lock);
+		return -EFAULT;
+	}
+	b->resp_pos += n;
+	mutex_unlock(&om_lock);
+	return n;
+}
+
+static ssize_t om_fop_write(struct file *f, const char __user *ubuf, size_t count, loff_t *pos)
+{
+	struct om_bridge *b;
+	char *linia;
+	size_t n;
+
+	if (!count || count > OM_LINIA_MAX)
+		return -EINVAL;
+	linia = kzalloc(count + 1, GFP_KERNEL);
+	if (!linia)
+		return -ENOMEM;
+	if (copy_from_user(linia, ubuf, count)) {
+		kfree(linia);
+		return -EFAULT;
+	}
+	n = strcspn(linia, "\r\n");
+	linia[n] = 0;
+	if (mutex_lock_interruptible(&om_lock)) {
+		kfree(linia);
+		return -ERESTARTSYS;
+	}
+	b = om;
+	if (!b) {
+		mutex_unlock(&om_lock);
+		kfree(linia);
+		return -ENODEV;
+	}
+	/* Wynik komendy jest w ODPOWIEDZI, nie w kodzie wyjscia write(): klient
+	 * userspace traktuje krotki/nieudany write jako blad TRANSPORTU, a odrzucona
+	 * komenda (np. maccontrol bez tokenu d11-ok) bledem transportu nie jest.
+	 * Dlatego konsumujemy CALY bufor i zwracamy count -- takze gdy komenda
+	 * byla odrzucona; tresc odmowy czeka w buforze odpowiedzi na `read`. */
+	om_wykonaj(b, linia);
+	mutex_unlock(&om_lock);
+	kfree(linia);
+	return (ssize_t)count;
+}
+
+static const struct file_operations om_fops = {
+	.owner = THIS_MODULE,
+	.read = om_fop_read,
+	.write = om_fop_write,
+	.llseek = noop_llseek,
+};
+
+/* ============================================================ sterownik PCI */
+
+static int om_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct om_bridge *b;
+	int err;
+	u32 win = 0;
+	u16 cmd = 0;
+
+	mutex_lock(&om_lock);
+	if (om) {
+		mutex_unlock(&om_lock);
+		dev_err(&pdev->dev, OM_NAZWA ": karta juz trzymana przez most (jeden egzemplarz)\n");
+		return -EBUSY;
+	}
+	mutex_unlock(&om_lock);
+
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->pdev = pdev;
+	/* 16 KiB odpowiedzi na komende -- konsola fw (~1,6 KB) i zrzuty musza sie zmiescic */
+	b->resp = kzalloc(OM_RESP_MAX, GFP_KERNEL);
+	if (!b->resp) {
+		err = -ENOMEM;
+		goto blad_alloc;
+	}
+
+	err = pci_enable_device(pdev);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_enable_device = %d\n", err);
+		goto blad_alloc;
+	}
+	err = pci_request_regions(pdev, OM_NAZWA);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_request_regions = %d\n", err);
+		goto blad_wylacz;
+	}
+	pci_set_master(pdev);
+	b->bar2_len = pci_resource_len(pdev, 2);
+	b->bar0 = pci_iomap(pdev, 0, 0);
+	b->bar2 = pci_iomap(pdev, 2, 0);
+	if (!b->bar0 || !b->bar2) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_iomap nieudane (bar0=%p bar2=%p)\n",
+			b->bar0, b->bar2);
+		err = -EIO;
+		goto blad_regiony;
+	}
+	if (b->bar2_len < OM_RAMSIZE) {
+		dev_err(&pdev->dev, OM_NAZWA ": BAR2 = 0x%llx B < ramsize 0x%x -- zla karta albo zly BAR\n",
+			(unsigned long long)b->bar2_len, OM_RAMSIZE);
+		err = -EINVAL;
+		goto blad_mapowanie;
+	}
+
+	/* Bufor DMA na pierscienie olmsg: 64 KiB = msgbuf_sz kontraktu (pcie.c:108;
+	 * ten sam rozmiar w module). Maska 32-bit jest tu ISTOTNA -- fw 7.77 czyta
+	 * z kontraktu tylko dolny dword i buduje okno 64 MiB, wiec bufor musi lezec
+	 * < 4 GiB; sprawdzamy to jawnie bramka om_dma_adres_ok() (nie "ufamy, ze
+	 * wyjdzie": w fire'ach modul dostawal 0x01280000, ale to nie jest gwarancja). */
+	err = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		dev_warn(&pdev->dev, OM_NAZWA ": dma_set_mask_and_coherent(32 bity) = %d -- kontynuuje, bramka adresu i tak sprawdzi wynik\n",
+			 err);
+	b->dma_va = dma_alloc_coherent(&pdev->dev, OM_DMA_ROZMIAR, &b->dma_fiz, GFP_KERNEL);
+	if (!b->dma_va) {
+		dev_err(&pdev->dev, OM_NAZWA ": dma_alloc_coherent(%u) nieudane\n", OM_DMA_ROZMIAR);
+		err = -ENOMEM;
+		goto blad_mapowanie;
+	}
+	b->dma_ok = om_dma_adres_ok(b->dma_fiz);
+
+	/* Niezmiennik od razu po mapowaniu: okno backplane na PCIE2. Bez tego
+	 * bezposrednie odczyty BAR0+0x20/0x24/0x48/0x4C (ISR, `irq`, doorbell
+	 * readback) moglyby trafic w inny rdzen -- PCIE2 widac pod BAR0 tylko
+	 * przy oknie = 0x18003000 (notes/;
+	 * pcie.c brcmf_pcie_select_core robi to samo przed kazdym dostepem). */
+	om_okno_restore(b);
+
+	b->misc.minor = MISC_DYNAMIC_MINOR;
+	b->misc.name = "omwifi";
+	b->misc.fops = &om_fops;
+	b->misc.mode = 0600;
+	err = misc_register(&b->misc);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": misc_register = %d\n", err);
+		goto blad_misc;
+	}
+
+	mutex_lock(&om_lock);
+	om = b;
+	mutex_unlock(&om_lock);
+	pci_set_drvdata(pdev, b);
+
+	pci_read_config_dword(pdev, OM_BAR0_WINDOW, &win);
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd);
+	dev_info(&pdev->dev, OM_NAZWA ": most gotowy: %s, BAR0=%p BAR2=%p (0x%llx B), DMA 0x%llx (%u B), okno 0x80 = 0x%08x, COMMAND = 0x%04x (bus-master b2 = %u)\n",
+		 OM_DEV, b->bar0, b->bar2, (unsigned long long)b->bar2_len,
+		 (unsigned long long)b->dma_fiz, OM_DMA_ROZMIAR, win, cmd, (cmd >> 2) & 1u);
+	dev_info(&pdev->dev, OM_NAZWA ": bufor DMA przechodzi bramke fw 7.77 (<4 GiB i okno 64 MiB): %s\n",
+		 b->dma_ok ? "TAK" : "NIE");
+	if (!b->dma_ok)
+		dev_emerg(&pdev->dev, OM_NAZWA ": UWAGA adres DMA 0x%llx NIE przechodzi bramki -- `contract` pominie pola msgbufaddr, a `ringinit`/`send`/`sendtrio` beda ODMAWIAC\n",
+			  (unsigned long long)b->dma_fiz);
+	dev_info(&pdev->dev, OM_NAZWA ": sekwencja startowa: echo \"reset\" > %s; echo \"zero\" > %s; echo \"loadfw <obraz>\" > %s; echo \"contract\" > %s; echo \"vars <vars>\" > %s; echo \"ringinit\" > %s; echo \"release\" > %s; echo \"gate\" > %s; echo \"irq on\" > %s; echo \"sendtrio\" > %s\n",
+		 OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV);
+	return 0;
+
+blad_misc:
+	dma_free_coherent(&pdev->dev, OM_DMA_ROZMIAR, b->dma_va, b->dma_fiz);
+blad_mapowanie:
+	if (b->bar0)
+		pci_iounmap(pdev, b->bar0);
+	if (b->bar2)
+		pci_iounmap(pdev, b->bar2);
+blad_regiony:
+	pci_release_regions(pdev);
+blad_wylacz:
+	pci_disable_device(pdev);
+blad_alloc:
+	kfree(b->resp);
+	kfree(b);
+	return err;
+}
+
+static void om_remove(struct pci_dev *pdev)
+{
+	struct om_bridge *b = pci_get_drvdata(pdev);
+
+	if (!b)
+		return;
+	mutex_lock(&om_lock);
+	om = NULL;
+	mutex_unlock(&om_lock);
+	if (b->irq_on) {
+		free_irq(pdev->irq, b);
+		b->irq_on = false;
+	}
+	if (b->msi_on)
+		pci_disable_msi(pdev);
+	misc_deregister(&b->misc);
+	om_okno_restore(b);
+	if (b->dma_va)
+		dma_free_coherent(&pdev->dev, OM_DMA_ROZMIAR, b->dma_va, b->dma_fiz);
+	if (b->bar0)
+		pci_iounmap(pdev, b->bar0);
+	if (b->bar2)
+		pci_iounmap(pdev, b->bar2);
+	pci_release_regions(pdev);
+	pci_disable_device(pdev);
+	pci_set_drvdata(pdev, NULL);
+	kfree(b->resp);
+	kfree(b);
+}
+
+static const struct pci_device_id om_id_tabela[] = {
+	{ PCI_DEVICE(OM_VENDOR, OM_DEVICE_4360) },
+	{ 0, }
+};
+MODULE_DEVICE_TABLE(pci, om_id_tabela);
+
+static struct pci_driver om_driver = {
+	.name = OM_NAZWA,
+	.id_table = om_id_tabela,
+	.probe = om_probe,
+	.remove = om_remove,
+};
+
+/* ============================================================== init / exit */
+
+/* Sprawdzenie PRZED rejestracja sterownika: czy karta nie jest juz zbindowana
+ * do innego sterownika (wymaganie 2). Gdyby byla (np. brcmfmac), probe() nigdy
+ * by sie nie wykonal, a modul "zaladowalby sie po cichu" i nic nie robil --
+ * dlatego ODMOWUJEMY JAWNIE, z nazwa sterownika i gotowa komenda. */
+static int om_sprawdz_zajetosc(void)
+{
+	struct pci_dev *pdev;
+	int err = 0;
+
+	pdev = pci_get_device(OM_VENDOR, OM_DEVICE_4360, NULL);
+	if (!pdev) {
+		pr_err(OM_NAZWA ": ODMOWA: brak karty %04x:%04x na PCI -- nie ma czego przejac\n",
+		       OM_VENDOR, OM_DEVICE_4360);
+		return -ENODEV;
+	}
+	if (pdev->dev.driver) {
+		pr_err(OM_NAZWA ": ODMOWA: karta %s jest juz zbindowana do sterownika `%s` -- odczekaj/odbinduj go (CLAUDE.md p.5: po fire zakaz rmmod => REBOOT), potem zaladuj most\n",
+		       pci_name(pdev), pdev->dev.driver->name);
+		err = -EBUSY;
+	} else {
+		pr_info(OM_NAZWA ": karta %s wolna (bez sterownika) -- most moze ja przejac\n",
+			pci_name(pdev));
+	}
+	pci_dev_put(pdev);
+	return err;
+}
+
+static int __init om_init(void)
+{
+	int err;
+
+	pr_info(OM_NAZWA ": inicjalizacja (d11_ok=%u; strona D11 0x%08x dostepna %s)\n",
+		d11_ok ? 1 : 0, OM_D11_BASE,
+		d11_ok ? "TYLKO komenda maccontrol z tokenem d11-ok" : "NIGDY (d11_ok=0)");
+
+	/* Wymaganie 2: bez pci_reset_function() most NIE MOZE dzialac (caly cykl
+	 * bez rebootu stoi na SBR -- notes/). Symbol
+	 * jest EXPORT_SYMBOL_GPL (drivers/pci/pci.c:5202, deklaracja
+	 * include/linux/pci.h:1473), nie jest za zadnym CONFIG_* i modul go
+	 * WOLA -- w kernelu bez niego insmod konczy sie unresolved symbol
+	 * (glosno), a nie po cichu. Ten warunek jest dodatkowym, jawnym
+	 * sprawdzeniem tej samej rzeczy przed jakimkolwiek dotknieciem karty. */
+	if (!IS_ENABLED(CONFIG_PCI)) {
+		pr_err(OM_NAZWA ": ODMOWA: kernel bez CONFIG_PCI -- nie ma pci_reset_function ani BAR-ow\n");
+		return -ENODEV;
+	}
+	if (!om_reset_fn) {
+		pr_err(OM_NAZWA ": ODMOWA: brak pci_reset_function w tym kernelu -- most nie ma czym robic SBR\n");
+		return -ENODEV;
+	}
+
+	err = om_sprawdz_zajetosc();
+	if (err)
+		return err;
+
+	err = pci_register_driver(&om_driver);
+	if (err) {
+		pr_err(OM_NAZWA ": pci_register_driver = %d\n", err);
+		return err;
+	}
+	pr_info(OM_NAZWA ": sterownik zarejestrowany; %s pojawi sie po przejeciu karty\n",
+		OM_DEV);
+	return 0;
+}
+
+static void __exit om_exit(void)
+{
+	pci_unregister_driver(&om_driver);
+	pr_info(OM_NAZWA ": most usuniety (projektowy zakaz rmmod po fire -- CLAUDE.md p.5; TCM nie czysci sie rebootem)\n");
+}
+
+module_init(om_init);
+module_exit(om_exit);
+
+MODULE_AUTHOR("OpenWiFi BCM4360 Project");
+MODULE_DESCRIPTION("BCM4360 (14e4:43a0) bridge: holds the card and exposes the 7.77 host side through /dev/omwifi (patch 0038)");
+MODULE_LICENSE("Dual BSD/GPL");
