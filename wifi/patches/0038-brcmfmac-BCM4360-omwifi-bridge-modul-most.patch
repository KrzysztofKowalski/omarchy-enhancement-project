+static void om_wykonaj(struct om_bridge *b, char *linia)
+{
+	char *argv[8];
+	int argc = 0;
+	char *p = linia;
+	unsigned int i;
+
+	while (argc < (int)ARRAY_SIZE(argv)) {
+		char *tok = strsep(&p, " \t");
+
+		if (!tok)
+			break;
+		if (!*tok)
+			continue;
+		argv[argc++] = tok;
+	}
+	if (!argc) {
+		om_blad(b, "(pusta komenda) -- `help`\n");
+		return;
+	}
+
+	b->odmowa_d11_log = false;
+	b->okno_mask_log = false;
+	b->resp_uciete = false;
+	b->resp_len = 0;
+	b->resp_pos = 0;
+	b->resp[0] = 0;
+
+	/* Niezmiennik, od ktorego zalezy ISR i bezposrednie odczyty BAR0+0x20/
+	 * 0x24/0x48/0x4C: okno backplane wskazuje PCIE2. Ustawiamy je PRZED
+	 * kazda komenda (koszt = jeden zapis config), zeby zaden wczesniejszy
+	 * przebieg nie zostawil okna na innym rdzeniu. */
+	om_okno_restore(b);
+
+	for (i = 0; i < ARRAY_SIZE(om_tabela); i++) {
+		if (!strcmp(argv[0], om_tabela[i].nazwa)) {
+			om_odp(b, "> %s\n", linia);
+			om_tabela[i].fn(b, argc, argv);
+			return;
+		}
+	}
+	om_blad(b, "nieznana komenda `%s` -- `help`\n", argv[0]);
+}
