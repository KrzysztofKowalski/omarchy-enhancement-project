+/* ==================================================================== status */
+
+static void om_op_status(struct om_bridge *b, int argc, char **argv)
+{
+	u32 cc = 0;
+	u32 hb = 0, fl = 0;
+	u32 console_wr = 0, ptr = 0, buf = 0, size = 0, wr = 0;
+	u32 ioctl_arm = 0, win = 0;
+	u16 cmd = 0;
+
+	om_odp(b, "status: karta %04x:%04x (PCI rev %u) @ %s\n", b->pdev->vendor,
+	       b->pdev->device, b->pdev->revision, pci_name(b->pdev));
+	if (om_bp_read32(b, OM_CC_BASE, &cc) == 0)
+		om_odp(b, "status: ChipCommon @0x%08x = 0x%08x => chipid 0x%04x chiprev %u (oczekiwane 0x%04x / %u)\n",
+		       OM_CC_BASE, cc, cc & 0xffffu, (cc & 0x000f0000u) >> 16,
+		       OM_CHIPID_4360, OM_CHIPREV_4360);
+	else
+		om_blad(b, "status: nie moge odczytac ChipCommon @0x%08x\n", OM_CC_BASE);
+	om_odp(b, "status: rdzenie (logs/test.345.journalctl.txt:14-19): CC 0x%08x/0x%08x D11 0x%08x (strona ZAKAZANA) ARM 0x%08x/0x%08x PCIE2 0x%08x/0x%08x SOCRAM 0x%08x/0x%08x\n",
+	       OM_CC_BASE, OM_CC_WRAP, OM_D11_BASE, OM_ARM_BASE, OM_ARM_WRAP,
+	       OM_PCIE2_BASE, OM_PCIE2_WRAP, OM_SOCRAM_BASE, OM_SOCRAM_WRAP);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	pci_read_config_word(b->pdev, PCI_COMMAND, &cmd);
+	om_odp(b, "status: BAR0 0x%llx (%llu B) BAR2 0x%llx (%llu B); okno config 0x80 = 0x%08x (po operacji wraca na PCIE2 0x%08x)\n",
+	       (unsigned long long)pci_resource_start(b->pdev, 0),
+	       (unsigned long long)pci_resource_len(b->pdev, 0),
+	       (unsigned long long)pci_resource_start(b->pdev, 2),
+	       (unsigned long long)b->bar2_len, win, OM_PCIE2_BASE);
+	om_odp(b, "status: COMMAND (config offset 0x04) = 0x%04x (mem b1 = %u, bus-master b2 = %u)\n",
+	       cmd, (cmd >> 1) & 1u, (cmd >> 2) & 1u);
+	om_odp(b, "status: DMA: va=%p fiz=0x%llx rozmiar=%u B; bramka fw (<4 GiB i okno 64 MiB) = %s\n",
+	       b->dma_va, (unsigned long long)b->dma_fiz, OM_DMA_ROZMIAR,
+	       b->dma_ok ? "PRZECHODZI" : "ODRZUCONY -- pola msgbufaddr NIE publikowane");
+	if (b->dma_va)
+		om_odp(b, "status: pierscienie: H2D rd=%u wr=%u; D2H rd=%u wr=%u\n",
+		       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_RD),
+		       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR),
+		       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD),
+		       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR));
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &ioctl_arm) == 0)
+		om_odp(b, "status: ARM wrap IOCTL = 0x%08x (CPUHALT b5 = %u) => %s (flaga modulu: %s)\n",
+		       ioctl_arm, (ioctl_arm >> 5) & 1u,
+		       (ioctl_arm & OM_ARMCR4_IOCTL_CPUHALT) ? "ARM w halt" : "ARM wypuszczony",
+		       b->arm_wypuszczony ? "release poszedl" : "release NIE poszedl");
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	if (om_konsola(b, &ptr, &buf, &size, &wr) == 0)
+		console_wr = wr;
+	om_odp(b, "status: heartbeat(0x%04x) = 0x%08x, trap_flag(0x%04x) = 0x%08x%s\n",
+	       OM_K_HEARTBEAT, hb, OM_K_TRAP_FLAG, fl,
+	       fl == OM_TRAP_FLAG_VAL ? " <= FW W TRAPIE" : "");
+	om_odp(b, "status: konsola fw: ptr=0x%08x buf=0x%08x size=%u wr_idx=%u\n",
+	       ptr, buf, size, console_wr);
+	om_odp(b, "status: rstvec=%s0x%08x; d11_ok=%u (token `d11-ok` nadal wymagany w komendzie); irq=%s; msi=%s\n",
+	       b->rstvec_znamy ? "" : "(nieznany -- bez loadfw) ", b->rstvec, d11_ok ? 1 : 0,
+	       b->irq_on ? "ON" : "OFF", b->msi_on ? "ON" : "OFF");
+	om_odp(b, "status: hardening PCIe (ASPM off + CTO): %s\n",
+	       !b->hardening_bylo ? "NIE nakladany w tej sesji -- `reset` naklada go PO SBR (odpowiednik setpci przed kazdym fire)" :
+	       (b->hardening_ok ? "ZALOZONY, readback zgodny" :
+		"NIEZGODNY -- NIE kontynuuj bez rebootu (sciezka awaryjna: REBOOT + setpci z czystego boota)"));
+}
+
+/* ================================================= hardening PCIe (config) */
+
+/* Jeden zapis 16-bitowy w config space z readbackiem; zwraca 0 gdy wartosc
+ * sie utrzymala, -EIO gdy nie. `kto` sluzy tylko do logu. */
+static int om_hard_zapis(struct om_bridge *b, const char *kto, struct pci_dev *dev,
+			 u16 off, u16 val, const char *nazwa)
+{
+	u16 przed = 0, po = 0;
+
+	pci_read_config_word(dev, off, &przed);
+	pci_write_config_word(dev, off, val);
+	pci_read_config_word(dev, off, &po);
+	om_odp(b, "hardening: %s %s 0x%02x (%s): 0x%04x -> 0x%04x (exp 0x%04x) %s\n",
+	       kto, pci_name(dev), off, nazwa, przed, po, val,
+	       po == val ? "OK" : "NIE ZGADZA SIE");
+	if (po != val) {
+		om_blad(b, "hardening: %s %s 0x%02x = 0x%04x, a oczekiwane 0x%04x\n",
+			kto, pci_name(dev), off, po, val);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Hardening 1:1 ze scripts/minihost.sh:167-180: LnkCtl (ASPM off) + DevCtl2
+ * (CTO) na mostku i na endpoincie, potem READBACK WSZYSTKICH CZTERECH.
+ * Mostek bierzemy z pdev->bus->self (BDF-a NIE zaszywamy); gdy go nie ma,
+ * logujemy i POMIJAMY zapisy mostka -- endpoint robimy dalej, bo tam nie ma
+ * czego zgadywac (mamy `pdev`). Zwraca 0 (readback zgodny) albo -EIO. */
+static int om_hardening(struct om_bridge *b)
+{
+	struct pci_dev *mostek = b->pdev->bus ? b->pdev->bus->self : NULL;
+	int bledy = 0;
+
+	b->hardening_bylo = true;
+	om_emrg(b, "hardening: ASPM-off + CTO (LnkCtl/DevCtl2 na mostku i endpoincie) -- start; wzorzec scripts/minihost.sh:167-180\n");
+	if (!mostek) {
+		om_blad(b, "hardening: pdev->bus->self == NULL (brak mostka) -- zapisy mostka POMINIETE; BDF-a nie zgaduje; robie tylko endpoint\n");
+	} else {
+		bledy += om_hard_zapis(b, "mostek", mostek, OM_HARD_MOSTEK_LNKCTL,
+				       OM_HARD_MOSTEK_LNKCTL_V, "LnkCtl (ASPM off)") < 0;
+		bledy += om_hard_zapis(b, "mostek", mostek, OM_HARD_MOSTEK_DEVCTL2,
+				       OM_HARD_MOSTEK_DEVCTL2_V, "DevCtl2 (CTO)") < 0;
+	}
+	bledy += om_hard_zapis(b, "endpoint", b->pdev, OM_HARD_EP_LNKCTL,
+			       OM_HARD_EP_LNKCTL_V, "LnkCtl (ASPM off)") < 0;
+	bledy += om_hard_zapis(b, "endpoint", b->pdev, OM_HARD_EP_DEVCTL2,
+			       OM_HARD_EP_DEVCTL2_V, "DevCtl2 (CTO)") < 0;
+
+	if (!bledy) {
+		b->hardening_ok = true;
+		om_odp(b, "hardening: readback ZGODNY (ASPM off + CTO, mostek i endpoint) -- to jest odpowiednik `setpci` sprzed kazdego fire (CLAUDE.md p.5: hardening ginie z rebootem)\n");
+		return 0;
+	}
+	b->hardening_ok = false;
+	om_blad(b, "hardening: NIEZGODNY (%d pol) -- NIE kontynuuj bez rebootu; sciezka awaryjna: REBOOT + setpci z czystego boota (scripts/minihost.sh:180)\n",
+		bledy);
+	return -EIO;
+}
+
+static void om_op_hardening(struct om_bridge *b, int argc, char **argv)
+{
+	om_odp(b, "hardening: komenda recznie naklada ASPM-off + CTO (bez SBR); `reset` robi to samo PO SBR automatycznie\n");
+	(void)om_hardening(b);
+}
+
+/* ============================================================ reset (SBR) */
+
+/* SBR = pci_reset_function(): reset DOZWOLONY przy zwiazanym sterowniku --
+ * pci_dev_save_and_disable() (zapisuje config), __pci_reset_function_locked(),
+ * pci_dev_restore() (notes/:12, drivers/pci/
+ * pci-sysfs.c). Metoda "bus" przez mostek. Po SBR TCM NIE jest czyszczony --
+ * dlatego `zero` i `loadfw` sa osobnymi komendami. Mapowania BAR sa odtwarzane
+ * (pci_iounmap + pci_iomap), okno backplane wraca na PCIE2. */
+static void om_op_reset(struct om_bridge *b, int argc, char **argv)
+{
+	u32 win = 0, cc = 0;
+	int err;
+
+	om_emrg(b, "reset: pci_reset_function (SBR) -- start; TCM NIE jest czyszczony (CLAUDE.md p.5)\n");
+	if (!om_reset_fn) {
+		om_blad(b, "reset: brak pci_reset_function w tym kernelu -- most nie moze dzialac bez SBR (ODMOWA, zero MMIO)\n");
+		return;
+	}
+	err = om_reset_fn(b->pdev);
+	if (err) {
+		om_blad(b, "reset: pci_reset_function = %d -- SBR NIE DOSZEDL; dalsze kroki przerwane (zadnego czesciowego re-init)\n",
+			err);
+		return;
+	}
+	om_odp(b, "reset: SBR OK (pci_reset_function = 0)\n");
+	/* Hardening PO SBR -- kolejnosc jak w scripts/minihost.sh (KROK 1 = SBR,
+	 * KROK 2 = setpci x4 + readback). SBR przywraca domyslne Device Control
+	 * endpointu, wiec bez tego kroku `reset` NIE bylby odpowiednikiem
+	 * "reboot + hardening". Gdy readback sie nie zgadza, om_hardening
+	 * krzyczy i mowi wprost, ze nie wolno kontynuowac bez rebootu -- ale
+	 * re-init robimy dalej, zeby stan mostu byl okreslony (nota par. 6). */
+	(void)om_hardening(b);
+	/* re-init mapowan: BAR0 i BAR2 od nowa (po SBR config jest ten sam,
+	 * bo jadro go zapisuje i przywraca, ale mapowanie ma byc udowodnione) */
+	pci_iounmap(b->pdev, b->bar0);
+	pci_iounmap(b->pdev, b->bar2);
+	b->bar0 = pci_iomap(b->pdev, 0, 0);
+	b->bar2 = pci_iomap(b->pdev, 2, 0);
+	if (!b->bar0 || !b->bar2) {
+		om_blad(b, "reset: pci_iomap po SBR nieudane (bar0=%p bar2=%p) -- modul wymaga przeladowania\n",
+			b->bar0, b->bar2);
+		return;
+	}
+	om_odp(b, "reset: mapowanie BAR0=%p BAR2=%p (rozmiar 0x%llx)\n", b->bar0, b->bar2,
+	       (unsigned long long)b->bar2_len);
+	pci_set_master(b->pdev);
+	om_okno_restore(b);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	om_odp(b, "reset: okno backplane = 0x%08x (PCIE2 0x%08x), bus-master wlaczony\n",
+	       win, OM_PCIE2_BASE);
+	if (om_bp_read32(b, OM_CC_BASE, &cc) == 0)
+		om_odp(b, "reset: ChipCommon = 0x%08x => chipid 0x%04x chiprev %u\n",
+		       cc, cc & 0xffffu, (cc & 0x000f0000u) >> 16);
+	om_odp(b, "reset: rdzenie: CC 0x%08x D11 0x%08x (strona ZAKAZANA) ARM 0x%08x (wrap 0x%08x) PCIE2 0x%08x (wrap 0x%08x) SOCRAM 0x%08x (wrap 0x%08x)\n",
+	       OM_CC_BASE, OM_D11_BASE, OM_ARM_BASE, OM_ARM_WRAP, OM_PCIE2_BASE,
+	       OM_PCIE2_WRAP, OM_SOCRAM_BASE, OM_SOCRAM_WRAP);
+	om_odp(b, "reset: po SBR stan fw jest zerowy -- sekwencja: zero 0x%05x 0x%05x; loadfw <obraz>; contract; vars <vars>; ringinit; release\n",
+	       OM_ZERO_OD_777, OM_ZERO_DO_777);
+}
