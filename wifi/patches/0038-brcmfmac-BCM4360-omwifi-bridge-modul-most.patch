+/* ================================================================= przerwania */
+
+static irqreturn_t om_isr_szybki(int irq, void *arg)
+{
+	struct om_bridge *b = arg;
+
+	if (!ioread32(b->bar0 + OM_R_MAILBOXINT))
+		return IRQ_NONE;
+	return IRQ_WAKE_THREAD;
+}
+
+/* Watek przerwania: W1C bitow, ktore przyszly w MAILBOXINT, po bicie 8 (D2H)
+ * skan pierscienia D2H, na koniec re-arm maski RMW |= 0x100 (wzorzec wl.ko
+ * wlc_ol_enable_intrs, pcie.c brcmf_pcie_intr_enable).
+ * UWAGA: ten watek NIE bierze om_lock (moglby zablokowac komende na sekundy)
+ * i dotyka WYLACZNIE bufora DMA (RAM hosta, wlasnosc modulu) + rejestrow 0x48
+ * i 0x4C. Bufor jest zwalniany dopiero po free_irq() w om_remove(). */
+static irqreturn_t om_isr_watek(int irq, void *arg)
+{
+	struct om_bridge *b = arg;
+	u32 status = ioread32(b->bar0 + OM_R_MAILBOXINT);
+
+	if (status) {
+		iowrite32(status, b->bar0 + OM_R_MAILBOXINT);	/* W1C */
+		if (status & OM_INT_D2H)
+			om_d2h_scan(b, "ISR");
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) | OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+	}
+	return IRQ_HANDLED;
+}
+
+static void om_op_irq(struct om_bridge *b, int argc, char **argv)
+{
+	u32 is = 0, im = 0;
+	int err;
+
+	if (argc < 2 || (strcmp(argv[1], "on") && strcmp(argv[1], "off"))) {
+		om_blad(b, "irq: uzycie `irq on|off`\n");
+		return;
+	}
+	if (!strcmp(argv[1], "on")) {
+		if (b->irq_on) {
+			om_odp(b, "irq: juz wlaczone (irq=%u)\n", b->pdev->irq);
+			return;
+		}
+		if (!b->pdev->irq) {
+			om_blad(b, "irq: pdev->irq = 0 -- karta nie ma linii przerwania\n");
+			return;
+		}
+		/* MSI jak w module: pci_enable_msi (wynik logujemy, nie jest
+		 * krytyczny -- bez MSI zostaje INTx), a przy nieudanym
+		 * request_threaded_irq wracamy z MSI (pcie.c request_irq). */
+		err = pci_enable_msi(b->pdev);
+		b->msi_on = (err == 0);
+		om_odp(b, "irq: pci_enable_msi = %d (%s)\n", err,
+		       b->msi_on ? "MSI wlaczone" : "MSI niedostepne -- zostaje INTx");
+		err = request_threaded_irq(b->pdev->irq, om_isr_szybki, om_isr_watek,
+					   IRQF_SHARED, OM_NAZWA, b);
+		if (err) {
+			om_blad(b, "irq: request_threaded_irq(%u) = %d\n", b->pdev->irq, err);
+			if (b->msi_on) {
+				pci_disable_msi(b->pdev);
+				b->msi_on = false;
+			}
+			return;
+		}
+		b->irq_on = true;
+		/* odmaskowanie jak wl.ko: RMW BAR0+0x4C |= 0x100 (pcie.c:4496-4503).
+		 * NIGDY zapisu absolutnego 0 w up-path (notes/ par.2). */
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) | OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+		om_odp(b, "irq: ON (irq=%u), BAR0+0x%03x |= 0x%03x (rejestru 0x%03x/intmask NIE ruszamy -- fw sam robi intmask |= 0x100 w pciedngl_open)\n",
+		       b->pdev->irq, OM_R_MAILBOXMASK, OM_INT_MASK, OM_R_INTMASK);
+	} else {
+		if (b->irq_on) {
+			free_irq(b->pdev->irq, b);
+			b->irq_on = false;
+		}
+		if (b->msi_on) {
+			pci_disable_msi(b->pdev);
+			b->msi_on = false;
+		}
+		/* RMW -- nie zerujemy calego rejestru (inne bity maski moga byc fw) */
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) & ~OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+		om_odp(b, "irq: OFF (BAR0+0x%03x &= ~0x%03x)\n", OM_R_MAILBOXMASK, OM_INT_MASK);
+	}
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_INTSTATUS, &is) == 0 &&
+	    om_bp_read32(b, OM_PCIE2_BASE + OM_R_INTMASK, &im) == 0)
+		om_odp(b, "irq: intstatus = 0x%08x, intmask = 0x%08x (intmask 0x100 = fw juz uzbrojony: pciedngl_open)\n",
+		       is, im);
+}
