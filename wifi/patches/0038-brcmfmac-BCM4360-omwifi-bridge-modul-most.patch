+/* ==================================================================== status */
+
+static void om_op_status(struct om_bridge *b, int argc, char **argv)
+{
+	u32 cc = 0;
+	u32 hb = 0, fl = 0;
+	u32 console_wr = 0, ptr = 0, buf = 0, size = 0, wr = 0;
+	u32 ioctl_arm = 0, win = 0;
+	u16 cmd = 0;
+
+	om_odp(b, "status: card %04x:%04x (PCI rev %u) @ %s\n", b->pdev->vendor,
+	       b->pdev->device, b->pdev->revision, pci_name(b->pdev));
+	if (om_bp_read32(b, OM_CC_BASE, &cc) == 0)
+		om_odp(b, "status: ChipCommon @0x%08x = 0x%08x => chipid 0x%04x chiprev %u (expected 0x%04x / %u)\n",
+		       OM_CC_BASE, cc, cc & 0xffffu, (cc & 0x000f0000u) >> 16,
+		       OM_CHIPID_4360, OM_CHIPREV_4360);
+	else
+		om_blad(b, "status: cannot read ChipCommon @0x%08x\n", OM_CC_BASE);
+	om_odp(b, "status: cores (test.345 journalctl fire log:14-19): CC 0x%08x/0x%08x D11 0x%08x (FORBIDDEN page) ARM 0x%08x/0x%08x PCIE2 0x%08x/0x%08x SOCRAM 0x%08x/0x%08x\n",
+	       OM_CC_BASE, OM_CC_WRAP, OM_D11_BASE, OM_ARM_BASE, OM_ARM_WRAP,
+	       OM_PCIE2_BASE, OM_PCIE2_WRAP, OM_SOCRAM_BASE, OM_SOCRAM_WRAP);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	pci_read_config_word(b->pdev, PCI_COMMAND, &cmd);
+	om_odp(b, "status: BAR0 0x%llx (%llu B) BAR2 0x%llx (%llu B); config window 0x80 = 0x%08x (it returns to PCIE2 0x%08x after the operation)\n",
+	       (unsigned long long)pci_resource_start(b->pdev, 0),
+	       (unsigned long long)pci_resource_len(b->pdev, 0),
+	       (unsigned long long)pci_resource_start(b->pdev, 2),
+	       (unsigned long long)b->bar2_len, win, OM_PCIE2_BASE);
+	om_odp(b, "status: COMMAND (config offset 0x04) = 0x%04x (mem b1 = %u, bus-master b2 = %u)\n",
+	       cmd, (cmd >> 1) & 1u, (cmd >> 2) & 1u);
+	om_odp(b, "status: DMA: va=%p phys=0x%llx size=%u B; the fw gate (<4 GiB and the 64 MiB window) = %s\n",
+	       b->dma_va, (unsigned long long)b->dma_fiz, OM_DMA_ROZMIAR,
+	       b->dma_ok ? "PASSES" : "REJECTED -- msgbufaddr fields NOT published");
+	if (b->dma_va)
+		om_odp(b, "status: pierscienie: H2D rd=%u wr=%u; D2H rd=%u wr=%u\n",
+		       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_RD),
+		       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR),
+		       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD),
+		       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR));
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &ioctl_arm) == 0)
+		om_odp(b, "status: ARM wrap IOCTL = 0x%08x (CPUHALT b5 = %u) => %s (module flag: %s)\n",
+		       ioctl_arm, (ioctl_arm >> 5) & 1u,
+		       (ioctl_arm & OM_ARMCR4_IOCTL_CPUHALT) ? "ARM in halt" : "ARM released",
+		       b->arm_wypuszczony ? "release went" : "release did NOT go");
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	if (om_konsola(b, &ptr, &buf, &size, &wr) == 0)
+		console_wr = wr;
+	om_odp(b, "status: heartbeat(0x%04x) = 0x%08x, trap_flag(0x%04x) = 0x%08x%s\n",
+	       OM_K_HEARTBEAT, hb, OM_K_TRAP_FLAG, fl,
+	       fl == OM_TRAP_FLAG_VAL ? " <= FW IN TRAP" : "");
+	om_odp(b, "status: konsola fw: ptr=0x%08x buf=0x%08x size=%u wr_idx=%u\n",
+	       ptr, buf, size, console_wr);
+	om_odp(b, "status: rstvec=%s0x%08x; d11_ok=%u (the `d11-ok` token still required in the command); irq=%s; msi=%s\n",
+	       b->rstvec_znamy ? "" : "(unknown -- no loadfw) ", b->rstvec, d11_ok ? 1 : 0,
+	       b->irq_on ? "ON" : "OFF", b->msi_on ? "ON" : "OFF");
+	om_odp(b, "status: hardening PCIe (ASPM off + CTO): %s\n",
+	       !b->hardening_bylo ? "NOT applied in this session -- `reset` applies it AFTER SBR (the equivalent of setpci before every fire)" :
+	       (b->hardening_ok ? "APPLIED, readback consistent" :
+		"INCONSISTENT -- do NOT continue without a reboot (fallback path: REBOOT + setpci from a clean boot)"));
+}
+
+/* ================================================= hardening PCIe (config) */
+
+/* One 16-bit write in config space with a readback; returns 0 when the value
+ * held, -EIO when not. `kto` serves only for the log. */
+static int om_hard_zapis(struct om_bridge *b, const char *kto, struct pci_dev *dev,
+			 u16 off, u16 val, const char *nazwa)
+{
+	u16 przed = 0, po = 0;
+
+	pci_read_config_word(dev, off, &przed);
+	pci_write_config_word(dev, off, val);
+	pci_read_config_word(dev, off, &po);
+	om_odp(b, "hardening: %s %s 0x%02x (%s): 0x%04x -> 0x%04x (exp 0x%04x) %s\n",
+	       kto, pci_name(dev), off, nazwa, przed, po, val,
+	       po == val ? "OK" : "DOES NOT MATCH");
+	if (po != val) {
+		om_blad(b, "hardening: %s %s 0x%02x = 0x%04x, but 0x%04x expected\n",
+			kto, pci_name(dev), off, po, val);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Hardening 1:1 from the reference bridge script l. 167-180: LnkCtl (ASPM off) + DevCtl2
+ * (CTO) on the bridge and the endpoint, then READBACK OF ALL FOUR.
+ * We take the bridge from pdev->bus->self (we do NOT hard-code the BDF); when there is none,
+ * we log and SKIP the bridge writes -- we still do the endpoint, because there
+ * is nothing to guess there (we have `pdev`). Returns 0 (readback consistent) or -EIO. */
+static int om_hardening(struct om_bridge *b)
+{
+	struct pci_dev *mostek = b->pdev->bus ? b->pdev->bus->self : NULL;
+	int bledy = 0;
+
+	b->hardening_bylo = true;
+	om_emrg(b, "hardening: ASPM-off + CTO (LnkCtl/DevCtl2 on the bridge and the endpoint) -- start; pattern from the reference bridge script l. 167-180\n");
+	if (!mostek) {
+		om_blad(b, "hardening: pdev->bus->self == NULL (no bridge) -- bridge writes SKIPPED; I do not guess the BDF; doing the endpoint only\n");
+	} else {
+		bledy += om_hard_zapis(b, "bridge", mostek, OM_HARD_MOSTEK_LNKCTL,
+				       OM_HARD_MOSTEK_LNKCTL_V, "LnkCtl (ASPM off)") < 0;
+		bledy += om_hard_zapis(b, "bridge", mostek, OM_HARD_MOSTEK_DEVCTL2,
+				       OM_HARD_MOSTEK_DEVCTL2_V, "DevCtl2 (CTO)") < 0;
+	}
+	bledy += om_hard_zapis(b, "endpoint", b->pdev, OM_HARD_EP_LNKCTL,
+			       OM_HARD_EP_LNKCTL_V, "LnkCtl (ASPM off)") < 0;
+	bledy += om_hard_zapis(b, "endpoint", b->pdev, OM_HARD_EP_DEVCTL2,
+			       OM_HARD_EP_DEVCTL2_V, "DevCtl2 (CTO)") < 0;
+
+	if (!bledy) {
+		b->hardening_ok = true;
+		om_odp(b, "hardening: readback CONSISTENT (ASPM off + CTO, bridge and endpoint) -- this is the equivalent of `setpci` before every fire (project rulebook item 5: hardening dies with a reboot)\n");
+		return 0;
+	}
+	b->hardening_ok = false;
+	om_blad(b, "hardening: INCONSISTENT (%d fields) -- do NOT continue without a reboot; fallback path: REBOOT + setpci from a clean boot (reference bridge script l. 180)\n",
+		bledy);
+	return -EIO;
+}
+
+static void om_op_hardening(struct om_bridge *b, int argc, char **argv)
+{
+	om_odp(b, "hardening: the command applies ASPM-off + CTO by hand (without SBR); `reset` does the same AFTER SBR automatically\n");
+	(void)om_hardening(b);
+}
+
+/* ============================================================ reset (SBR) */
+
+/* SBR = pci_reset_function(): a reset ALLOWED with a bound driver --
+ * pci_dev_save_and_disable() (zapisuje config), __pci_reset_function_locked(),
+ * pci_dev_restore() (project notes, drivers/pci/
+ * pci-sysfs.c). The "bus" method through the bridge. After SBR TCM is NOT cleared --
+ * hence `zero` and `loadfw` are separate commands. BAR mappings are recreated
+ * (pci_iounmap + pci_iomap), the backplane window returns to PCIE2. */
+static void om_op_reset(struct om_bridge *b, int argc, char **argv)
+{
+	u32 win = 0, cc = 0;
+	int err;
+
+	om_emrg(b, "reset: pci_reset_function (SBR) -- start; TCM is NOT cleared (project rulebook item 5)\n");
+	if (!om_reset_fn) {
+		om_blad(b, "reset: no pci_reset_function in this kernel -- the bridge cannot work without SBR (REFUSAL, zero MMIO)\n");
+		return;
+	}
+	err = om_reset_fn(b->pdev);
+	if (err) {
+		om_blad(b, "reset: pci_reset_function = %d -- SBR did NOT GO; further steps aborted (no partial re-init)\n",
+			err);
+		return;
+	}
+	om_odp(b, "reset: SBR OK (pci_reset_function = 0)\n");
+	/* Hardening AFTER SBR -- order as in the reference bridge script (STEP 1 = SBR,
+	 * STEP 2 = setpci x4 + readback). SBR restores the endpoint's default Device Control,
+	 * so without this step `reset` would NOT be the equivalent of
+	 * "reboot + hardening". When the readback does not match, om_hardening
+	 * shouts and says plainly that continuing without a reboot is forbidden -- but
+	 * we still do the re-init so the bridge state is determined (notes par. 6). */
+	(void)om_hardening(b);
+	/* re-init of the mappings: BAR0 and BAR2 anew (after SBR the config is the same,
+	 * because the kernel saves and restores it, but the mapping must be proven) */
+	pci_iounmap(b->pdev, b->bar0);
+	pci_iounmap(b->pdev, b->bar2);
+	b->bar0 = pci_iomap(b->pdev, 0, 0);
+	b->bar2 = pci_iomap(b->pdev, 2, 0);
+	if (!b->bar0 || !b->bar2) {
+		om_blad(b, "reset: pci_iomap after SBR failed (bar0=%p bar2=%p) -- the module needs a reload\n",
+			b->bar0, b->bar2);
+		return;
+	}
+	om_odp(b, "reset: mapping BAR0=%p BAR2=%p (size 0x%llx)\n", b->bar0, b->bar2,
+	       (unsigned long long)b->bar2_len);
+	pci_set_master(b->pdev);
+	om_okno_restore(b);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	om_odp(b, "reset: backplane window = 0x%08x (PCIE2 0x%08x), bus-master enabled\n",
+	       win, OM_PCIE2_BASE);
+	if (om_bp_read32(b, OM_CC_BASE, &cc) == 0)
+		om_odp(b, "reset: ChipCommon = 0x%08x => chipid 0x%04x chiprev %u\n",
+		       cc, cc & 0xffffu, (cc & 0x000f0000u) >> 16);
+	om_odp(b, "reset: cores: CC 0x%08x D11 0x%08x (FORBIDDEN page) ARM 0x%08x (wrap 0x%08x) PCIE2 0x%08x (wrap 0x%08x) SOCRAM 0x%08x (wrap 0x%08x)\n",
+	       OM_CC_BASE, OM_D11_BASE, OM_ARM_BASE, OM_ARM_WRAP, OM_PCIE2_BASE,
+	       OM_PCIE2_WRAP, OM_SOCRAM_BASE, OM_SOCRAM_WRAP);
+	om_odp(b, "reset: after SBR the fw state is zero -- sequence: zero 0x%05x 0x%05x; loadfw <image>; contract; vars <vars>; ringinit; release\n",
+	       OM_ZERO_OD_777, OM_ZERO_DO_777);
+}
