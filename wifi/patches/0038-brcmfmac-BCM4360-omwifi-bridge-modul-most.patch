+// SPDX-License-Identifier: ISC
+/* ============================================================================
+ * omwifi_bridge.c -- a BRIDGE to the BCM4360 card (14e4:43a0) with Broadcom 7.77 firmware
+ * embedded by Apple (patch 0038).
+ *
+ * WHY: today EVERY touch of the card ends in a reboot -- after insmod
+ * the card is BOUND (project rulebook, item 5: rmmod forbidden), and SBR does not clear TCM
+ * (project rulebook, item 5), so the next test needs a reboot and a rebuild. This module
+ * is loaded ONCE and owns the card (brcmfmac is NOT loaded),
+ * and exposes the whole 7.77 fw host side to userspace through /dev/omwifi
+ * with a TEXT protocol (one command = one line). Iteration means a command:
+ * `reset` + `zero` do what until now required a reboot.
+ *
+ * WHERE THE LOGIC COMES FROM: ported from the userspace reference tool
+ * (verified numerically -- the project notes, sections 1-10)
+ * and from the notes cited at each command. The module-vs-reference differences are
+ * only where the kernel has no equivalent or where the reference tool has a bug:
+ *  (a) DMA buffer: `dma_alloc_coherent` instead of mmap+mlock+pagemap from userspace
+ *      (the reference tool must hunt for a window of 16 consecutive pages under memory pressure
+ *      -- the project notes par. 10; the kernel gets a low
+ *      address right away, 0x01280000 in the fires),
+ *  (b) `zero` starting at 0x6E322 (not %4==0): the reference tool has a HARD bug there --
+ *      its tcm_write32() rejects an unaligned write (reference tool l. 367-374), so
+ *      a real `zero 0x6e322 0x9a080` would end with the tool's "TCM: unaligned
+ *      write" error and zero NOTHING. The module (patch 0036, pcie.c
+ *      bcm4360_ol77_zero_range) writes those bytes and this was MEASURED
+ *      in test.345 -- the bridge does it like the module,
+ *  (c) console and registers: BAR2/BAR0 (mmap replaced by ioread32).
+ *
+ * -- PROTOCOL (each command = one line on /dev/omwifi) -----------------
+ *   help | status | reset | zero <from_hex> <to_hex> | loadfw <path> |
+ *   ringinit | contract | vars <path> | maccontrol <hex> d11-ok | release |
+ *   gate [ms] | send <typ_hex> <len_hex> <payload_hex|-> | sendtrio |
+ *   irq on|off | read contract|console|rings|heartbeat|trap|tcm <adr> <len> | d2h
+ *   Write:  echo "status" > /dev/omwifi
+ *   Read: cat /dev/omwifi      (the answer comes ONCE, then EOF -- `cat` exits)
+ *
+ * -- HARD RULES IN THE CODE ------------------------------------------------
+ *  1. The D11 core page 0x18001000..0x18001fff is a HARD RULE (project rulebook, item 7;
+ *     fire #21 = machine hang). Every BAR0 access goes through
+ *     om_bp_read32/om_bp_write32, which REJECT that page BEFORE touching
+ *     BAR0 (predicate 1:1 with bcm4360_t328_is_d11_page(), pcie.c:2784-2792).
+ *     The only allowed access is the D11 maccontrol seed (0x18001120), only behind
+ *     a DOUBLE gate: the module parameter `d11_ok=1` AND the token `d11-ok` in the
+ *     command itself. Without both -- REFUSAL before any MMIO.
+ *  2. The backplane window (config 0x80) is ALWAYS written with a READBACK
+ *     before touching BAR0 (pattern bcm4360_t328_bp_read32, pcie.c:2796-2817)
+ *     and ALWAYS returns to PCIE2 (0x18003000) after the operation -- also on error
+ *     paths (the project notes).
+ *  3. TCM writes one way only: 32-bit iowrite32 (the 4360 requirement from patch 0003:
+ *     64-bit memcpy_toio hangs the bus -- pcie.c brcmf_pcie_copy_mem_to_dev).
+ *  4. No reads/writes outside BAR0, BAR2 and config space. No other
+ *     BARs, no D11 registers.
+ *  5. The contract msgbufaddr_lo/hi fields go to TCM ONLY when the address of the buffer
+ *     passes the `address < 4 GiB` AND
+ *     `(address & 0x3FFFFFF) + 0x10000 <= 0x4000000` (reference tool l. 517-521;
+ *     the project notes par. 1; fw 7.77 binary: 0x3a7c ldr
+ *     r3,[r2,#4] -> bic #0xfc000000 -> orr #0x08000000 -> str [r0,#0x38] and
+ *     sbtopcie0 := (low & 0xFC000000) | 0xC). When it does not pass -- we do NOT
+ *     publish and we shout (we do not "assume").
+ *  6. `loadfw` does NOT write TCM[ramsize-4] (R2 from the project notes:
+ *     that write belongs to the msgbuf path and lands in contract+0x5F7C, which
+ *     Apple does not write; patch 0037 does the same on the 7.77 path).
+ *  7. The TCM window semaphore (flag[0] +0x14, flag[1] +0x18, turn +0x1C) is written ONLY
+ *     with zeros -- project notes: in tcm_sem_enter (0x1304e-0x13058) the fw
+ *     waits in a loop WITHOUT AN EXIT while flag[0]==1 && turn==0, and TCM does not clear
+ *     on reboot => a stale flag[0]=1 = a silent, eternal fw loop.
+ * ==========================================================================*/
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/pci.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/dma-mapping.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/mutex.h>
+#include <linux/delay.h>
+#include <linux/ktime.h>
+#include <linux/string.h>
+#include <linux/kstrtox.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/init.h>
+
+/* ======================================================== card identification */
+
+#define OM_VENDOR		0x14e4u	/* Broadcom (PCI_VENDOR_ID_BROADCOM) */
+#define OM_DEVICE_4360		0x43a0u	/* BRCM_PCIE_4360_DEVICE_ID, brcm_hw_ids.h:87 */
+#define OM_NAZWA		"omwifi_bridge"
+#define OM_DEV			"/dev/omwifi"
+
+/* BARs (fire logs: resource0 = 0x8000, resource2 = 0x200000) */
+#define OM_BAR0_ROZMIAR		0x8000u		/* 32 KiB: PCIE2 registers + window */
+#define OM_BAR2_ROZMIAR		0x200000u	/* 2 MiB: window onto the fw RAM (TCM) */
+#define OM_BAR0_WINDOW		0x80u		/* config: backplane window (pcie.c:674) */
+#define OM_BAR0_REG_SIZE	0x1000u		/* window page (pcie.c:675) */
+
+/* ============================================================== core map
+ *
+ * PATTERN: the same as in the reference tool l. 16-21 -- constants from fire logs, not from DMP.
+ * Source: the test.345 journalctl fire log:14-19 (`cores_check`). The module does NOT parse
+ * DMP (that is ~1000 lines of chip.c and another error source); it recognizes the card by ID
+ * (14e4:43a0) and VERIFIES chipid/chiprev with a ChipCommon read
+ * (0x18000000 + 0x0) -- the same method as brcmf_chip_recognition()
+ * (chip.c:990-1000), adres bazowy SI_ENUM_BASE_DEFAULT = 0x18000000
+ * (include/soc.h:9), chipid fields: CID_ID_MASK 0xffff / CID_REV_MASK 0xf0000
+ * (include/chipcommon.h:222-224). Expected 0x4360 / 3 (chiprev 3 --
+ * the project notes).
+ */
+#define OM_CC_BASE		0x18000000u	/* ChipCommon (0x800) */
+#define OM_CC_WRAP		0x18100000u
+#define OM_D11_BASE		0x18001000u	/* 802.11 (0x812) -- FORBIDDEN PAGE */
+#define OM_D11_WRAP		0x18101000u
+#define OM_ARM_BASE		0x18002000u	/* ARM CR4 (0x83e) */
+#define OM_ARM_WRAP		0x18102000u
+#define OM_PCIE2_BASE		0x18003000u	/* PCIE2 (0x83c) */
+#define OM_PCIE2_WRAP		0x18103000u
+#define OM_SOCRAM_BASE		0x18004000u	/* INTERNAL_MEM / SOCRAM (0x81a) */
+#define OM_SOCRAM_WRAP		0x18104000u
+#define OM_PAGE_MASK		(~0xfffu)
+
+#define OM_CHIPID_4360		0x4360u
+#define OM_CHIPREV_4360		3u
+
+/* ============================================================ TCM / contract
+ *
+ * rambase = 0, ramsize = 0xA0000 (chip.c, BRCM_CC_4360). The OL contract lies below
+ * TCM_end - 0x5F80 = 0x9A080 (pcie.c:161, :940; the project notes on the re-apple host, stages 1-2,
+ * part 1). Field offsets: pcie.c:162-176 (BCM4360_T336_*).
+ */
+#define OM_RAMBASE		0x0u
+#define OM_RAMSIZE		0xa0000u			/* 640 KiB */
+#define OM_KONTRAKT		(OM_RAMSIZE - 0x5f80u)		/* 0x9A080 */
+#define OM_K_MSGBUFADDR_LO	0x0004u
+#define OM_K_MSGBUFADDR_HI	0x0008u
+#define OM_K_MSGBUF_SZ		0x000cu
+#define OM_K_CONSOLE_PTR	0x0010u		/* si[+0x010] -- published by the FW */
+#define OM_K_FLAG0		0x0014u		/* Peterson semaphore: NEVER 1 */
+#define OM_K_FLAG1		0x0018u
+#define OM_K_TURN		0x001cu
+#define OM_K_VARS_SIZE		0x0020u
+#define OM_K_VARS		0x0024u
+#define OM_K_HEARTBEAT		0x5028u		/* fw readiness gate */
+#define OM_K_TRAP_FLAG		0x502cu
+#define OM_K_TRAP_REC		0x5ed8u
+#define OM_K_TRAP_REC_BAJTY	132u		/* 0x84 = 33 dwords (pcie.c:175) */
+#define OM_K_MARKER_END		0x5f5cu
+
+#define OM_MARKER_BEGIN_VAL	0xa5a5a5a5u
+#define OM_MARKER_END_VAL	0x5a5a5a5au
+#define OM_TRAP_FLAG_VAL	0xdeadbeefu
+#define OM_MSGBUF_SZ		0x10000u	/* 64 KiB (pcie.c:108) */
+#define OM_VARS_MAX		0x4000u		/* MAXSZ_NVRAM_VARS */
+#define OM_OBRAZ_ROZMIAR_777	451362u		/* image 7.77.0.0 = 0x6E322 (md5 e942afb0...) */
+#define OM_ZERO_OD_777		0x6e322u	/* zeroing start (end of the image) */
+#define OM_ZERO_DO_777		OM_KONTRAKT	/* == 0x9a080; 179550 B */
+
+/* wrapper registers (include/linux/bcma/bcma_regs.h:29-43) */
+#define OM_BCMA_IOCTL		0x0408u
+#define OM_BCMA_IOCTL_CLK	0x0001u
+#define OM_BCMA_IOCTL_FGC	0x0002u
+#define OM_BCMA_RESET_CTL	0x0800u
+#define OM_BCMA_RESET_CTL_RESET	0x0001u
+#define OM_BCMA_RESET_ST	0x0804u
+#define OM_BCMA_CLKCTLST	0x01e0u
+#define OM_BCMA_IOCTL_PHYCLOCKEN 0x0004u	/* D11_BCMA_IOCTL_PHYCLOCKEN (chip.c:81) */
+#define OM_BCMA_IOCTL_PHYRESET	0x0008u		/* D11_BCMA_IOCTL_PHYRESET   (chip.c:82) */
+#define OM_ARMCR4_IOCTL_CPUHALT	0x0020u		/* chip.c ARMCR4_BCMA_IOCTL_CPUHALT */
+
+/* PCIE2 registers as seen in BAR0 (pcie.c:690-692; sbpcieregs intstatus 0x20,
+ * intmask 0x24 -- project notes par. 2) */
+#define OM_R_INTSTATUS		0x20u
+#define OM_R_INTMASK		0x24u
+#define OM_R_MAILBOXINT		0x48u
+#define OM_R_MAILBOXMASK	0x4cu
+#define OM_R_CLKCTLST		0x1e0u
+#define OM_INT_D2H		0x00000100u	/* bit 8: D2H doorbell (pcie.c:398) */
+#define OM_INT_MASK		0x00000100u	/* D2H re-arm mask (pcie.c:402) */
+#define OM_DB_H2D		0x00000001u	/* bit 0: H2D doorbell (pcie.c:393) */
+
+/* D11 maccontrol (the project notes; test.342) */
+#define OM_D11_MACCONTROL_OFF	0x120u
+#define OM_D11_MACCONTROL_SEED	0x04000400u
+
+/* ============================================== hardening PCIe (config space)
+ *
+ * ASPM-off + Completion Timeout, 1:1 with the project scripts:
+ *   the reference bridge script l. 167-180  (four writes + readback of all four
+ *                                 + fallback path "REBOOT + setpci from a clean boot")
+ *   the reference fire script l. 128-136 (the same four values, bridge BDF 00:1c.2)
+ * MEANING: 0x50/0xbc is LnkCtl (bits 0-1 = ASPM; in each of those values
+ * ZERO => ASPM off -- project notes), and 0x68/0xd4 is
+ * DevCtl2 (programming the Completion Timeout -- project notes,
+ * `PCI_EXP_DEVCTL2_COMP_TIMEOUT`, include/uapi/linux/pci_regs.h).
+ * The offsets are RAW because they depend on this specific board's PCIe capability base
+ * (bridge: 0x50/0x68, endpoint: 0xbc/0xd4 -- those are values from working
+ * scripts, not computations).
+ *
+ * WHY IN THE BRIDGE: project rulebook item 5 -- hardening DIES WITH A REBOOT, so
+ * the scripts apply it before EVERY fire. In the bridge, the equivalent of "every
+ * fire" is every `reset`: SBR restores the endpoint's default Device Control,
+ * so hardening must be applied AFTER SBR -- and `reset` does it itself (the order
+ * as in the reference bridge script: SBR -> hardening -> re-init of mappings/window/cores).
+ * Without that, after `reset` the user would sit in a configuration in which no
+ * previous fire has ever run. */
+#define OM_HARD_MOSTEK_LNKCTL	0x50u
+#define OM_HARD_MOSTEK_LNKCTL_V	0x0c40u
+#define OM_HARD_MOSTEK_DEVCTL2	0x68u
+#define OM_HARD_MOSTEK_DEVCTL2_V	0x040bu
+#define OM_HARD_EP_LNKCTL	0xbcu
+#define OM_HARD_EP_LNKCTL_V	0x0140u
+#define OM_HARD_EP_DEVCTL2	0xd4u
+#define OM_HARD_EP_DEVCTL2_V	0x040bu
+
+/* ====================================================== olmsg ring (DMA)
+ *
+ * Geometry 1:1 with the reference tool l. 176-184 and pcie.c:368-375, equivalent to
+ * `bcm_olmsg_init` @0x4f38 in the 7.77 image: H2D channel = buf+0x00, D2H channel =
+ * buf+0x10, channel header {data_off, size, rd, wr}, message
+ * {type, seq, len} + payload, total = len + 12.
+ * NOTE (project notes par. 4.2): total > 0x400 => the fw
+ * loops on the same message in the ISR (console spam) -- hence the limit.
+ */
+#define OM_DMA_ROZMIAR		0x10000u	/* 64 KiB = contract msgbuf_sz */
+#define OM_RING_HDR_H2D		0x00u
+#define OM_RING_HDR_D2H		0x10u
+#define OM_RING_DATA_H2D	0x20u
+#define OM_RING_DATA_D2H	0x7820u
+#define OM_RING_H2D_RD		0x08u		/* written by FW (consumption) */
+#define OM_RING_H2D_WR		0x0cu		/* written by HOST (publication) */
+/* NOTE -- fixed 11.09.2026 (raw buffer measurement: `kread phys 0x1280000 0x40`).
+ * These two offsets must be RELATIVE to OM_RING_HDR_D2H (0x10) -- just like the
+ * H2D pair above is relative to 0x00 -- because EVERY use in this file has the form
+ * `OM_RING_HDR_D2H + OM_RING_D2H_RD/WR`. In the first version they were ABSOLUTE
+ * (0x18/0x1c) and the base was added a second time: the code read 0x28/0x2c, i.e. the
+ * "len" and "payload" fields of OUR 0x42 message in the H2D ring. Effects:
+ *  (a) `read rings`/`read d2h`/`status` lied ("D2H rd=4 wr=288740") because they took
+ *      someone else's bytes -- and that is where the false claim "the fw wrote 288740" came from;
+ *  (b) `om_d2h_scan` (ISR!) would write `rd` at 0x28, i.e. it would OVERWRITE the length
+ *      of message #1 in H2D -- real corruption of its own publication while the fw is alive.
+ * Measurement (11.09, after the run): the real D2H is rd=0, wr=12, and at 0x7820 lies
+ * {type=0x41, seq=0, len=0} = BCM_OL_TRAP_IND -- exactly what the fw announced
+ * on the console ("Offload Message: Type: BCM_OL_TRAP_IND Seq:0 len:0"). */
+#define OM_RING_D2H_RD		0x08u		/* written by HOST (relative to OM_RING_HDR_D2H) */
+#define OM_RING_D2H_WR		0x0cu		/* written by FW   (relative to OM_RING_HDR_D2H) */
+#define OM_RING_ROZMIAR		0x7800u
+#define OM_OLMSG_HDR		12u		/* {type, seq, len} po 4 B */
+
+/* The Apple startup trio (project notes par. 4 and par. 6;
+ * reference tool l. 193-204): 0x42 + 0x45 + 0x38, published `wr` = 16+16+34 = 66.
+ * CORRECTION of 11.09: `wr` is 66, NOT 50 (at 50 the fw would read a truncated third
+ * message: of the 34 B only 18 would remain). */
+#define OM_TRIO_WR		66u
+#define OM_TRIO_TYP_TS		0x00000042u	/* BCM_OL_SYNC_HOST_TIMESTAMP */
+#define OM_TRIO_TYP_EWT		0x00000045u	/* BCM_OL_EXCESS_WAKE_TIMEOUT */
+#define OM_TRIO_TYP_LTR		0x00000038u	/* BCM_OL_LTR */
+#define OM_TRIO_TS_LEN		4u
+#define OM_TRIO_EWT_LEN		4u
+#define OM_TRIO_LTR_LEN		0x16u		/* 22 B */
+#define OM_TRIO_EWT_VAL		30u		/* iovar wowl_excess_wake_timeout */
+
+/* Readiness gate: Apple polls contract+0x5028 2000 x 1 ms and after the timeout
+ * only logs (no error branch) -- and we do the same (project notes
+ * notes on the contract and its gate, par. 2.1; reference tool l. 206-210). */
+#define OM_GATE_ITERACJE	2000u
+#define OM_OLMSG_MAX_TOTAL	0x400u		/* fw limit per message (pcie.c:435) */
+
+/* Waiting for the `pciedngl_open called` line in the fw console before the doorbell
+ * (project notes par. 6, item 5): the fw reads the ring
+ * ONLY in its ISR, and pciedngl_open (fw 0x387c: `bus+0x24 |= 0x100`) is the moment
+ * the interrupt is armed -- a doorbell before it may get latched
+ * and unserviced. Measurement: the line appears at ~0.052 s of fw time. */
+#define OM_KONSOLA_LINIA	"pciedngl_open called"
+#define OM_KONSOLA_CZEKAJ_MS	2000u
+
+/* /dev/omwifi response limit -- the fw console is ~1.6 KB, a D2H dump <= 3000 B,
+ * `read tcm` <= 256 B; 16 KiB gives headroom without risk to kernel memory */
+#define OM_RESP_MAX		16384u
+#define OM_RESP_ZAPAS		96u		/* reserve for the truncation marker line */
+#define OM_LINIA_MAX		4096u		/* max command length from userspace */
+#define OM_LOG_MAX		512u		/* length of one log line */
+#define OM_KONSOLA_LINII	100u		/* max console lines in one response */
+
+/* ====================================================================== state */
+
+struct om_bridge {
+	struct pci_dev		*pdev;
+	void __iomem		*bar0;		/* resource0: PCIE2 + backplane window */
+	void __iomem		*bar2;		/* resource2: fw RAM (TCM) */
+	resource_size_t		bar2_len;
+
+	void			*dma_va;	/* 64 KiB, dma_alloc_coherent */
+	dma_addr_t		dma_fiz;
+	bool			dma_ok;		/* whether the address passed the fw gate */
+
+	u32			rstvec;		/* first dword of the image (loadfw) */
+	bool			rstvec_znamy;
+	bool			arm_wypuszczony;
+	bool			irq_on;
+	bool			msi_on;
+	bool			hardening_bylo;	/* whether hardening was applied in this session */
+	bool			hardening_ok;	/* whether the last hardening passed the readback */
+	bool			odmowa_d11_log;	/* one refusal line per command */
+	bool			okno_mask_log;	/* one line about IRQ masking for a foreign window */
+
+	char			*resp;		/* response buffer */
+	size_t			resp_len;
+	size_t			resp_pos;
+	bool			resp_uciete;	/* whether the response hit the limit (one marker line) */
+
+	struct miscdevice	misc;
+};
+
+static struct om_bridge *om;			/* one card instance */
+static DEFINE_MUTEX(om_lock);			/* protects `om` and the whole sequence */
+
+/* Requirement 2: the bridge CANNOT work without pci_reset_function (the whole loop
+ * without a reboot stands on SBR), so the SYMBOL is forced through a pointer:
+ *  (a) the module ALWAYS references it => a kernel without that symbol will NOT LOAD the module
+ *      (insmod: unresolved symbol) -- that is the proper, loud gate,
+ *  (b) the `!om_reset_fn` check runs at every call and does NOT vanish
+ *      under optimization and does not generate -Waddress either (a direct
+ *      `!pci_reset_function` gets reduced by gcc to a constant and WARNS -- the build gate
+ *      requires zero warnings). */
+static int (*const om_reset_fn)(struct pci_dev *) = pci_reset_function;
+
+/* module parameter: THE ONLY new option (requirement 5) -- half of the double D11 gate */
+static bool d11_ok;
+module_param(d11_ok, bool, 0644);
+MODULE_PARM_DESC(d11_ok,
+	"omwifi_bridge: allows ONE access to the D11 core page 0x18001000 (maccontrol seed 0x18001120). HARD RULE project rulebook item 7 (fire #21 = machine hang): without this parameter AND without the token `d11-ok` in the maccontrol command itself the module REFUSES before any MMIO. (1=allow, 0=refuse (default))");
+
+/* ============================================================== log/response
+ *
+ * Every line goes SIMULTANEOUSLY to the kernel log (with the omwifi_bridge: prefix)
+ * and to the buffer read by `cat /dev/omwifi`. The content is the same -- the fire report
+ * and the command response are the same text (without the prefix in the response).
+ * Levels: 0 = pr_info (normal step), 1 = pr_err (error/refusal),
+ * 2 = pr_emerg (a line BEFORE a hardware operation -- the last one if the operation
+ * freezes the machine; the convention from pcie.c test.3xx).
+ */
+
+static void om_linia(struct om_bridge *b, int poziom, const char *fmt, ...)
+	__attribute__((format(printf, 3, 4)));
+
+static void om_linia(struct om_bridge *b, int poziom, const char *fmt, ...)
+{
+	char tmp[OM_LOG_MAX];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vscnprintf(tmp, sizeof(tmp), fmt, ap);
+	va_end(ap);
+
+	/* We hold OM_RESP_ZAPAS as reserve for ONE truncation marker line: the client
+	 * must know that the response is incomplete (the contract:
+	 * every command answers something and the response ends with \n). */
+	if (b && b->resp && b->resp_len + (size_t)n <= OM_RESP_MAX - OM_RESP_ZAPAS) {
+		memcpy(b->resp + b->resp_len, tmp, n);
+		b->resp_len += n;
+	} else if (b && b->resp && !b->resp_uciete) {
+		const char *marker = "[...] response truncated at the buffer limit -- the full line is in dmesg\n";
+		size_t dl = strlen(marker);
+
+		b->resp_uciete = true;
+		if (b->resp_len + dl < OM_RESP_MAX) {
+			memcpy(b->resp + b->resp_len, marker, dl);
+			b->resp_len += dl;
+		}
+	}
+	if (poziom >= 2)
+		pr_emerg(OM_NAZWA ": %s", tmp);
+	else if (poziom == 1)
+		pr_err(OM_NAZWA ": %s", tmp);
+	else
+		pr_info(OM_NAZWA ": %s", tmp);
+}
+
+#define om_odp(b, fmt, ...)	om_linia((b), 0, fmt, ##__VA_ARGS__)
+#define om_blad(b, fmt, ...)	om_linia((b), 1, fmt, ##__VA_ARGS__)
+#define om_emrg(b, fmt, ...)	om_linia((b), 2, fmt, ##__VA_ARGS__)
+
+/* ================================================================ window / TCM */
+
+/* Predicate 1:1 with bcm4360_t328_is_d11_page() (pcie.c:2784-2792): a comparison
+ * of 4-KB pages, i.e. exactly 0x18001000..0x18001FFF. */
+static bool om_jest_strona_d11(u32 addr)
+{
+	return (addr & OM_PAGE_MASK) == (OM_D11_BASE & OM_PAGE_MASK);
+}
+
+static void om_odmowa_d11(struct om_bridge *b, u32 addr, const char *co)
+{
+	if (!b->odmowa_d11_log) {
+		b->odmowa_d11_log = true;
+		om_blad(b, "REFUSAL: D11 page 0x%08x (%s) -- HARD RULE project rulebook item 7 (fire #21 = machine hang); zero BAR0 touches\n",
+			addr, co);
+	}
+}
+
+/* Backplane window on PCIE2 -- the resting state after EVERY operation (requirement 3;
+ * pattern: the reference tool's window-restore helper (l. 331-337). */
+static void om_okno_restore(struct om_bridge *b)
+{
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW,
+			       OM_PCIE2_BASE & OM_PAGE_MASK);
+}
+
+/* Is the target page FOREIGN (outside PCIE2)? BAR0 is a WINDOW -- the meaning of its
+ * registers depends on the page written into config 0x80. */
+static bool om_okno_obce(u32 page)
+{
+	return page != (OM_PCIE2_BASE & OM_PAGE_MASK);
+}
+
+/* RACE WITH THE ISR (found in the 11.09.2026 audit, after the 19:44 run): `om_isr_szybki`
+ * reads and `om_isr_watek` W1C-WRITES BAR0+0x48/+0x4C, and NEITHER takes
+ * om_lock (comment at om_isr_watek). While the window stands on PCIE2 it is the
+ * same register as always -- but when `_ogon` moves the window to another page, the ISR
+ * hits a FOREIGN register: on the D11 page 0x18001048 that is a HARD RULE VIOLATION
+ * (fire #21 = hang), and a W1C at a foreign address is an uncontrolled write.
+ * The path is real in the canonical sequence too: `status` runs AFTER `irq on`
+ * and reads ChipCommon and the ARM wrap, and `reset` does NOT release the line, so a repeat
+ * of the sequence without reloading the module has an armed ISR for `d11release`/`maccontrol`.
+ * While the window is foreign we mask the line: `disable_irq` waits for an in-flight handler,
+ * so after the return nobody touches BAR0 (and an interrupt delivered in that window
+ * is serviced after `enable_irq`, already with the window on PCIE2). */
+static void om_okno_irq_maskuj(struct om_bridge *b, bool maskuj, u32 page)
+{
+	if (!maskuj)
+		return;
+	if (!b->okno_mask_log) {
+		b->okno_mask_log = true;
+		om_odp(b, "window: page 0x%08x != PCIE2 0x%08x -- the interrupt line MASKED for the access duration (the ISR touches BAR0+0x%03x/+0x%03x without om_lock, and BAR0 is a window)\n",
+		       page, OM_PCIE2_BASE, OM_R_MAILBOXINT, OM_R_MAILBOXMASK);
+	}
+	disable_irq(b->pdev->irq);
+}
+
+static void om_okno_irq_odmaskuj(struct om_bridge *b, bool maskuj)
+{
+	if (maskuj)
+		enable_irq(b->pdev->irq);
+}
+
+/* Backplane access tail: page into config 0x80 + READBACK, only then
+ * BAR0 (pattern bcm4360_t328_bp_read32, pcie.c:2796-2817). Returns 0 or
+ * -EIO (the window did not set -- BAR0 NOT touched).
+ * NOTE: this function has NO D11 page predicate -- the page's admission is decided
+ * SOLELY by the caller. It may only be called from the two places below. */
+static int om_bp_read32_ogon(struct om_bridge *b, u32 addr, u32 *val)
+{
+	u32 page = addr & OM_PAGE_MASK;
+	bool maskuj = om_okno_obce(page) && b->irq_on;
+	u32 win = 0;
+
+	om_okno_irq_maskuj(b, maskuj, page);
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW, page);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	if (win != page) {
+		om_blad(b, "window 0x%08x != page 0x%08x (for 0x%08x) -- access SKIPPED, zero BAR0 touches\n",
+			win, page, addr);
+		om_okno_restore(b);
+		om_okno_irq_odmaskuj(b, maskuj);
+		return -EIO;
+	}
+	*val = ioread32(b->bar0 + (addr & (OM_BAR0_REG_SIZE - 1)));
+	om_okno_restore(b);
+	om_okno_irq_odmaskuj(b, maskuj);
+	return 0;
+}
+
+static int om_bp_write32_ogon(struct om_bridge *b, u32 addr, u32 val)
+{
+	u32 page = addr & OM_PAGE_MASK;
+	bool maskuj = om_okno_obce(page) && b->irq_on;
+	u32 win = 0;
+
+	om_okno_irq_maskuj(b, maskuj, page);
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW, page);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	if (win != page) {
+		om_blad(b, "window 0x%08x != page 0x%08x (for 0x%08x) -- write SKIPPED, zero BAR0 touches\n",
+			win, page, addr);
+		om_okno_restore(b);
+		om_okno_irq_odmaskuj(b, maskuj);
+		return -EIO;
+	}
+	iowrite32(val, b->bar0 + (addr & (OM_BAR0_REG_SIZE - 1)));
+	om_okno_restore(b);
+	om_okno_irq_odmaskuj(b, maskuj);
+	return 0;
+}
+
+/* Default backplane access: the D11 page REJECTED (HARD RULE). Returns 0 or
+ * -EPERM (D11 page) / -EIO (the window did not set) -- in both cases BAR0
+ * is NOT touched. */
+static int om_bp_read32(struct om_bridge *b, u32 addr, u32 *val)
+{
+	if (om_jest_strona_d11(addr)) {
+		om_odmowa_d11(b, addr, "backplane read");
+		return -EPERM;
+	}
+	return om_bp_read32_ogon(b, addr, val);
+}
+
+static int om_bp_write32(struct om_bridge *b, u32 addr, u32 val)
+{
+	if (om_jest_strona_d11(addr)) {
+		om_odmowa_d11(b, addr, "backplane write");
+		return -EPERM;
+	}
+	return om_bp_write32_ogon(b, addr, val);
+}
+
+/* The ONLY entry onto the D11 CORE PAGE (0x18001000..0x18001FFF) in the whole module.
+ * Used EXCLUSIVELY by `om_op_maccontrol` and ONLY behind the double gate:
+ * the `d11_ok=1` parameter + the `d11-ok` token in the command + a fresh wrapper read
+ * saying D11 is OUT OF RESET (a FAIL-CLOSED gate). HARD RULE
+ * project rulebook item 7 -- any other use is an error (see the verify script, section [C]).
+ *
+ * HISTORY (11.09.2026, bridge run at 19:44): `maccontrol` called `om_bp_read32`/
+ * `om_bp_write32` and got `-EPERM` from the predicate -- the "behind the double
+ * gate" case was described in the comment and in `help` but did NOT EXIST in the code, so
+ * the write never went, and the fw was left without the `maccontrol` seed. Hence these functions. */
+static int om_bp_read32_d11(struct om_bridge *b, u32 addr, u32 *val)
+{
+	return om_bp_read32_ogon(b, addr, val);
+}
+
+static int om_bp_write32_d11(struct om_bridge *b, u32 addr, u32 val)
+{
+	return om_bp_write32_ogon(b, addr, val);
+}
+
+/* TCM read (BAR2 = fw RAM). That is memory, not registers -- no window. */
+static int om_tcm_read32(struct om_bridge *b, u32 off, u32 *val)
+{
+	if (off + 4 > OM_RAMSIZE || off + 4 > b->bar2_len) {
+		om_blad(b, "TCM: read 0x%05x outside ramsize 0x%05x\n", off, OM_RAMSIZE);
+		return -EINVAL;
+	}
+	*val = ioread32(b->bar2 + off);
+	return 0;
+}
+
+/* TCM write -- 32-bit ONLY (the 4360 requirement from patch 0003: 64-bit
+ * memcpy_toio hangs the bus -- pcie.c brcmf_pcie_copy_mem_to_dev).
+ * The address may be UNALIGNED -- that is on purpose, see om_tcm_zero(). */
+static int om_tcm_write32(struct om_bridge *b, u32 off, u32 val)
+{
+	if (off + 4 > OM_RAMSIZE || off + 4 > b->bar2_len) {
+		om_blad(b, "TCM: write 0x%05x outside ramsize 0x%05x\n", off, OM_RAMSIZE);
+		return -EINVAL;
+	}
+	iowrite32(val, b->bar2 + off);
+	return 0;
+}
+
+/* Byte copy to TCM dword by dword (LE), the last dword padded with zeros
+ * -- 1:1 with the reference tool l. 378-401 and brcmf_pcie_copy_mem_to_dev (pcie.c). For
+ * loadfw/vars the tail is safe: it lies in TCM right after the text, whose
+ * length the receiver knows from the size field (+0x20 for vars; for the image -- from the
+ * image size). */
+static void om_tcm_copy(struct om_bridge *b, u32 off, const u8 *src, u32 len)
+{
+	u32 i;
+
+	for (i = 0; i + 4 <= len; i += 4) {
+		u32 w = (u32)src[i] | ((u32)src[i + 1] << 8) |
+			((u32)src[i + 2] << 16) | ((u32)src[i + 3] << 24);
+
+		om_tcm_write32(b, off + i, w);
+	}
+	if (len & 3u) {
+		u32 baza = len & ~3u;
+		u32 w = 0;
+
+		for (i = 0; i < (len & 3u); i++)
+			w |= (u32)src[baza + i] << (8 * i);
+		om_tcm_write32(b, off + baza, w);
+	}
+}
+
+/* Zeroing the TCM range [from,to) -- the class from patch 0036
+ * (bcm4360_ol77_zero_range, pcie.c:5658-5696: 4 KiB chunks, 32-bit writes,
+ * one shared zero buffer). THE REFERENCE TOOL CANNOT DO THIS: its tcm_write32()
+ * rejects an unaligned write (reference tool l. 367-374), and the gap-7 range has
+ * a start of 0x6E322 (0x6E322 % 4 = 2) -- a real `zero 0x6e322 0x9a080`
+ * in userspace would end in the tool's error path WITHOUT zeroing anything. The module
+ * (patch 0036) and this bridge write 32-bit at the unaligned address, because that
+ * is exactly what was MEASURED in test.345.
+ *
+ * THE WHOLE RANGE MUST BE COVERED: the dword loop goes from `from` in steps of 4 and with
+ * a length not divisible by 4 leaves a 1..3 B tail at the end -- for the default
+ * range [0x6e322,0x9a080) those are the 2 B [0x9a07e,0x9a080), and that is the tail
+ * of the heap area that gap 7 ordered to be cleaned (test.345 / patch 0036 zeroed
+ * the WHOLE range; SBR does not clear that junk, so leaving it = the only
+ * departure from the measured substrate).
+ * We close the tail with a dword at (to - 4): it lies ENTIRELY in the range (its lower
+ * 2-3 B were already zeroed -- we overwrite them with zero, which is harmless),
+ * and the UPPER 2-3 B are exactly the tail. This is better than patch 0036, which copies
+ * the last chunk with padding and thereby reaches 2 B BEYOND `to` (into the contract,
+ * which the `contract` command later overwrites): here `to` and everything behind it
+ * stays UNTOUCHED. A range shorter than a dword (to - from < 4) can still only be
+ * covered by going past `to`, so it is SKIPPED and LOGGED.
+ * Returns the number of bytes COVERED (to - from when the tail is closed). */
+static u32 om_tcm_zero(struct om_bridge *b, u32 from, u32 to)
+{
+	u32 off;
+	u32 zapisane;
+
+	for (off = from; off + 4 <= to; off += 4)
+		om_tcm_write32(b, off, 0);
+	zapisane = off - from;
+
+	if (off == to)
+		return zapisane;		/* length divisible by 4 */
+
+	if (to - from >= 4) {
+		om_tcm_write32(b, to - 4, 0);
+		om_odp(b, "zero: tail of %u B [0x%05x,0x%05x) closed with a dword at 0x%05x (fully in range; `to` and everything behind it UNTOUCHED)\n",
+		       to - off, off, to, to - 4);
+		return to - from;
+	}
+	om_blad(b, "zero: range of %u B [0x%05x,0x%05x) shorter than a dword -- SKIPPED (TCM writes are only 32-bit, and coverage would require going past `to`; the 4360 requirement)\n",
+		 to - from, from, to);
+	return zapisane;
+}
+
+/* ================================================================ DMA buffer */
+
+/* Buffer address gate for fw 7.77 -- condition 1:1 with the reference tool l. 517-521.
+ * JUSTIFICATION (fw binary, project notes par. 1.3):
+ *   0x3a7c ldr r3,[r2,#4]           (the fw reads from the contract ONLY the low dword)
+ *   0x3a7e bic.w r3,r3,#0xfc000000  (64 MiB window)
+ *   0x3a82 orr.w r3,r3,#0x8000000   (SB->PCIE window base 0x08000000)
+ *   0x3a90-0x3a98 sbtopcie0 := (low & 0xFC000000) | 0xC
+ * An address >= 4 GiB is useless (the +0x8 fragment is not read), and a window
+ * crossing the 64 MiB boundary puts the ring end under the START
+ * of the window -- and the fw WRITES there (D2H ring) => corruption of someone else's host memory. */
+static bool om_dma_adres_ok(dma_addr_t dma)
+{
+	return (u64)dma < 0x100000000ULL &&
+	       ((((u64)dma & 0x3ffffffULL) + OM_DMA_ROZMIAR) <= 0x4000000ULL);
+}
+
+static void om_buf_wr32(struct om_bridge *b, u32 off, u32 val)
+{
+	u32 *p = (u32 *)b->dma_va;
+
+	p[off / 4] = val;
+}
+
+static u32 om_buf_rd32(struct om_bridge *b, u32 off)
+{
+	const u32 *p = (const u32 *)b->dma_va;
+
+	return p[off / 4];
+}
+
+/* =========================================================== operations: TCM */
+
+static void om_op_zero(struct om_bridge *b, int argc, char **argv)
+{
+	u32 from = OM_ZERO_OD_777;
+	u32 to = OM_ZERO_DO_777;
+	u32 zapisane;
+	u32 v0 = 0, v1 = 0;
+
+	if (argc >= 3) {
+		if (kstrtouint(argv[1], 0, &from) || kstrtouint(argv[2], 0, &to)) {
+			om_blad(b, "zero: usage `zero <from_hex> <to_hex>` (default 0x%05x 0x%05x)\n",
+				OM_ZERO_OD_777, OM_ZERO_DO_777);
+			return;
+		}
+	}
+	if (to <= from || to > OM_RAMSIZE) {
+		om_blad(b, "zero: invalid range (0x%05x..0x%05x, ramsize 0x%05x)\n",
+			from, to, OM_RAMSIZE);
+		return;
+	}
+	om_emrg(b, "zero TCM [0x%05x,0x%05x) = %u B, the class from patch 0036 (4 KiB chunks, 32-bit writes) -- start\n",
+		from, to, to - from);
+	zapisane = om_tcm_zero(b, from, to);
+	(void)om_tcm_read32(b, from, &v0);
+	(void)om_tcm_read32(b, to - 4, &v1);
+	om_odp(b, "zero: wrote %u B of %u; check TCM[0x%05x]=0x%08x TCM[0x%05x]=0x%08x (expected 0x0 0x0)\n",
+	       zapisane, to - from, from, v0, to - 4, v1);
+	om_odp(b, "zero: TCM is NOT cleared by a reboot (project rulebook item 5) -- this command replaces the reboot\n");
+}
+
+/* loadfw: image to TCM from 0 (32-bit, the last dword padded with zeros).
+ * We do NOT write TCM[ramsize-4] (R2 from the project notes; patch 0037
+ * does the same on the 7.77 path). */
+static void om_op_loadfw(struct om_bridge *b, int argc, char **argv)
+{
+	struct file *f;
+	ssize_t n;
+	loff_t pos = 0;
+	u8 *dane;
+	u32 len;
+	u32 v0 = 0, v1 = 0;
+
+	if (argc < 2) {
+		om_blad(b, "loadfw: usage `loadfw <path>`\n");
+		return;
+	}
+	f = filp_open(argv[1], O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		om_blad(b, "loadfw: cannot open %s (%ld)\n", argv[1], PTR_ERR(f));
+		return;
+	}
+	len = (u32)i_size_read(file_inode(f));
+	if (len == 0 || len > OM_KONTRAKT) {
+		om_blad(b, "loadfw: size %u B out of range (1..0x%05x = the contract base)\n",
+			len, OM_KONTRAKT);
+		filp_close(f, NULL);
+		return;
+	}
+	dane = vmalloc(len);
+	if (!dane) {
+		om_blad(b, "loadfw: no memory for a %u B image\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	n = kernel_read(f, dane, len, &pos);
+	filp_close(f, NULL);
+	if (n != (ssize_t)len) {
+		om_blad(b, "loadfw: read %zd of %u B\n", n, len);
+		vfree(dane);
+		return;
+	}
+	om_emrg(b, "loadfw: %s = %u B -> TCM[0x00000..), 32-bit writes -- start\n", argv[1], len);
+	om_tcm_copy(b, OM_RAMBASE, dane, len);
+	b->rstvec = (u32)dane[0] | ((u32)dane[1] << 8) |
+		    ((u32)dane[2] << 16) | ((u32)dane[3] << 24);
+	b->rstvec_znamy = true;
+	vfree(dane);
+	(void)om_tcm_read32(b, 0, &v0);
+	(void)om_tcm_read32(b, OM_RAMSIZE - 4, &v1);
+	om_odp(b, "loadfw: check TCM[0x00000]=0x%08x (exp 0x%08x = rstvec); TCM[0x%05x]=0x%08x (we do NOT write this field -- R2)\n",
+	       v0, b->rstvec, OM_RAMSIZE - 4, v1);
+	if (len == OM_OBRAZ_ROZMIAR_777)
+		om_odp(b, "loadfw: rstvec = 0x%08x (first dword of the 7.77.0.0 image; `release` will use it)\n",
+		       b->rstvec);
+	else
+		om_odp(b, "loadfw: NOTE size != 0x%05x (the 7.77.0.0 image) -- rstvec = 0x%08x from this file\n",
+		       OM_OBRAZ_ROZMIAR_777, b->rstvec);
+}
+
+/* ================================================ operations: contract and vars */
+
+/* Contract: 12 fields. Order and values as in the reference tool l. 1129-1197 and pcie.c
+ * (patch 0036 + 0037). We write the semaphores as ZEROS (rule 7 in the file header);
+ * Apple writes 0 to +0x14/+0x18 (_wlc_ol_up, full.dis 0x73a3d/0x73a42), turn
+ * it leaves alone -- we zero turn too (reference tool l. 1156), because with flag[0]=0
+ * the fw loop condition does not hold anyway, and TCM is not cleared by a reboot. */
+static void om_op_contract(struct om_bridge *b, int argc, char **argv)
+{
+	u32 rb[12];
+	u32 hb = 0, fl = 0, rec = 0, me = 0;
+	u32 i;
+
+	om_emrg(b, "contract: 12 fields @0x%05x (TCM_end - 0x5F80) -- start of the write\n", OM_KONTRAKT);
+	(void)om_tcm_write32(b, OM_KONTRAKT + 0x0000, OM_MARKER_BEGIN_VAL);
+	if (b->dma_ok) {
+		(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUFADDR_LO,
+				     (u32)(b->dma_fiz & 0xffffffffu));
+		(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUFADDR_HI,
+				     (u32)((u64)b->dma_fiz >> 32));
+	} else {
+		om_blad(b, "contract: fields +0x%04x/+0x%04x SKIPPED -- the DMA buffer address 0x%llx does NOT pass the fw 7.77 gate (<4 GiB and the 64 MiB window); we do not invent an address\n",
+			OM_K_MSGBUFADDR_LO, OM_K_MSGBUFADDR_HI,
+			(unsigned long long)b->dma_fiz);
+	}
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUF_SZ, OM_MSGBUF_SZ);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_FLAG0, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_FLAG1, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TURN, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_HEARTBEAT, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TRAP_REC, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MARKER_END, OM_MARKER_END_VAL);
+
+	for (i = 0; i < 12; i++)
+		(void)om_tcm_read32(b, OM_KONTRAKT + i * 4, &rb[i]);
+	om_odp(b, "contract: +0x0 marker=0x%08x (exp 0x%08x)  +0x4 msgbuf_lo=0x%08x  +0x8 msgbuf_hi=0x%08x  +0xc sz=0x%08x\n",
+	       rb[0], OM_MARKER_BEGIN_VAL, rb[1], rb[2], rb[3]);
+	om_odp(b, "contract: +0x10 console_ptr=0x%08x (written by FW)  +0x14 flag[0]=0x%08x  +0x18 flag[1]=0x%08x  +0x1c turn=0x%08x (exp 0 0 0)\n",
+	       rb[4], rb[5], rb[6], rb[7]);
+	om_odp(b, "contract: +0x20 vars_size=0x%08x (0 = vars not loaded yet)\n", rb[8]);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_REC, &rec);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_MARKER_END, &me);
+	om_odp(b, "contract: +0x5028 hb=0x%08x  +0x502c trap=0x%08x  +0x5ed8 rec=0x%08x  +0x5f5c marker_end=0x%08x (exp 0x%08x)\n",
+	       hb, fl, rec, me, OM_MARKER_END_VAL);
+	if (rb[0] != OM_MARKER_BEGIN_VAL || me != OM_MARKER_END_VAL)
+		om_blad(b, "contract: NOTE the markers did NOT get written (the host validator @0x774e2/_wlc_ol_validate_shared_info checks them; the fw does NOT validate them)\n");
+	if (fl == OM_TRAP_FLAG_VAL)
+		om_blad(b, "contract: NOTE trap_flag was 0xDEADBEEF -- on a stale 0xDEADBEEF the fw enters an eternal spin (die() 0x344c -> b.n 0x3466), so we zero that field BEFORE the release\n");
+}
+
+/* vars: size @+0x20, text @+0x24 + FULL readback -- 1:1 with
+ * bcm4360_ol77_write_vars (pcie.c:5699-5760) and with the reference tool's `vars` command
+ * (reference tool l. 1201-1245). Size gate: MAXSZ_NVRAM_VARS 0x4000. */
+static void om_op_vars(struct om_bridge *b, int argc, char **argv)
+{
+	struct file *f;
+	ssize_t n;
+	loff_t pos = 0;
+	u8 *dane;
+	u32 len, i, niezgodne = 0;
+	u32 rozmiar_rb = 0;
+
+	if (argc < 2) {
+		om_blad(b, "vars: usage `vars <path>`\n");
+		return;
+	}
+	f = filp_open(argv[1], O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		om_blad(b, "vars: cannot open %s (%ld)\n", argv[1], PTR_ERR(f));
+		return;
+	}
+	len = (u32)i_size_read(file_inode(f));
+	if (len == 0 || len > OM_VARS_MAX) {
+		om_blad(b, "vars: size %u B out of the 1..0x%x range (MAXSZ_NVRAM_VARS)\n",
+			len, OM_VARS_MAX);
+		filp_close(f, NULL);
+		return;
+	}
+	if (OM_K_VARS + len > 0x5f80u) {
+		om_blad(b, "vars: %u B does not fit in the host struct (0x5F80 B)\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	dane = vmalloc(len);
+	if (!dane) {
+		om_blad(b, "vars: no memory for %u B\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	n = kernel_read(f, dane, len, &pos);
+	filp_close(f, NULL);
+	if (n != (ssize_t)len) {
+		om_blad(b, "vars: read %zd of %u B\n", n, len);
+		vfree(dane);
+		return;
+	}
+	om_emrg(b, "vars: %s = %u B -> contract+0x%02x (TCM[0x%05x..0x%05x]) -- start\n",
+		argv[1], len, OM_K_VARS, OM_KONTRAKT + OM_K_VARS,
+		OM_KONTRAKT + OM_K_VARS + len - 1);
+	/* Order as in the module and the reference tool: size FIRST, then the text */
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_VARS_SIZE, len);
+	om_tcm_copy(b, OM_KONTRAKT + OM_K_VARS, dane, len);
+	for (i = 0; i < len; i += 4) {
+		u32 rb = 0;
+		u32 k;
+
+		(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_VARS + i, &rb);
+		for (k = 0; k < 4; k++) {
+			u32 idx = i + k;
+			u8 oczek = (idx < len) ? dane[idx] : 0;
+
+			if ((u8)(rb >> (8 * k)) != oczek)
+				niezgodne++;
+		}
+	}
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_VARS_SIZE, &rozmiar_rb);
+	om_odp(b, "vars: readback vars_size=0x%08x (exp 0x%x) mismatched-bytes=%u\n",
+	       rozmiar_rb, len, niezgodne);
+	vfree(dane);
+}
+
+/* ===================================== D11: taking the reset off via the WRAPPER (0x18101000)
+ *
+ * WHY: in attach the fw 7.77 reads `clk_ctl_st` = D11+0x1e0 (`ldr.w r2,[r3,#0x1e0]`
+ * @pc 0x12cc2 with r3 = 0x18001000 => dfar 0x180011e0) and gets an **AXI timeout**,
+ * because **D11 IS IN RESET and its register space does not answer on the bus**.
+ * That is the same symptom and the same cause as in fire #20 (TRAP 4 @pc 0xe40a at
+ * 0x180011e0). Measured in the first bridge run: `dfar 0x180011e0`, `pc 0x12cc2`
+ * (project notes par. 2).
+ *
+ * RECIPE 1:1 from brcmfmac `brcmf_chip_ai_resetcore` (chip.c:434-489) -- the same
+ * path that in FIRE #23 (test.329, patch 0027) freed D11 and released the fw past
+ * pc=0xe40a. Measurement from that fire (project notes):
+ *     BEFORE: IOCTL(0x18101408) = 0x7   RESET_CTL(0x18101800) = 0x1
+ *     AFTER : IOCTL             = 0x5   RESET_CTL              = 0x0
+ * Triplet for D11: prereset = PHYRESET|PHYCLOCKEN (0xc), reset = postreset =
+ * PHYCLOCKEN (0x4) -- the same one the driver feeds D11 on other chips
+ * (chip.c:1288-1291, :1360-1363).
+ *
+ * BOUNDARY: we touch ONLY the WRAPPER page 0x18101000 (+0x408/+0x800/+0x804/
+ * +0x1e0) -- just as `om_reset_internal_mem` touches the SOCRAM wrapper and
+ * `release` the ARM wrapper. The core page 0x18001000 stays FORBIDDEN (HARD
+ * RULE, fire #21) -- and anyway it does not answer while RESET_CTL b0 = 1. No writes
+ * to the core; every loop is bounded, every write has a readback.
+ */
+static int om_d11_w_reset_ctl(struct om_bridge *b, u32 *val)
+{
+	return om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, val);
+}
+
+static void om_op_d11release(struct om_bridge *b, int argc, char **argv)
+{
+	const u32 prereset = OM_BCMA_IOCTL_PHYRESET | OM_BCMA_IOCTL_PHYCLOCKEN;	/* 0xc */
+	const u32 reset = OM_BCMA_IOCTL_PHYCLOCKEN;				/* 0x4 */
+	const u32 postreset = OM_BCMA_IOCTL_PHYCLOCKEN;				/* 0x4 */
+	u32 ioctl_przed = 0, reset_przed = 0, st_przed = 0, clk_przed = 0;
+	u32 ioctl_cfg = 0, ioctl_po = 0, reset_po = 0, st_po = 0, clk_po = 0;
+	u32 reset_ost = 0;	/* last SUCCESSFUL RESET_CTL read = the verdict basis */
+	bool po_ok = false;	/* whether the RESET_CTL read after removing the reset succeeded */
+	u32 i;
+
+	(void)argc;
+	(void)argv;
+	om_emrg(b, "d11release: D11 wrapper 0x%08x -- writes ONLY to the wrapper page; the core 0x%08x FORBIDDEN (HARD RULE, fire #21)\n",
+		OM_D11_WRAP, OM_D11_BASE);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_przed);
+	if (om_d11_w_reset_ctl(b, &reset_przed) != 0) {
+		om_blad(b, "d11release: wrapper RESET_CTL read failed -- the backplane is not answering; ABORTING (zero writes)\n");
+		return;
+	}
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_ST, &st_przed);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_CLKCTLST, &clk_przed);
+	om_odp(b, "d11release: BEFORE: IOCTL(+0x%03x)=0x%08x RESET_CTL(+0x%03x)=0x%08x RESET_ST=0x%08x CLKCTLST(+0x%03x)=0x%08x => %s\n",
+	       OM_BCMA_IOCTL, ioctl_przed, OM_BCMA_RESET_CTL, reset_przed, st_przed,
+	       OM_BCMA_CLKCTLST, clk_przed,
+	       (reset_przed & OM_BCMA_RESET_CTL_RESET) ?
+	       "D11 IN RESET (the core space does NOT answer -- hence the fw AXI timeout)" :
+	       "D11 out of reset (if the fw still loses the bus, the cause is elsewhere)");
+
+	/* step 1 -- only when the core is NOT in reset (chip.c:360-375): put it in reset,
+	 * because otherwise there is nothing to release. */
+	if (!(reset_przed & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL,
+				    prereset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_cfg);
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, OM_BCMA_RESET_CTL_RESET);
+		usleep_range(10, 20);
+		for (i = 0; i < 300; i++) {
+			u32 v = 0;
+
+			if (om_d11_w_reset_ctl(b, &v) != 0)
+				break;
+			if (v == OM_BCMA_RESET_CTL_RESET)
+				break;
+			udelay(1);
+		}
+		om_odp(b, "d11release: step 1 (putting into reset): IOCTL := 0x%08x (readback 0x%08x), RESET_CTL := 0x%08x\n",
+		       prereset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK, ioctl_cfg,
+		       OM_BCMA_RESET_CTL_RESET);
+	}
+	/* step 2 -- configuration in reset (chip.c:378-381). Expected 0x7 = fire #23 BEFORE. */
+	(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL,
+			    reset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_cfg);
+	om_odp(b, "d11release: step 2 (configuration in reset): IOCTL := 0x%08x (pattern fire #23: 0x7)\n",
+	       ioctl_cfg);
+	/* step 3 -- removing the reset, a BOUNDED loop (chip.c:459-470: max 50 tries). */
+	for (i = 0; i < 50; i++) {
+		if (om_d11_w_reset_ctl(b, &reset_po) != 0)
+			break;
+		reset_ost = reset_po;
+		po_ok = true;
+		if (!(reset_ost & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(40, 60);
+	}
+	/* Step 3 had NO line in the log until now (note from the 11.09.2026 audit) --
+	 * yet it is the crux of the verdict, so we report the loop exit. */
+	om_odp(b, "d11release: step 3 (removing the reset): RESET_CTL := 0 in a loop <= 50; exit at iteration %u, RESET_CTL = 0x%08x%s\n",
+	       i, reset_ost,
+	       po_ok ? "" : " (no RESET_CTL read succeeded)");
+	/* step 4 -- postreset (chip.c:483-485). Expected 0x5 = fire #23 AFTER. */
+	(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL, postreset | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_po);
+	/* Verdict only from a SUCCESSFUL read: a failed read = an UNKNOWN state, not
+	 * a "YES" from an uninitialized variable (the same error class as the static verdict
+	 * in `read rings` -- 11.09.2026). The last successful read = the current state. */
+	if (om_d11_w_reset_ctl(b, &reset_po) == 0) {
+		reset_ost = reset_po;
+		po_ok = true;
+	} else {
+		om_blad(b, "d11release: RESET_CTL read after the postreset FAILED -- verdict from the last successful read (0x%08x)\n",
+			reset_ost);
+	}
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_ST, &st_po);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_CLKCTLST, &clk_po);
+	om_odp(b, "d11release: AFTER: IOCTL=0x%08x RESET_CTL=0x%08x (successful read: %s) RESET_ST=0x%08x CLKCTLST(+0x%03x)=0x%08x\n",
+	       ioctl_po, reset_ost, po_ok ? "yes" : "NO -- state UNKNOWN", st_po,
+	       OM_BCMA_CLKCTLST, clk_po);
+	om_odp(b, "d11release: VERDICT: D11 came out of reset: %s (RESET_CTL b0: 0x%x -> 0x%x); IOCTL 0x%x -> 0x%x (pattern fire #23: 0x7 -> 0x5)\n",
+	       !po_ok ? "UNKNOWN (no RESET_CTL read succeeded)" :
+	       (reset_ost & OM_BCMA_RESET_CTL_RESET) ? "NO" : "YES",
+	       reset_przed & 1u, reset_ost & 1u, ioctl_cfg, ioctl_po);
+	om_odp(b, "d11release: order MEASURED (test.342/345; pcie.c:5874 image, :5883 TCM): this step after `zero`/`loadfw`/`contract`/`vars`, before `maccontrol` and `release` -- the two walls are independent: first the bus (reset), then the clk predicate (maccontrol)\n");
+}
+
+/* ==================================================== maccontrol (D11 page)
+ *
+ * DOUBLE GATE: the module parameter `d11_ok=1` AND the token `d11-ok` in the
+ * command itself -- BOTH checked BEFORE any MMIO (requirements 3 and 5
+ * of the brief; HARD RULE project rulebook item 7). Value: the kext seed 0x04000400
+ * (MCTL_IHR_EN b10 | MCTL_WAKE b26) -- project notes;
+ * measured in test.341/342: releases the fw out of the `clk == 0` assert. */
+static void om_op_maccontrol(struct om_bridge *b, int argc, char **argv)
+{
+	u32 addr = OM_D11_BASE + OM_D11_MACCONTROL_OFF;
+	u32 wartosc = OM_D11_MACCONTROL_SEED;
+	u32 przed = 0, po = 0;
+	bool token = false;
+	int i;
+
+	for (i = 1; i < argc; i++)
+		if (!strcmp(argv[i], "d11-ok"))
+			token = true;
+
+	if (!d11_ok) {
+		om_blad(b, "REFUSAL: maccontrol touches the D11 page 0x%08x but the module was not loaded with `d11_ok=1` -- HARD RULE project rulebook item 7 (fire #21 = machine hang). Zero MMIO.\n",
+			addr);
+		return;
+	}
+	if (!token) {
+		om_blad(b, "REFUSAL: maccontrol requires the `d11-ok` token in the command itself (e.g. `maccontrol 0x04000400 d11-ok`) despite d11_ok=1. Zero MMIO.\n");
+		return;
+	}
+	if (argc >= 2 && strcmp(argv[1], "d11-ok") && kstrtouint(argv[1], 0, &wartosc)) {
+		om_blad(b, "maccontrol: usage `maccontrol [<hex>] d11-ok` (without a value I take the kext seed 0x%08x)\n",
+			OM_D11_MACCONTROL_SEED);
+		return;
+	}
+	/* SAFETY LOCK (added 11.09.2026): while D11 is IN RESET, its
+	 * register space does not answer on the bus -- every access to it is an AXI
+	 * timeout, and on a host read a real machine hang (fire #21). We read the state
+	 * from the WRAPPER (0x18101000), which answers ALWAYS.
+	 * FAIL-CLOSED GATE (11.09.2026, after the audit): a FAILED wrapper read is NOT
+	 * "no proof of reset" but an "UNKNOWN state" -- and such a case also ends
+	 * in a refusal. The previous version then allowed the write to the core page (the only
+	 * execution of the HARD RULE was fail-open). */
+	{
+		u32 rc = 0;
+
+		if (om_d11_w_reset_ctl(b, &rc) != 0) {
+			om_blad(b, "REFUSAL: wrapper RESET_CTL read 0x%08x FAILED -- D11 state UNKNOWN, and with D11 in reset the core page 0x%08x does not answer on the bus (AXI timeout/hang, fire #21). The gate is FAIL-CLOSED. Zero MMIO on the core.\n",
+				OM_D11_WRAP + OM_BCMA_RESET_CTL, addr);
+			return;
+		}
+		if (rc & OM_BCMA_RESET_CTL_RESET) {
+			om_blad(b, "REFUSAL: D11 IS IN RESET (wrapper 0x%08x RESET_CTL=0x%08x) -- the core page 0x%08x does NOT answer on the bus; access = AXI timeout/hang (fire #21). Run `d11release` first. Zero MMIO on the core.\n",
+				OM_D11_WRAP, rc, addr);
+			return;
+		}
+		om_odp(b, "maccontrol: D11 wrapper RESET_CTL=0x%08x => core out of reset, accessing page 0x%08x makes sense\n",
+		       rc, addr);
+	}
+	om_emrg(b, "maccontrol: D11 0x%08x := 0x%08x -- DELIBERATE access to the D11 PAGE (d11_ok=1 + the d11-ok token + the FAIL-CLOSED gate; only entry: om_bp_*_d11)\n",
+		addr, wartosc);
+	if (om_bp_read32_d11(b, addr, &przed) == 0)
+		om_odp(b, "maccontrol: PRZED = 0x%08x\n", przed);
+	if (om_bp_write32_d11(b, addr, wartosc) == 0 && om_bp_read32_d11(b, addr, &po) == 0)
+		om_odp(b, "maccontrol: after the write 0x%08x (readback 0x%08x) -- %s; fw predicate (mctrl & 0x404) = 0x%03x => %s\n",
+		       wartosc, po, po == wartosc ? "write landed" : "WRITE DID NOT LAND",
+		       po & 0x404u,
+		       (po & 0x404u) == 0x400u ? "D11 present for the fw (clk != 0)" :
+						 "fw treats D11 as absent (clk = 0)");
+}
+
+/* ============================================ reset SOCRAM + release ARM */
+
+/* INTERNAL_MEM core reset (0x81a) before the release -- pcie.c:4076-4081,
+ * chip.c:350-486 (ai_coredisable + reset-removal loop + IOCTL := postreset|CLK). */
+static void om_reset_internal_mem(struct om_bridge *b)
+{
+	u32 v = 0, i;
+
+	om_emrg(b, "release: resetting the INTERNAL_MEM core (SOCRAM, wrap 0x%08x) -- brcmf_chip_resetcore(core,0,0,0)\n",
+		OM_SOCRAM_WRAP);
+	if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+		return;
+	om_odp(b, "release: SOCRAM RESET_CTL before = 0x%08x\n", v);
+	if (!(v & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL,
+				    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, &v);
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL,
+				    OM_BCMA_RESET_CTL_RESET);
+		usleep_range(15, 30);
+	}
+	(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL,
+			    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	for (i = 0; i < 50; i++) {
+		if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+			break;
+		if (!(v & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(50, 60);
+	}
+	(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, OM_BCMA_IOCTL_CLK);
+	if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, &v) == 0)
+		om_odp(b, "release: SOCRAM IOCTL after the reset = 0x%08x\n", v);
+}
+
+/* ARM release -- sequence 1:1 from the reference tool (op_release, reference tool l. 1309-1364):
+ * ops->activate = TCM[0] := rstvec (pcie.c brcmf_pcie_buscore_activate) +
+ * brcmf_chip_resetcore(core_arm_cr4, CPUHALT, 0, 0) (chip.c:1351-1362).
+ * Effect = the kext's RMW `wrapper[0x408] &= ~0x20` (project notes):
+ * the last IOCTL write is CLK without CPUHALT => ARM starts. */
+static void om_op_release(struct om_bridge *b, int argc, char **argv)
+{
+	u32 v = 0, i;
+	u32 rstvec;
+
+	if (b->rstvec_znamy) {
+		rstvec = b->rstvec;
+		om_odp(b, "release: rstvec = 0x%08x (from the last `loadfw`)\n", rstvec);
+	} else {
+		(void)om_tcm_read32(b, 0, &rstvec);
+		om_odp(b, "release: NOTE no `loadfw` in this session -- I take rstvec from TCM[0x00000] = 0x%08x (may be junk from a previous run; `reset` does not clear TCM)\n",
+		       rstvec);
+	}
+	om_reset_internal_mem(b);
+	om_emrg(b, "release: TCM[0x00000] := 0x%08x + ARM wrapper 0x%08x (RESET_CTL, IOCTL, loop, IOCTL := CLK without CPUHALT) -- start\n",
+		rstvec, OM_ARM_WRAP);
+	(void)om_tcm_write32(b, OM_RAMBASE, rstvec);
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) != 0) {
+		om_blad(b, "release: cannot read the ARM RESET_CTL -- ABORTED (no further writes)\n");
+		return;
+	}
+	om_odp(b, "release: ARM RESET_CTL before = 0x%08x (in reset: %s)\n", v,
+	       (v & OM_BCMA_RESET_CTL_RESET) ? "YES" : "NO");
+	if (!(v & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL,
+				    OM_ARMCR4_IOCTL_CPUHALT | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v);
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, OM_BCMA_RESET_CTL_RESET);
+		usleep_range(15, 30);
+	}
+	(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL,
+			    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v);
+	for (i = 0; i < 50; i++) {
+		if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+			break;
+		if (!(v & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(50, 60);
+	}
+	(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, OM_BCMA_IOCTL_CLK);
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v) == 0) {
+		om_odp(b, "release: ARM IOCTL after the release = 0x%08x (CPUHALT b5 = %u => %s)\n",
+		       v, (v >> 5) & 1u,
+		       (v & OM_ARMCR4_IOCTL_CPUHALT) ? "ARM still in halt" : "ARM STARTED");
+		b->arm_wypuszczony = !(v & OM_ARMCR4_IOCTL_CPUHALT);
+	}
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) == 0)
+		om_odp(b, "release: ARM RESET_CTL after the release = 0x%08x\n", v);
+}
+
+/* ============================================== readiness gate and the fw console */
+
+/* Poll contract+0x5028 every 1 ms, limit 2000 (default; the argument changes the limit).
+ * After the timeout LOG and CONTINUE -- never an error (Apple does exactly this:
+ * kext 0x73d3a-0x73d63; project notes par. 2.1). */
+static void om_op_gate(struct om_bridge *b, int argc, char **argv)
+{
+	u32 limit = OM_GATE_ITERACJE;
+	u32 i, hb = 0;
+
+	if (argc >= 2) {
+		if (kstrtouint(argv[1], 0, &limit) || limit == 0)
+			limit = OM_GATE_ITERACJE;
+	}
+	om_odp(b, "gate: poll TCM[0x%05x] (heartbeat = contract+0x%04x) every 1 ms, limit %u\n",
+	       OM_KONTRAKT + OM_K_HEARTBEAT, OM_K_HEARTBEAT, limit);
+	for (i = 0; i < limit; i++) {
+		(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+		if (hb)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (hb)
+		om_odp(b, "gate: heartbeat = 0x%08x after %u iterations -- FW ALIVE\n", hb, i + 1);
+	else
+		om_odp(b, "gate: TIMEOUT after %u ms, heartbeat still 0 -- CONTINUING (Apple does not interrupt the boot either; there is no error branch)\n",
+		       limit);
+}
+
+/* Pointer of the fw console struct (contract+0x10) and its fields
+ * {buf @+0, size @+4, wr_idx @+8} -- notes par. 5.2; published by the FW. */
+static int om_konsola(struct om_bridge *b, u32 *ptr, u32 *buf, u32 *size, u32 *wr)
+{
+	if (om_tcm_read32(b, OM_KONTRAKT + OM_K_CONSOLE_PTR, ptr) != 0)
+		return -EIO;
+	if (!*ptr || *ptr >= OM_RAMSIZE)
+		return -ENODATA;
+	if (om_tcm_read32(b, *ptr + 0x0, buf) || om_tcm_read32(b, *ptr + 0x4, size) ||
+	    om_tcm_read32(b, *ptr + 0x8, wr))
+		return -EIO;
+	if (!*buf || *buf >= OM_RAMSIZE || !*size || *size > OM_RAMSIZE)
+		return -ENODATA;
+	return 0;
+}
+
+static bool om_konsola_ma(struct om_bridge *b, const char *szukana)
+{
+	u32 ptr, buf, size, wr, n, i, k, dl;
+
+	if (om_konsola(b, &ptr, &buf, &size, &wr) != 0)
+		return false;
+	dl = (u32)strlen(szukana);
+	n = (wr > size) ? size : wr;	/* wr > size => the counter wrapped the ring */
+	if (!dl || n < dl || buf + n > b->bar2_len)
+		return false;
+	for (i = 0; i + dl <= n; i++) {
+		for (k = 0; k < dl; k++) {
+			u8 c = ioread8(b->bar2 + buf + i + k);
+
+			if (c != (u8)szukana[k])
+				break;
+		}
+		if (k == dl)
+			return true;
+	}
+	return false;
+}
+
+/* Waiting for the `pciedngl_open called` line before the doorbell (notes par. 6, item 5).
+ * Without it the doorbell may be latched and unserviced -- the fw reads the ring
+ * ONLY in its ISR. After ~2 s we move on (measurement: the line appears after 0.052 s). */
+static void om_czekaj_pciedngl_open(struct om_bridge *b)
+{
+	u32 i, cierpliwosc = OM_KONSOLA_CZEKAJ_MS / 10u;
+
+	om_odp(b, "waiting for the `%s` line in the fw console (contract+0x%04x -> P+0/4/8), max ~%u ms\n",
+	       OM_KONSOLA_LINIA, OM_K_CONSOLE_PTR, OM_KONSOLA_CZEKAJ_MS);
+	for (i = 0; i < cierpliwosc; i++) {
+		if (om_konsola_ma(b, OM_KONSOLA_LINIA)) {
+			om_odp(b, "fw console: `%s` IS THERE (after ~%u ms) -- fw armed for the doorbell\n",
+			       OM_KONSOLA_LINIA, (i + 1) * 10u);
+			return;
+		}
+		usleep_range(10000, 11000);
+	}
+	om_odp(b, "fw console: `%s` did NOT appear within ~%u ms -- sending anyway (the doorbell may go unserviced; with an empty ring the fw ISR only prints `pktlen: 0`)\n",
+	       OM_KONSOLA_LINIA, OM_KONSOLA_CZEKAJ_MS);
+}
+
+/* =========================================================== DMA rings */
+
+static void om_op_ringinit(struct om_bridge *b, int argc, char **argv)
+{
+	static const struct {
+		u32 off, val;
+		const char *opis;
+	} h[8] = {
+		{ OM_RING_HDR_H2D + 0x0, OM_RING_DATA_H2D, "H2D data_off" },
+		{ OM_RING_HDR_H2D + 0x4, OM_RING_ROZMIAR, "H2D size" },
+		{ OM_RING_HDR_H2D + 0x8, 0, "H2D rd (written by FW: consumption)" },
+		{ OM_RING_HDR_H2D + 0xc, 0, "H2D wr (written by HOST: publication)" },
+		{ OM_RING_HDR_D2H + 0x0, OM_RING_DATA_D2H, "D2H data_off" },
+		{ OM_RING_HDR_D2H + 0x4, OM_RING_ROZMIAR, "D2H size" },
+		{ OM_RING_HDR_D2H + 0x8, 0, "D2H rd (written by HOST)" },
+		{ OM_RING_HDR_D2H + 0xc, 0, "D2H wr (written by FW)" },
+	};
+	u32 i;
+
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "ringinit: no verified DMA buffer (address 0x%llx) -- the ring headers have nowhere to live\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	om_emrg(b, "ringinit: headers of both olmsg rings in the DMA buffer 0x%llx (host RAM, zero MMIO; equivalent to bcm_olmsg_init @0x4f38) -- start\n",
+		(unsigned long long)b->dma_fiz);
+	for (i = 0; i < 8; i++) {
+		om_buf_wr32(b, h[i].off, h[i].val);
+		om_odp(b, "ringinit: buf+0x%02x := 0x%08x (%s)\n", h[i].off, h[i].val, h[i].opis);
+	}
+	wmb();
+	om_odp(b, "ringinit: readback %08x %08x %08x %08x | %08x %08x %08x %08x\n",
+	       om_buf_rd32(b, 0x00), om_buf_rd32(b, 0x04), om_buf_rd32(b, 0x08),
+	       om_buf_rd32(b, 0x0c), om_buf_rd32(b, 0x10), om_buf_rd32(b, 0x14),
+	       om_buf_rd32(b, 0x18), om_buf_rd32(b, 0x1c));
+}
+
+/* Writing an olmsg message to the H2D ring: header {type,seq,len}, 4 B LE each
+ * at `off`, then `len` bytes of payload -- 1:1 with bcm4360_olmsg_write
+ * (pcie.c:1570-1576) and with `olmsg_peek_len` @0x4d48 in the fw (total = len + 12).
+ * The fw does NOT validate `seq` (olmsg_readmsg @0x4e24) => 0, as at Apple. */
+static void om_ring_msg(struct om_bridge *b, u32 off, u32 typ, u32 seq,
+			u32 len, const u8 *payload)
+{
+	u32 i;
+
+	om_buf_wr32(b, off + 0, typ);
+	om_buf_wr32(b, off + 4, seq);
+	om_buf_wr32(b, off + 8, len);
+	for (i = 0; i < len; i++)
+		((u8 *)b->dma_va)[off + OM_OLMSG_HDR + i] = payload[i];
+}
+
+/* Scan of the D2H ring from OUR buffer (host RAM, zero MMIO) + moving
+ * rd onto wr. Called from the interrupt thread AND right after the doorbell (R7 from the project notes
+ * on DMA/IRQ addresses, par. 4: an RMW on 0x48 can clear a FOREIGN pending
+ * D2H notification -- bit 8 is W1C -- so right after our own write we must
+ * scan the ring so that that notification is not lost). */
+static void om_d2h_scan(struct om_bridge *b, const char *skad)
+{
+	u32 rd = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD);
+	u32 wr = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR);
+	u32 n = (wr >= rd) ? (wr - rd) : (OM_RING_ROZMIAR - rd + wr);
+	u32 off;
+
+	om_odp(b, "d2h (%s): rd=%u wr=%u (%u B)\n", skad, rd, wr, n);
+	if (!n || wr > OM_RING_ROZMIAR)
+		return;
+	for (off = 0; off + OM_OLMSG_HDR <= n; ) {
+		u32 typ = om_buf_rd32(b, OM_RING_DATA_D2H + off);
+		u32 seq = om_buf_rd32(b, OM_RING_DATA_D2H + off + 4);
+		u32 len = om_buf_rd32(b, OM_RING_DATA_D2H + off + 8);
+
+		if (off + OM_OLMSG_HDR + len > OM_RING_ROZMIAR) {
+			om_blad(b, "d2h (%s): header @+0x%04x incoherent (len %u) -- aborting\n",
+				skad, OM_RING_DATA_D2H + off, len);
+			break;
+		}
+		om_odp(b, "d2h (%s): @buf+0x%04x type=0x%08x seq=%u len=%u\n",
+		       skad, OM_RING_DATA_D2H + off, typ, seq, len);
+		off += OM_OLMSG_HDR + len;
+		if (off == n)
+			break;
+	}
+	om_buf_wr32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD, wr);
+}
+
+/* H2D doorbell: BAR0+0x48 |= 0x1 -- RMW like Apple (`_wlc_ol_msg_send`
+ * 0x76e3c-0x76e5a: read + orl $0x1 + write) and like our module. The register lies
+ * in PCIE2 (0x18003048), NOT in D11 (project notes); bit 0 =>
+ * the fw sees bit 8 of its intstatus and enters `pciedngl_isr`. */
+static void om_doorbell(struct om_bridge *b, const char *skad)
+{
+	u32 przed = 0, po = 0;
+
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, &przed) != 0) {
+		om_blad(b, "doorbell (%s): cannot read BAR0+0x%03x -- SKIPPED\n",
+			skad, OM_R_MAILBOXINT);
+		return;
+	}
+	om_emrg(b, "doorbell (%s): BAR0+0x%03x: 0x%08x |= 0x1 -- start\n",
+		skad, OM_R_MAILBOXINT, przed);
+	if (om_bp_write32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, przed | OM_DB_H2D) != 0) {
+		om_blad(b, "doorbell (%s): the write failed\n", skad);
+		return;
+	}
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, &po) == 0)
+		om_odp(b, "doorbell (%s): readback 0x%08x (bit0 %s, bit8 %s)\n", skad, po,
+		       (po & OM_DB_H2D) ? "latched (the fw has not taken it yet)" : "already taken by the fw",
+		       (po & OM_INT_D2H) ? "SET -- the fw has a D2H notification" : "clean");
+	if (po & OM_INT_D2H)
+		om_d2h_scan(b, "after the doorbell (R7)");
+}
+
+/* =============================================================== send/sendtrio */
+
+static void om_op_send(struct om_bridge *b, int argc, char **argv)
+{
+	u8 payload[OM_OLMSG_MAX_TOTAL];
+	u32 typ, len = 0, total, wr, off;
+	int i;
+
+	if (argc < 4) {
+		om_blad(b, "send: usage `send <type_hex> <len_hex> <payload_hex|->`\n");
+		return;
+	}
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "send: no verified DMA buffer (address 0x%llx) -- nowhere to build the H2D ring\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	if (kstrtouint(argv[1], 0, &typ) || kstrtouint(argv[2], 0, &len)) {
+		om_blad(b, "send: type and len must be numbers (hex with 0x)\n");
+		return;
+	}
+	if (len > sizeof(payload) || len + OM_OLMSG_HDR > OM_OLMSG_MAX_TOTAL) {
+		om_blad(b, "send: len of %u B exceeds the fw limit (total = len + 12 <= 0x%x; a larger message hangs the fw ISR in a loop)\n",
+			len, OM_OLMSG_MAX_TOTAL);
+		return;
+	}
+	if (strcmp(argv[3], "-") != 0) {
+		const char *h = argv[3];
+
+		if (strlen(h) != (size_t)len * 2) {
+			om_blad(b, "send: payload has %zu chars but len = %u B (expected %u hex chars)\n",
+				strlen(h), len, len * 2);
+			return;
+		}
+		for (i = 0; i < (int)len; i++) {
+			u8 hi = (h[i * 2] >= '0' && h[i * 2] <= '9') ? h[i * 2] - '0' :
+				(h[i * 2] >= 'a' && h[i * 2] <= 'f') ? h[i * 2] - 'a' + 10 :
+				(h[i * 2] >= 'A' && h[i * 2] <= 'F') ? h[i * 2] - 'A' + 10 : 0xff;
+			u8 lo = (h[i * 2 + 1] >= '0' && h[i * 2 + 1] <= '9') ? h[i * 2 + 1] - '0' :
+				(h[i * 2 + 1] >= 'a' && h[i * 2 + 1] <= 'f') ? h[i * 2 + 1] - 'a' + 10 :
+				(h[i * 2 + 1] >= 'A' && h[i * 2 + 1] <= 'F') ? h[i * 2 + 1] - 'A' + 10 : 0xff;
+
+			if (hi == 0xff || lo == 0xff) {
+				om_blad(b, "send: payload is not hex (char %d)\n", i * 2);
+				return;
+			}
+			payload[i] = (u8)((hi << 4) | lo);
+		}
+	}
+	total = OM_OLMSG_HDR + len;
+	wr = om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR);
+	if (wr + total > OM_RING_ROZMIAR) {
+		om_blad(b, "send: H2D ring full (wr=%u + %u B > 0x%x) -- we do not implement wrapping; wait for the fw to consume (rd), or `ringinit`\n",
+			wr, total, OM_RING_ROZMIAR);
+		return;
+	}
+	off = OM_RING_DATA_H2D + wr;
+	om_czekaj_pciedngl_open(b);
+	om_ring_msg(b, off, typ, 0, len, payload);
+	/* barrier before publishing the index -- equivalent of __sync_synchronize()
+	 * from the reference tool l. 1765-1767; without it the fw could see `wr` before the data */
+	wmb();
+	om_buf_wr32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR, wr + total);
+	wmb();
+	om_odp(b, "send: type 0x%08x len %u -> buf+0x%04x, published wr = %u (was %u)\n",
+	       typ, len, off, wr + total, wr);
+	om_doorbell(b, "po send");
+}
+
+static void om_op_sendtrio(struct om_bridge *b, int argc, char **argv)
+{
+	static const u32 ltr[5] = { 60, 100, 3, 50, 20 };
+	u8 p1[OM_TRIO_TS_LEN], p2[OM_TRIO_EWT_LEN], p3[OM_TRIO_LTR_LEN];
+	u32 uptime;
+	u32 o1 = OM_RING_DATA_H2D;
+	u32 o2 = OM_RING_DATA_H2D + OM_OLMSG_HDR + OM_TRIO_TS_LEN;
+	u32 o3 = OM_RING_DATA_H2D + 2u * (OM_OLMSG_HDR + OM_TRIO_TS_LEN);
+	u32 i, k;
+	u32 wr_przed;
+
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "sendtrio: no verified DMA buffer (address 0x%llx) -- nowhere to build the H2D ring\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	/* host uptime in ms -- Apple takes it right before the send
+	 * (`_osl_sysuptime()` @0x759c9); the reference tool: CLOCK_MONOTONIC
+	 * (reference tool l. 894-905). ktime_get() = the same clock. We compute the payload
+	 * AFTER the gates (waiting for the console can take seconds). */
+	wr_przed = om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR);
+	om_emrg(b, "sendtrio: 3 messages at buf+0x%04x/0x%04x/0x%04x, published wr = %u, ONE doorbell -- start\n",
+		o1, o2, o3, OM_TRIO_WR);
+	if (wr_przed)
+		om_blad(b, "sendtrio: NOTE the H2D ring was not empty (wr = %u) -- the Apple trio assumes an empty ring and OVERWRITES its beginning; it publishes %u\n",
+			wr_przed, OM_TRIO_WR);
+	om_czekaj_pciedngl_open(b);
+	uptime = (u32)ktime_to_ms(ktime_get());
+	for (i = 0; i < 4; i++)
+		p1[i] = (u8)(uptime >> (8 * i));
+	for (i = 0; i < 4; i++)
+		p2[i] = (u8)(OM_TRIO_EWT_VAL >> (8 * i));
+	p3[0] = 0;	/* ltr_enabled  = 0 -- our host has no LTR (notes par. 5.5) */
+	p3[1] = 0;	/* obff_enabled = 0 */
+	for (i = 0; i < 5; i++)
+		for (k = 0; k < 4; k++)
+			p3[2 + i * 4 + k] = (u8)(ltr[i] >> (8 * k));
+
+	om_ring_msg(b, o1, OM_TRIO_TYP_TS, 0, OM_TRIO_TS_LEN, p1);
+	om_ring_msg(b, o2, OM_TRIO_TYP_EWT, 0, OM_TRIO_EWT_LEN, p2);
+	om_ring_msg(b, o3, OM_TRIO_TYP_LTR, 0, OM_TRIO_LTR_LEN, p3);
+	om_odp(b, "sendtrio: #1 0x%08x len %u payload u32 = %u (0x%08x) = host uptime in ms\n",
+	       OM_TRIO_TYP_TS, OM_TRIO_TS_LEN, uptime, uptime);
+	om_odp(b, "sendtrio: #2 0x%08x len %u payload u32 = %u (iovar wowl_excess_wake_timeout)\n",
+	       OM_TRIO_TYP_EWT, OM_TRIO_EWT_LEN, OM_TRIO_EWT_VAL);
+	om_odp(b, "sendtrio: #3 0x%08x len %u payload 22 B: [0]=0 [1]=0 then u32 %u %u %u %u %u\n",
+	       OM_TRIO_TYP_LTR, OM_TRIO_LTR_LEN, ltr[0], ltr[1], ltr[2], ltr[3], ltr[4]);
+	wmb();
+	om_buf_wr32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR, OM_TRIO_WR);
+	wmb();
+	om_odp(b, "sendtrio: published wr = %u (readback %u) -- 16+16+34, NOT 50 (at 50 the fw would read a truncated third message)\n",
+	       OM_TRIO_WR, om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR));
+	om_doorbell(b, "after trio");
+}
+
+/* ================================================================= interrupts */
+
+static irqreturn_t om_isr_szybki(int irq, void *arg)
+{
+	struct om_bridge *b = arg;
+
+	if (!ioread32(b->bar0 + OM_R_MAILBOXINT))
+		return IRQ_NONE;
+	return IRQ_WAKE_THREAD;
+}
+
+/* Interrupt thread: W1C of the bits that arrived in MAILBOXINT, after bit 8 (D2H)
+ * a D2H ring scan, at the end a mask re-arm RMW |= 0x100 (pattern wl.ko
+ * wlc_ol_enable_intrs, pcie.c brcmf_pcie_intr_enable).
+ * NOTE: this thread does NOT take om_lock (it could block a command for seconds)
+ * and touches ONLY the DMA buffer (host RAM, module property) + the 0x48
+ * and 0x4C registers. The buffer is freed only after free_irq() in om_remove(). */
+static irqreturn_t om_isr_watek(int irq, void *arg)
+{
+	struct om_bridge *b = arg;
+	u32 status = ioread32(b->bar0 + OM_R_MAILBOXINT);
+
+	if (status) {
+		iowrite32(status, b->bar0 + OM_R_MAILBOXINT);	/* W1C */
+		if (status & OM_INT_D2H)
+			om_d2h_scan(b, "ISR");
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) | OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+	}
+	return IRQ_HANDLED;
+}
+
+static void om_op_irq(struct om_bridge *b, int argc, char **argv)
+{
+	u32 is = 0, im = 0;
+	int err;
+
+	if (argc < 2 || (strcmp(argv[1], "on") && strcmp(argv[1], "off"))) {
+		om_blad(b, "irq: usage `irq on|off`\n");
+		return;
+	}
+	if (!strcmp(argv[1], "on")) {
+		if (b->irq_on) {
+			om_odp(b, "irq: already on (irq=%u)\n", b->pdev->irq);
+			return;
+		}
+		if (!b->pdev->irq) {
+			om_blad(b, "irq: pdev->irq = 0 -- the card has no interrupt line\n");
+			return;
+		}
+		/* MSI like in the module: pci_enable_msi (we log the result, it is not
+		 * critical -- without MSI INTx remains), and on a failed
+		 * request_threaded_irq we back off from MSI (pcie.c request_irq). */
+		err = pci_enable_msi(b->pdev);
+		b->msi_on = (err == 0);
+		om_odp(b, "irq: pci_enable_msi = %d (%s)\n", err,
+		       b->msi_on ? "MSI enabled" : "MSI unavailable -- INTx remains");
+		err = request_threaded_irq(b->pdev->irq, om_isr_szybki, om_isr_watek,
+					   IRQF_SHARED, OM_NAZWA, b);
+		if (err) {
+			om_blad(b, "irq: request_threaded_irq(%u) = %d\n", b->pdev->irq, err);
+			if (b->msi_on) {
+				pci_disable_msi(b->pdev);
+				b->msi_on = false;
+			}
+			return;
+		}
+		b->irq_on = true;
+		/* unmasking like wl.ko: RMW BAR0+0x4C |= 0x100 (pcie.c:4496-4503).
+		 * NEVER an absolute 0 write in the up-path (project notes par. 2). */
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) | OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+		om_odp(b, "irq: ON (irq=%u), BAR0+0x%03x |= 0x%03x (we do NOT touch register 0x%03x/intmask -- the fw does intmask |= 0x100 itself in pciedngl_open)\n",
+		       b->pdev->irq, OM_R_MAILBOXMASK, OM_INT_MASK, OM_R_INTMASK);
+	} else {
+		if (b->irq_on) {
+			free_irq(b->pdev->irq, b);
+			b->irq_on = false;
+		}
+		if (b->msi_on) {
+			pci_disable_msi(b->pdev);
+			b->msi_on = false;
+		}
+		/* RMW -- we do not zero the whole register (other mask bits may be the fw's) */
+		iowrite32(ioread32(b->bar0 + OM_R_MAILBOXMASK) & ~OM_INT_MASK,
+			  b->bar0 + OM_R_MAILBOXMASK);
+		om_odp(b, "irq: OFF (BAR0+0x%03x &= ~0x%03x)\n", OM_R_MAILBOXMASK, OM_INT_MASK);
+	}
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_INTSTATUS, &is) == 0 &&
+	    om_bp_read32(b, OM_PCIE2_BASE + OM_R_INTMASK, &im) == 0)
+		om_odp(b, "irq: intstatus = 0x%08x, intmask = 0x%08x (intmask 0x100 = the fw is already armed: pciedngl_open)\n",
+		       is, im);
+}
