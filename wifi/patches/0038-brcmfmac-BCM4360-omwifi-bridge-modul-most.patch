+static void om_wykonaj(struct om_bridge *b, char *linia)
+{
+	char *argv[8];
+	int argc = 0;
+	char *p = linia;
+	unsigned int i;
+
+	while (argc < (int)ARRAY_SIZE(argv)) {
+		char *tok = strsep(&p, " \t");
+
+		if (!tok)
+			break;
+		if (!*tok)
+			continue;
+		argv[argc++] = tok;
+	}
+	if (!argc) {
+		om_blad(b, "(empty command) -- `help`\n");
+		return;
+	}
+
+	b->odmowa_d11_log = false;
+	b->okno_mask_log = false;
+	b->resp_uciete = false;
+	b->resp_len = 0;
+	b->resp_pos = 0;
+	b->resp[0] = 0;
+
+	/* The invariant the ISR and the direct BAR0+0x20/
+	 * 0x24/0x48/0x4C reads depend on: the backplane window points at PCIE2. We set it BEFORE
+	 * every command (cost = one config write) so that no earlier
+	 * run left the window on another core. */
+	om_okno_restore(b);
+
+	for (i = 0; i < ARRAY_SIZE(om_tabela); i++) {
+		if (!strcmp(argv[0], om_tabela[i].nazwa)) {
+			om_odp(b, "> %s\n", linia);
+			om_tabela[i].fn(b, argc, argv);
+			return;
+		}
+	}
+	om_blad(b, "unknown command `%s` -- `help`\n", argv[0]);
+}
+
+/* ======================================================== character device */
+
+static ssize_t om_fop_read(struct file *f, char __user *ubuf, size_t count, loff_t *pos)
+{
+	struct om_bridge *b;
+	size_t n;
+
+	if (mutex_lock_interruptible(&om_lock))
+		return -ERESTARTSYS;
+	b = om;
+	if (!b) {
+		mutex_unlock(&om_lock);
+		return -ENODEV;
+	}
+	if (b->resp_pos >= b->resp_len) {
+		mutex_unlock(&om_lock);
+		return 0;			/* EOF -- `cat` ends its work */
+	}
+	n = min(count, b->resp_len - b->resp_pos);
+	if (copy_to_user(ubuf, b->resp + b->resp_pos, n)) {
+		mutex_unlock(&om_lock);
+		return -EFAULT;
+	}
+	b->resp_pos += n;
+	mutex_unlock(&om_lock);
+	return n;
+}
+
+static ssize_t om_fop_write(struct file *f, const char __user *ubuf, size_t count, loff_t *pos)
+{
+	struct om_bridge *b;
+	char *linia;
+	size_t n;
+
+	if (!count || count > OM_LINIA_MAX)
+		return -EINVAL;
+	linia = kzalloc(count + 1, GFP_KERNEL);
+	if (!linia)
+		return -ENOMEM;
+	if (copy_from_user(linia, ubuf, count)) {
+		kfree(linia);
+		return -EFAULT;
+	}
+	n = strcspn(linia, "\r\n");
+	linia[n] = 0;
+	if (mutex_lock_interruptible(&om_lock)) {
+		kfree(linia);
+		return -ERESTARTSYS;
+	}
+	b = om;
+	if (!b) {
+		mutex_unlock(&om_lock);
+		kfree(linia);
+		return -ENODEV;
+	}
+	/* The command result is in the RESPONSE, not in the write() exit code: the client
+	 * treats a short/failed write as a TRANSPORT error, and a rejected
+	 * command (e.g. maccontrol without the d11-ok token) is not a transport error.
+	 * Hence we consume the WHOLE buffer and return count -- also when the command
+	 * was rejected; the refusal text waits in the response buffer for `read`. */
+	om_wykonaj(b, linia);
+	mutex_unlock(&om_lock);
+	kfree(linia);
+	return (ssize_t)count;
+}
+
+static const struct file_operations om_fops = {
+	.owner = THIS_MODULE,
+	.read = om_fop_read,
+	.write = om_fop_write,
+	.llseek = noop_llseek,
+};
+
+/* ============================================================ PCI driver */
+
+static int om_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct om_bridge *b;
+	int err;
+	u32 win = 0;
+	u16 cmd = 0;
+
+	mutex_lock(&om_lock);
+	if (om) {
+		mutex_unlock(&om_lock);
+		dev_err(&pdev->dev, OM_NAZWA ": card already held by the bridge (one instance)\n");
+		return -EBUSY;
+	}
+	mutex_unlock(&om_lock);
+
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->pdev = pdev;
+	/* 16 KiB of response per command -- the fw console (~1.6 KB) and dumps must fit */
+	b->resp = kzalloc(OM_RESP_MAX, GFP_KERNEL);
+	if (!b->resp) {
+		err = -ENOMEM;
+		goto blad_alloc;
+	}
+
+	err = pci_enable_device(pdev);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_enable_device = %d\n", err);
+		goto blad_alloc;
+	}
+	err = pci_request_regions(pdev, OM_NAZWA);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_request_regions = %d\n", err);
+		goto blad_wylacz;
+	}
+	pci_set_master(pdev);
+	b->bar2_len = pci_resource_len(pdev, 2);
+	b->bar0 = pci_iomap(pdev, 0, 0);
+	b->bar2 = pci_iomap(pdev, 2, 0);
+	if (!b->bar0 || !b->bar2) {
+		dev_err(&pdev->dev, OM_NAZWA ": pci_iomap failed (bar0=%p bar2=%p)\n",
+			b->bar0, b->bar2);
+		err = -EIO;
+		goto blad_regiony;
+	}
+	if (b->bar2_len < OM_RAMSIZE) {
+		dev_err(&pdev->dev, OM_NAZWA ": BAR2 = 0x%llx B < ramsize 0x%x -- wrong card or wrong BAR\n",
+			(unsigned long long)b->bar2_len, OM_RAMSIZE);
+		err = -EINVAL;
+		goto blad_mapowanie;
+	}
+
+	/* DMA buffer for the olmsg rings: 64 KiB = the contract's msgbuf_sz (pcie.c:108;
+	 * same size in the module). The 32-bit mask matters HERE -- the fw 7.77 reads
+	 * only the low dword from the contract and builds a 64 MiB window, so the buffer must lie
+	 * < 4 GiB; we check that explicitly with the om_dma_adres_ok() gate (we do not "trust that
+	 * it works out": in the fires the module got 0x01280000, but that is not a guarantee). */
+	err = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (err)
+		dev_warn(&pdev->dev, OM_NAZWA ": dma_set_mask_and_coherent(32 bits) = %d -- continuing, the address gate will check the result anyway\n",
+			 err);
+	b->dma_va = dma_alloc_coherent(&pdev->dev, OM_DMA_ROZMIAR, &b->dma_fiz, GFP_KERNEL);
+	if (!b->dma_va) {
+		dev_err(&pdev->dev, OM_NAZWA ": dma_alloc_coherent(%u) failed\n", OM_DMA_ROZMIAR);
+		err = -ENOMEM;
+		goto blad_mapowanie;
+	}
+	b->dma_ok = om_dma_adres_ok(b->dma_fiz);
+
+	/* The invariant right after the mapping: the backplane window on PCIE2. Without it
+	 * the direct BAR0+0x20/0x24/0x48/0x4C reads (ISR, `irq`, doorbell
+	 * readback) could hit another core -- PCIE2 is visible under BAR0 only
+	 * with the window = 0x18003000 (project notes;
+	 * pcie.c brcmf_pcie_select_core does the same before every access). */
+	om_okno_restore(b);
+
+	b->misc.minor = MISC_DYNAMIC_MINOR;
+	b->misc.name = "omwifi";
+	b->misc.fops = &om_fops;
+	b->misc.mode = 0600;
+	err = misc_register(&b->misc);
+	if (err) {
+		dev_err(&pdev->dev, OM_NAZWA ": misc_register = %d\n", err);
+		goto blad_misc;
+	}
+
+	mutex_lock(&om_lock);
+	om = b;
+	mutex_unlock(&om_lock);
+	pci_set_drvdata(pdev, b);
+
+	pci_read_config_dword(pdev, OM_BAR0_WINDOW, &win);
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd);
+	dev_info(&pdev->dev, OM_NAZWA ": bridge ready: %s, BAR0=%p BAR2=%p (0x%llx B), DMA 0x%llx (%u B), window 0x80 = 0x%08x, COMMAND = 0x%04x (bus-master b2 = %u)\n",
+		 OM_DEV, b->bar0, b->bar2, (unsigned long long)b->bar2_len,
+		 (unsigned long long)b->dma_fiz, OM_DMA_ROZMIAR, win, cmd, (cmd >> 2) & 1u);
+	dev_info(&pdev->dev, OM_NAZWA ": the DMA buffer passes the fw 7.77 gate (<4 GiB and the 64 MiB window): %s\n",
+		 b->dma_ok ? "YES" : "NO");
+	if (!b->dma_ok)
+		dev_emerg(&pdev->dev, OM_NAZWA ": NOTE the DMA address 0x%llx does NOT pass the gate -- `contract` will skip the msgbufaddr fields, and `ringinit`/`send`/`sendtrio` will REFUSE\n",
+			  (unsigned long long)b->dma_fiz);
+	dev_info(&pdev->dev, OM_NAZWA ": startup sequence: echo \"reset\" > %s; echo \"zero\" > %s; echo \"loadfw <image>\" > %s; echo \"contract\" > %s; echo \"vars <vars>\" > %s; echo \"ringinit\" > %s; echo \"release\" > %s; echo \"gate\" > %s; echo \"irq on\" > %s; echo \"sendtrio\" > %s\n",
+		 OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV, OM_DEV);
+	return 0;
+
+blad_misc:
+	dma_free_coherent(&pdev->dev, OM_DMA_ROZMIAR, b->dma_va, b->dma_fiz);
+blad_mapowanie:
+	if (b->bar0)
+		pci_iounmap(pdev, b->bar0);
+	if (b->bar2)
+		pci_iounmap(pdev, b->bar2);
+blad_regiony:
+	pci_release_regions(pdev);
+blad_wylacz:
+	pci_disable_device(pdev);
+blad_alloc:
+	kfree(b->resp);
+	kfree(b);
+	return err;
+}
+
+static void om_remove(struct pci_dev *pdev)
+{
+	struct om_bridge *b = pci_get_drvdata(pdev);
+
+	if (!b)
+		return;
+	mutex_lock(&om_lock);
+	om = NULL;
+	mutex_unlock(&om_lock);
+	if (b->irq_on) {
+		free_irq(pdev->irq, b);
+		b->irq_on = false;
+	}
+	if (b->msi_on)
+		pci_disable_msi(pdev);
+	misc_deregister(&b->misc);
+	om_okno_restore(b);
+	if (b->dma_va)
+		dma_free_coherent(&pdev->dev, OM_DMA_ROZMIAR, b->dma_va, b->dma_fiz);
+	if (b->bar0)
+		pci_iounmap(pdev, b->bar0);
+	if (b->bar2)
+		pci_iounmap(pdev, b->bar2);
+	pci_release_regions(pdev);
+	pci_disable_device(pdev);
+	pci_set_drvdata(pdev, NULL);
+	kfree(b->resp);
+	kfree(b);
+}
+
+static const struct pci_device_id om_id_tabela[] = {
+	{ PCI_DEVICE(OM_VENDOR, OM_DEVICE_4360) },
+	{ 0, }
+};
+MODULE_DEVICE_TABLE(pci, om_id_tabela);
+
+static struct pci_driver om_driver = {
+	.name = OM_NAZWA,
+	.id_table = om_id_tabela,
+	.probe = om_probe,
+	.remove = om_remove,
+};
+
+/* ============================================================== init / exit */
+
+/* A check BEFORE registering the driver: whether the card is not already bound
+ * to another driver (requirement 2). If it were (e.g. brcmfmac), probe() would never
+ * run, and the module would "load silently" and do nothing --
+ * hence we REFUSE explicitly, with the driver name and a ready command. */
+static int om_sprawdz_zajetosc(void)
+{
+	struct pci_dev *pdev;
+	int err = 0;
+
+	pdev = pci_get_device(OM_VENDOR, OM_DEVICE_4360, NULL);
+	if (!pdev) {
+		pr_err(OM_NAZWA ": REFUSAL: no card %04x:%04x on PCI -- nothing to take over\n",
+		       OM_VENDOR, OM_DEVICE_4360);
+		return -ENODEV;
+	}
+	if (pdev->dev.driver) {
+		pr_err(OM_NAZWA ": REFUSAL: the card %s is already bound to the driver `%s` -- wait/unbind it (project rulebook item 5: after a fire rmmod is forbidden => REBOOT), then load the bridge\n",
+		       pci_name(pdev), pdev->dev.driver->name);
+		err = -EBUSY;
+	} else {
+		pr_info(OM_NAZWA ": card %s is free (no driver) -- the bridge can take it over\n",
+			pci_name(pdev));
+	}
+	pci_dev_put(pdev);
+	return err;
+}
+
+static int __init om_init(void)
+{
+	int err;
+
+	pr_info(OM_NAZWA ": initializing (d11_ok=%u; the D11 page 0x%08x available %s)\n",
+		d11_ok ? 1 : 0, OM_D11_BASE,
+		d11_ok ? "ONLY the maccontrol command with the d11-ok token" : "NEVER (d11_ok=0)");
+
+	/* Requirement 2: without pci_reset_function() the bridge CANNOT work (the whole cycle
+	 * without a reboot stands on SBR -- project notes). The symbol
+	 * is EXPORT_SYMBOL_GPL (drivers/pci/pci.c:5202, declaration
+	 * include/linux/pci.h:1473), it is behind no CONFIG_* and the module just
+	 * CALLS it -- in a kernel without it insmod ends in an unresolved symbol
+	 * (loudly), not silently. This condition is an additional, explicit
+	 * check of the same thing before any touch of the card. */
+	if (!IS_ENABLED(CONFIG_PCI)) {
+		pr_err(OM_NAZWA ": REFUSAL: kernel without CONFIG_PCI -- no pci_reset_function and no BARs\n");
+		return -ENODEV;
+	}
+	if (!om_reset_fn) {
+		pr_err(OM_NAZWA ": REFUSAL: no pci_reset_function in this kernel -- the bridge has nothing to do SBR with\n");
+		return -ENODEV;
+	}
+
+	err = om_sprawdz_zajetosc();
+	if (err)
+		return err;
+
+	err = pci_register_driver(&om_driver);
+	if (err) {
+		pr_err(OM_NAZWA ": pci_register_driver = %d\n", err);
+		return err;
+	}
+	pr_info(OM_NAZWA ": driver registered; %s will appear after the bridge takes over the card\n",
+		OM_DEV);
+	return 0;
+}
+
+static void __exit om_exit(void)
+{
+	pci_unregister_driver(&om_driver);
+	pr_info(OM_NAZWA ": bridge removed (project rule: no rmmod after a fire -- project rulebook item 5; TCM is not cleared by a reboot)\n");
+}
+
+module_init(om_init);
+module_exit(om_exit);
+
