+
+static void om_cmd_read_contract(struct om_bridge *b)
+{
+	u32 i;
+	u32 hb = 0, fl = 0, rec = 0, me = 0;
+
+	om_odp(b, "read contract: kontrakt @0x%05x (TCM_end - 0x5F80)\n", OM_KONTRAKT);
+	for (i = 0; i < 0x40; i += 16) {
+		u32 v0 = 0, v1 = 0, v2 = 0, v3 = 0;
+
+		(void)om_tcm_read32(b, OM_KONTRAKT + i + 0, &v0);
+		(void)om_tcm_read32(b, OM_KONTRAKT + i + 4, &v1);
+		(void)om_tcm_read32(b, OM_KONTRAKT + i + 8, &v2);
+		(void)om_tcm_read32(b, OM_KONTRAKT + i + 12, &v3);
+		om_odp(b, "  +0x%03x: %08x %08x %08x %08x\n", i, v0, v1, v2, v3);
+	}
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_REC, &rec);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_MARKER_END, &me);
+	om_odp(b, "  +0x5028 heartbeat=0x%08x  +0x502c trap_flag=0x%08x  +0x5ed8 rec[0]=0x%08x  +0x5f5c marker_end=0x%08x\n",
+	       hb, fl, rec, me);
+}
+
+static void om_cmd_read_console(struct om_bridge *b, u32 max)
+{
+	u32 ptr, buf, size, wr, n, start, i;
+	char txt[129];
+	u32 w_linii = 0;
+
+	if (om_konsola(b, &ptr, &buf, &size, &wr) != 0) {
+		om_odp(b, "read console: brak struktury konsoli (kontrakt+0x10 niepublikowane albo niespojne) -- fw jej nie zrobil\n");
+		return;
+	}
+	n = (wr > size) ? size : wr;
+	start = (max && n > max) ? n - max : 0;
+	om_odp(b, "read console: ptr=0x%05x buf=0x%05x size=%u wr_idx=%u; %s [%u..%u)\n",
+	       ptr, buf, size, wr, start ? "OGON" : "CALOSC", start, n);
+	memset(txt, 0, sizeof(txt));
+	for (i = start; i < n && w_linii < OM_KONSOLA_LINII; i++) {
+		u8 c = ioread8(b->bar2 + buf + i);
+		u32 poz = i - start;
+
+		txt[poz % 128] = ((c >= 32 && c < 127) || c == '\n' || c == '\t') ? (char)c : '.';
+		if (poz % 128 == 127 || i + 1 == n) {
+			txt[(poz % 128) + 1] = 0;
+			om_odp(b, "  |%s\n", txt);
+			memset(txt, 0, sizeof(txt));
+			w_linii++;
+		}
+	}
+	if (n == 0)
+		om_odp(b, "read console: konsola pusta (wr_idx = 0)\n");
+	if (w_linii >= OM_KONSOLA_LINII)
+		om_odp(b, "read console: ... uciete na %u liniach (limit odpowiedzi; reszta tylko w dmesg)\n", OM_KONSOLA_LINII);
+}
+
+static void om_cmd_read_rings(struct om_bridge *b)
+{
+	if (!b->dma_va) {
+		om_blad(b, "read rings: brak bufora DMA\n");
+		return;
+	}
+	om_odp(b, "read rings (bufor DMA 0x%llx, RAM hosta -- zero MMIO):\n",
+	       (unsigned long long)b->dma_fiz);
+	om_odp(b, "  H2D: data_off=0x%04x size=0x%04x rd=%u wr=%u\n",
+	       om_buf_rd32(b, OM_RING_HDR_H2D + 0x0), om_buf_rd32(b, OM_RING_HDR_H2D + 0x4),
+	       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_RD),
+	       om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR));
+	om_odp(b, "  D2H: data_off=0x%04x size=0x%04x rd=%u wr=%u\n",
+	       om_buf_rd32(b, OM_RING_HDR_D2H + 0x0), om_buf_rd32(b, OM_RING_HDR_D2H + 0x4),
+	       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD),
+	       om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR));
+	/* Werdykt LICZONY z odczytanych wartosci. Poprzednia wersja drukowala
+	 * zdanie na sztywno ("rd H2D == 66 i D2H wr == 0 => fw SZKONSUMOWAL trio"),
+	 * wiec przy rd=0 i wr=288740 (bieg 11.09) klamala w kierunku "wszystko OK",
+	 * a lezala w logs/ jako dowod. */
+	{
+		u32 rd_h2d = om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_RD);
+		u32 wr_d2h = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR);
+
+		om_odp(b, "  werdykt: H2D rd=%u (%s); D2H wr=%u (%s)\n", rd_h2d,
+		       (rd_h2d == OM_TRIO_WR) ? "== 66: fw zuzyl cale trio" :
+		       (rd_h2d ? "!= 66: zuzycie inne niz zakladamy (66)" :
+				 "== 0: fw NIE opublikowal zuzycia -- brak dowodu na konsumpcje"),
+		       wr_d2h, wr_d2h ? "!= 0: fw COS opublikowal -- patrz `read d2h`" :
+					"== 0: D2H pusty");
+	}
+}
+
+static void om_cmd_read_heartbeat(struct om_bridge *b)
+{
+	u32 hb = 0, fl = 0;
+
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	om_odp(b, "read heartbeat: kontrakt+0x%04x = 0x%08x (bramka gotowosci fw)\n",
+	       OM_K_HEARTBEAT, hb);
+	om_odp(b, "read heartbeat: kontrakt+0x%04x trap_flag = 0x%08x\n", OM_K_TRAP_FLAG, fl);
+}
+
+static void om_cmd_read_trap(struct om_bridge *b)
+{
+	u32 flag = 0, i;
+
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &flag);
+	om_odp(b, "read trap: trap_flag = 0x%08x %s\n", flag,
+	       flag == OM_TRAP_FLAG_VAL ? "<= FW W TRAPIE (0xDEADBEEF)" :
+	       (flag ? "<= niezerowe (dowod, nie tylko 0xDEADBEEF)" : ""));
+	om_odp(b, "read trap: rekord %u B @kontrakt+0x%04x, po 8 dwordow w linii\n",
+	       OM_K_TRAP_REC_BAJTY, OM_K_TRAP_REC);
+	for (i = 0; i < OM_K_TRAP_REC_BAJTY; i += 32) {
+		u32 v[8];
+		u32 j;
+
+		for (j = 0; j < 8; j++)
+			(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_REC + i + j * 4, &v[j]);
+		om_odp(b, "  +0x%04x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+		       OM_K_TRAP_REC + i, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+	}
+}
+
+/* Odczyt TCM (BAR2 = RAM fw). To pamiec, nie rejestry -- nie ma tu zadnej
+ * sciezki do D11 (strona 0x18001000 zyje w backplane, nie w BAR2). */
+static void om_cmd_read_tcm(struct om_bridge *b, u32 adr, u32 len)
+{
+	u32 off;
+
+	if (!len || len > 256) {
+		om_blad(b, "read tcm: dlugosc 1..256 B (podano %u)\n", len);
+		return;
+	}
+	if (adr >= OM_RAMSIZE || adr + len > OM_RAMSIZE) {
+		om_blad(b, "read tcm: zakres 0x%05x+%u poza ramsize 0x%05x\n", adr, len, OM_RAMSIZE);
+		return;
+	}
+	om_odp(b, "read tcm: TCM[0x%05x..0x%05x) (BAR2 = RAM fw, zero MMIO rejestrow)\n",
+	       adr, adr + len);
+	for (off = adr; off < adr + len; off += 16) {
+		u32 v0 = 0, v1 = 0, v2 = 0, v3 = 0;
+
+		(void)om_tcm_read32(b, off, &v0);
+		if (off + 4 < adr + len)
+			(void)om_tcm_read32(b, off + 4, &v1);
+		if (off + 8 < adr + len)
+			(void)om_tcm_read32(b, off + 8, &v2);
+		if (off + 12 < adr + len)
+			(void)om_tcm_read32(b, off + 12, &v3);
+		om_odp(b, "  +0x%05x: %08x %08x %08x %08x\n", off, v0, v1, v2, v3);
+	}
+}
+
+static void om_cmd_read(struct om_bridge *b, int argc, char **argv)
+{
+	u32 v1 = 0, v2 = 0;
+
+	if (argc < 2) {
+		om_blad(b, "read: uzycie `read contract|console|rings|heartbeat|trap|tcm <adr_hex> <len_hex>`\n");
+		return;
+	}
+	if (!strcmp(argv[1], "contract")) {
+		om_cmd_read_contract(b);
+	} else if (!strcmp(argv[1], "console")) {
+		if (argc >= 3 && kstrtouint(argv[2], 0, &v1) == 0)
+			om_cmd_read_console(b, v1);
+		else
+			om_cmd_read_console(b, 0);
+	} else if (!strcmp(argv[1], "rings")) {
+		om_cmd_read_rings(b);
+	} else if (!strcmp(argv[1], "heartbeat")) {
+		om_cmd_read_heartbeat(b);
+	} else if (!strcmp(argv[1], "trap")) {
+		om_cmd_read_trap(b);
+	} else if (!strcmp(argv[1], "tcm")) {
+		if (argc < 4 || kstrtouint(argv[2], 0, &v1) || kstrtouint(argv[3], 0, &v2)) {
+			om_blad(b, "read tcm: uzycie `read tcm <adr_hex> <len_hex>` (len 1..256)\n");
+			return;
+		}
+		om_cmd_read_tcm(b, v1, v2);
+	} else {
+		om_blad(b, "read: nieznany podkomendant `%s` (contract|console|rings|heartbeat|trap|tcm)\n",
+			argv[1]);
+	}
+}
+
+/* Zrzut zawartosci pierscienia D2H (RAM hosta, ZERO MMIO) -- komenda
+ * diagnostyczna: czyta to samo, co om_d2h_scan, ale NIE przesuwa rd, wiec
+ * dane nie przepadaja przy powtorzeniu komendy. */
+static void om_op_d2h(struct om_bridge *b, int argc, char **argv)
+{
+	u32 rd, wr, n, off;
+	u32 wiadomosci = 0;
+
+	if (!b->dma_va) {
+		om_blad(b, "d2h: brak bufora DMA\n");
+		return;
+	}
+	rd = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD);
+	wr = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR);
+	om_odp(b, "d2h: pierscien D2H rd=%u wr=%u (odczyt RAM hosta, zero MMIO; rd NIE przesuwam)\n",
+	       rd, wr);
+	if (!wr || wr > OM_RING_ROZMIAR) {
+		om_odp(b, "d2h: pusty -- fw nic nie zapisal (kanal H2D->fw jest jednokierunkowy; jedyny znany D2H to TRAP_IND)\n");
+		return;
+	}
+	n = (wr >= rd) ? (wr - rd) : (OM_RING_ROZMIAR - rd + wr);
+	for (off = 0; off + OM_OLMSG_HDR <= n && wiadomosci < 32; ) {
+		u32 typ = om_buf_rd32(b, OM_RING_DATA_D2H + off);
+		u32 seq = om_buf_rd32(b, OM_RING_DATA_D2H + off + 4);
+		u32 len = om_buf_rd32(b, OM_RING_DATA_D2H + off + 8);
+
+		if (off + OM_OLMSG_HDR + len > OM_RING_ROZMIAR) {
+			om_blad(b, "d2h: naglowek @+0x%04x niespojny (len %u) -- przerywam\n",
+				OM_RING_DATA_D2H + off, len);
+			break;
+		}
+		om_odp(b, "d2h: #%u @buf+0x%04x type=0x%08x seq=%u len=%u\n",
+		       wiadomosci, OM_RING_DATA_D2H + off, typ, seq, len);
+		if (len) {
+			u32 v[4] = { 0, 0, 0, 0 };
+			u32 nn = (len > 16) ? 16 : len;
+			u32 i;
+
+			for (i = 0; i + 4 <= nn; i += 4)
+				v[i / 4] = om_buf_rd32(b, OM_RING_DATA_D2H + off + OM_OLMSG_HDR + i);
+			om_odp(b, "d2h:    payload[0..%u): %08x %08x %08x %08x%s\n",
+			       nn, v[0], v[1], v[2], v[3], len > 16 ? " ..." : "");
+		}
+		off += OM_OLMSG_HDR + len;
+		wiadomosci++;
+	}
+	if (!wiadomosci)
+		om_odp(b, "d2h: pierscien deklaruje wr=%u, ale zadnego naglowka nie udalo sie rozpoznac\n", wr);
+}
