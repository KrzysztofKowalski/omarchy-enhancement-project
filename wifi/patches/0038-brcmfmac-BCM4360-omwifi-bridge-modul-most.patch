+/* ======================================================== identyfikacja karty */
+
+#define OM_VENDOR		0x14e4u	/* Broadcom (PCI_VENDOR_ID_BROADCOM) */
+#define OM_DEVICE_4360		0x43a0u	/* BRCM_PCIE_4360_DEVICE_ID, brcm_hw_ids.h:87 */
+#define OM_NAZWA		"omwifi_bridge"
+#define OM_DEV			"/dev/omwifi"
+
+/* BAR-y (logi fire'ow: resource0 = 0x8000, resource2 = 0x200000) */
+#define OM_BAR0_ROZMIAR		0x8000u		/* 32 KiB: rejestry PCIE2 + okno */
+#define OM_BAR2_ROZMIAR		0x200000u	/* 2 MiB: okno na RAM fw (TCM) */
+#define OM_BAR0_WINDOW		0x80u		/* config: okno backplane (pcie.c:674) */
+#define OM_BAR0_REG_SIZE	0x1000u		/* strona okna (pcie.c:675) */
+
+/* ============================================================== mapa rdzeni
+ *
+ * WZORZEC: ten sam co w minihost.c:16-21 -- stale z logow fire'a, nie z DMP.
+ * Zrodlo: logs/test.345.journalctl.txt:14-19 (`cores_check`). Modul NIE parsuje
+ * DMP (to ~1000 linii chip.c i kolejne zrodlo bledu); rozpoznaje karte po ID
+ * (14e4:43a0) i WERYFIKUJE chipid/chiprev odczytem z ChipCommon
+ * (0x18000000 + 0x0) -- ta sama metoda co brcmf_chip_recognition()
+ * (chip.c:990-1000), adres bazowy SI_ENUM_BASE_DEFAULT = 0x18000000
+ * (include/soc.h:9), pola chipid: CID_ID_MASK 0xffff / CID_REV_MASK 0xf0000
+ * (include/chipcommon.h:222-224). Oczekiwane 0x4360 / 3 (chiprev 3 --
+ * notes/).
+ */
+#define OM_CC_BASE		0x18000000u	/* ChipCommon (0x800) */
+#define OM_CC_WRAP		0x18100000u
+#define OM_D11_BASE		0x18001000u	/* 802.11 (0x812) -- STRONA ZAKAZANA */
+#define OM_D11_WRAP		0x18101000u
+#define OM_ARM_BASE		0x18002000u	/* ARM CR4 (0x83e) */
+#define OM_ARM_WRAP		0x18102000u
+#define OM_PCIE2_BASE		0x18003000u	/* PCIE2 (0x83c) */
+#define OM_PCIE2_WRAP		0x18103000u
+#define OM_SOCRAM_BASE		0x18004000u	/* INTERNAL_MEM / SOCRAM (0x81a) */
+#define OM_SOCRAM_WRAP		0x18104000u
+#define OM_PAGE_MASK		(~0xfffu)
+
+#define OM_CHIPID_4360		0x4360u
+#define OM_CHIPREV_4360		3u
+
+/* ============================================================ TCM / kontrakt
+ *
+ * rambase = 0, ramsize = 0xA0000 (chip.c, BRCM_CC_4360). Kontrakt OL lezy pod
+ * TCM_end - 0x5F80 = 0x9A080 (pcie.c:161, :940; notes/re-apple-host-etap1-2-
+ * przod.md par.1). Offsety pol: pcie.c:162-176 (BCM4360_T336_*).
+ */
+#define OM_RAMBASE		0x0u
+#define OM_RAMSIZE		0xa0000u			/* 640 KiB */
+#define OM_KONTRAKT		(OM_RAMSIZE - 0x5f80u)		/* 0x9A080 */
+#define OM_K_MSGBUFADDR_LO	0x0004u
+#define OM_K_MSGBUFADDR_HI	0x0008u
+#define OM_K_MSGBUF_SZ		0x000cu
+#define OM_K_CONSOLE_PTR	0x0010u		/* si[+0x010] -- publikuje FW */
+#define OM_K_FLAG0		0x0014u		/* semafor Petersona: NIGDY 1 */
+#define OM_K_FLAG1		0x0018u
+#define OM_K_TURN		0x001cu
+#define OM_K_VARS_SIZE		0x0020u
+#define OM_K_VARS		0x0024u
+#define OM_K_HEARTBEAT		0x5028u		/* bramka gotowosci fw */
+#define OM_K_TRAP_FLAG		0x502cu
+#define OM_K_TRAP_REC		0x5ed8u
+#define OM_K_TRAP_REC_BAJTY	132u		/* 0x84 = 33 dwordy (pcie.c:175) */
+#define OM_K_MARKER_END		0x5f5cu
+
+#define OM_MARKER_BEGIN_VAL	0xa5a5a5a5u
+#define OM_MARKER_END_VAL	0x5a5a5a5au
+#define OM_TRAP_FLAG_VAL	0xdeadbeefu
+#define OM_MSGBUF_SZ		0x10000u	/* 64 KiB (pcie.c:108) */
+#define OM_VARS_MAX		0x4000u		/* MAXSZ_NVRAM_VARS */
+#define OM_OBRAZ_ROZMIAR_777	451362u		/* obraz 7.77.0.0 = 0x6E322 (md5 e942afb0...) */
+#define OM_ZERO_OD_777		0x6e322u	/* poczatek zerowania (koniec obrazu) */
+#define OM_ZERO_DO_777		OM_KONTRAKT	/* == 0x9a080; 179550 B */
+
+/* rejestry wrappera (include/linux/bcma/bcma_regs.h:29-43) */
+#define OM_BCMA_IOCTL		0x0408u
+#define OM_BCMA_IOCTL_CLK	0x0001u
+#define OM_BCMA_IOCTL_FGC	0x0002u
+#define OM_BCMA_RESET_CTL	0x0800u
+#define OM_BCMA_RESET_CTL_RESET	0x0001u
+#define OM_BCMA_RESET_ST	0x0804u
+#define OM_BCMA_CLKCTLST	0x01e0u
+#define OM_BCMA_IOCTL_PHYCLOCKEN 0x0004u	/* D11_BCMA_IOCTL_PHYCLOCKEN (chip.c:81) */
+#define OM_BCMA_IOCTL_PHYRESET	0x0008u		/* D11_BCMA_IOCTL_PHYRESET   (chip.c:82) */
+#define OM_ARMCR4_IOCTL_CPUHALT	0x0020u		/* chip.c ARMCR4_BCMA_IOCTL_CPUHALT */
+
+/* rejestry PCIE2 widziane w BAR0 (pcie.c:690-692; sbpcieregs intstatus 0x20,
+ * intmask 0x24 -- notes/ par.2) */
+#define OM_R_INTSTATUS		0x20u
+#define OM_R_INTMASK		0x24u
+#define OM_R_MAILBOXINT		0x48u
+#define OM_R_MAILBOXMASK	0x4cu
+#define OM_R_CLKCTLST		0x1e0u
+#define OM_INT_D2H		0x00000100u	/* bit 8: D2H doorbell (pcie.c:398) */
+#define OM_INT_MASK		0x00000100u	/* maska D2H re-arm (pcie.c:402) */
+#define OM_DB_H2D		0x00000001u	/* bit 0: H2D doorbell (pcie.c:393) */
+
+/* D11 maccontrol (notes/:53; test.342) */
+#define OM_D11_MACCONTROL_OFF	0x120u
+#define OM_D11_MACCONTROL_SEED	0x04000400u
+
+/* ============================================== hardening PCIe (config space)
+ *
+ * ASPM-off + Completion Timeout, 1:1 ze skryptami projektu:
+ *   scripts/minihost.sh:167-180  (cztery zapisy + readback wszystkich czterech
+ *                                 + sciezka awaryjna "REBOOT + setpci z czystego boota")
+ *   scripts/fire-extended-noreboot.sh:128-136 (te same cztery wartosci, BDF mostka 00:1c.2)
+ * ZNACZENIE: 0x50/0xbc to LnkCtl (bity 0-1 = ASPM; w kazdej z tych wartosci
+ * ZEROWANE => ASPM off -- notes/:279), a 0x68/0xd4 to
+ * DevCtl2 (programowanie Completion Timeout -- notes/:67-68,
+ * `PCI_EXP_DEVCTL2_COMP_TIMEOUT`, include/uapi/linux/pci_regs.h).
+ * Offsety sa SUROWE, bo zaleza od bazy capability PCIe tego konkretnego ukladu
+ * (mostek: 0x50/0x68, endpoint: 0xbc/0xd4 -- to sa wartosci z dzialajacych
+ * skryptow, nie wyliczenia).
+ *
+ * PO CO TO W MOUSTU: CLAUDE.md p.5 -- hardening GINIE Z REBOOTEM, dlatego
+ * skrypty nakladaja go przed KAZDYM firem. W moscie odpowiednikiem "kazdego
+ * fire" jest KAZDE `reset`: SBR przywraca domyslne Device Control endpointu,
+ * wiec hardening trzeba nalozyc PO SBR -- i `reset` robi to sam (kolejnosc
+ * jak w minihost.sh: SBR -> hardening -> re-init mapowan/okna/rdzeni).
+ * Bez tego user po `reset` siedzialby w konfiguracji, w ktorej zaden
+ * dotychczasowy fire nie chodzil. */
+#define OM_HARD_MOSTEK_LNKCTL	0x50u
+#define OM_HARD_MOSTEK_LNKCTL_V	0x0c40u
+#define OM_HARD_MOSTEK_DEVCTL2	0x68u
+#define OM_HARD_MOSTEK_DEVCTL2_V	0x040bu
+#define OM_HARD_EP_LNKCTL	0xbcu
+#define OM_HARD_EP_LNKCTL_V	0x0140u
+#define OM_HARD_EP_DEVCTL2	0xd4u
+#define OM_HARD_EP_DEVCTL2_V	0x040bu
+
+/* ====================================================== pierscien olmsg (DMA)
+ *
+ * Geometria 1:1 z minihost.c:176-184 i pcie.c:368-375, rownowazna z
+ * `bcm_olmsg_init` @0x4f38 w obrazie 7.77: kanal H2D = buf+0x00, kanal D2H =
+ * buf+0x10, naglowek kanalu {data_off, size, rd, wr}, komunikat
+ * {type, seq, len} + payload, total = len + 12.
+ * UWAGA (notes/ par.4.2): total > 0x400 => fw
+ * zapetla sie na tej samej wiadomosci w ISR (spam konsoli) -- dlatego limit.
+ */
+#define OM_DMA_ROZMIAR		0x10000u	/* 64 KiB = msgbuf_sz kontraktu */
+#define OM_RING_HDR_H2D		0x00u
+#define OM_RING_HDR_D2H		0x10u
+#define OM_RING_DATA_H2D	0x20u
+#define OM_RING_DATA_D2H	0x7820u
+#define OM_RING_H2D_RD		0x08u		/* pisze FW (zuzycie) */
+#define OM_RING_H2D_WR		0x0cu		/* pisze HOST (publikacja) */
+/* UWAGA -- naprawione 11.09.2026 (pomiar surowego bufora: `kread phys 0x1280000 0x40`).
+ * Te dwa offsety musza byc WZGLEDNE wobec OM_RING_HDR_D2H (0x10) -- tak samo, jak para
+ * H2D wyzej jest wzgledna wobec 0x00 -- bo KAZDE uzycie w tym pliku ma postac
+ * `OM_RING_HDR_D2H + OM_RING_D2H_RD/WR`. W pierwszej wersji byly BEZWZGLEDNE
+ * (0x18/0x1c) i baza byla dodawana drugi raz: kod czytal 0x28/0x2c, czyli pole
+ * "len" i "payload" NASZEGO komunikatu 0x42 w pierscieniu H2D. Skutki:
+ *  (a) `read rings`/`read d2h`/`status` klamaly ("D2H rd=4 wr=288740"), bo braly
+ *      cudze bajty -- i stad wziela sie falszywa teza "to fw zapisal 288740";
+ *  (b) `om_d2h_scan` (ISR!) zapisywalby `rd` pod 0x28, czyli NADPISALBY dlugosc
+ *      komunikatu #1 w H2D -- realne uszkodzenie wlasnej publikacji, gdy fw zyje.
+ * Pomiar (11.09, po biegu): prawdziwe D2H to rd=0, wr=12, a pod 0x7820 lezy
+ * {type=0x41, seq=0, len=0} = BCM_OL_TRAP_IND -- dokladnie to, co fw ogloszyl
+ * w konsoli ("Offload Message: Type: BCM_OL_TRAP_IND Seq:0 len:0"). */
+#define OM_RING_D2H_RD		0x08u		/* pisze HOST (wzgledem OM_RING_HDR_D2H) */
+#define OM_RING_D2H_WR		0x0cu		/* pisze FW   (wzgledem OM_RING_HDR_D2H) */
+#define OM_RING_ROZMIAR		0x7800u
+#define OM_OLMSG_HDR		12u		/* {type, seq, len} po 4 B */
+
+/* Trio startowe Apple (notes/ par.4 i par.6;
+ * minihost.c:193-204): 0x42 + 0x45 + 0x38, publikowany `wr` = 16+16+34 = 66.
+ * KOREKTA z 11.09: `wr` to 66, NIE 50 (przy 50 fw czytalby uciety trzeci
+ * komunikat: z 34 B zostaloby 18). */
+#define OM_TRIO_WR		66u
+#define OM_TRIO_TYP_TS		0x00000042u	/* BCM_OL_SYNC_HOST_TIMESTAMP */
+#define OM_TRIO_TYP_EWT		0x00000045u	/* BCM_OL_EXCESS_WAKE_TIMEOUT */
+#define OM_TRIO_TYP_LTR		0x00000038u	/* BCM_OL_LTR */
+#define OM_TRIO_TS_LEN		4u
+#define OM_TRIO_EWT_LEN		4u
+#define OM_TRIO_LTR_LEN		0x16u		/* 22 B */
+#define OM_TRIO_EWT_VAL		30u		/* iovar wowl_excess_wake_timeout */
+
+/* Bramka gotowosci: Apple polluje kontrakt+0x5028 2000 x 1 ms i po timeoucie
+ * tylko loguje (brak galezi bledu) -- i my tak robimy (notes/
+ * luka2-4-kontrakt-i-bramka.md par.2.1; minihost.c:206-210). */
+#define OM_GATE_ITERACJE	2000u
+#define OM_OLMSG_MAX_TOTAL	0x400u		/* limit fw na komunikat (pcie.c:435) */
+
+/* Doczekanie linii `pciedngl_open called` w konsoli fw przed doorbellem
+ * (notes/ par.6 p. 5): fw czyta pierscien
+ * WYLACZNIE w ISR, a pciedngl_open (fw 0x387c: `bus+0x24 |= 0x100`) to moment
+ * uzbrojenia przerwania -- doorbell przed nim moze zostac zatrzasniety
+ * i nieobsluzony. Pomiar: linia pojawia sie ~0,052 s czasu fw. */
+#define OM_KONSOLA_LINIA	"pciedngl_open called"
+#define OM_KONSOLA_CZEKAJ_MS	2000u
+
+/* limit odpowiedzi /dev/omwifi -- konsola fw to ~1,6 KB, zrzut D2H <= 3000 B,
+ * `read tcm` <= 256 B; 16 KiB daje zapas bez ryzyka dla pamieci jadra */
+#define OM_RESP_MAX		16384u
+#define OM_RESP_ZAPAS		96u		/* rezerwa na linie-markier uciecia */
+#define OM_LINIA_MAX		4096u		/* max dlugosc komendy z userspace */
+#define OM_LOG_MAX		512u		/* dlugosc jednej linii logu */
+#define OM_KONSOLA_LINII	100u		/* ile linii konsoli maksymalnie w odpowiedzi */
+
+/* ====================================================================== stan */
+
+struct om_bridge {
+	struct pci_dev		*pdev;
+	void __iomem		*bar0;		/* resource0: PCIE2 + okno backplane */
+	void __iomem		*bar2;		/* resource2: RAM fw (TCM) */
+	resource_size_t		bar2_len;
+
+	void			*dma_va;	/* 64 KiB, dma_alloc_coherent */
+	dma_addr_t		dma_fiz;
+	bool			dma_ok;		/* czy adres przeszedl bramke fw */
+
+	u32			rstvec;		/* pierwszy dword obrazu (loadfw) */
+	bool			rstvec_znamy;
+	bool			arm_wypuszczony;
+	bool			irq_on;
+	bool			msi_on;
+	bool			hardening_bylo;	/* czy hardening byl nakladany w tej sesji */
+	bool			hardening_ok;	/* czy ostatni hardening przeszedl readback */
+	bool			odmowa_d11_log;	/* jedna linia odmowy na komende */
+	bool			okno_mask_log;	/* jedna linia o maskowaniu IRQ na obce okno */
+
+	char			*resp;		/* bufor odpowiedzi */
+	size_t			resp_len;
+	size_t			resp_pos;
+	bool			resp_uciete;	/* czy odpowiedz dotknela limitu (jedna linia-markier) */
+
+	struct miscdevice	misc;
+};
+
+static struct om_bridge *om;			/* jeden egzemplarz karty */
+static DEFINE_MUTEX(om_lock);			/* chroni `om` i cala sekwencje */
+
+/* Wymaganie 2: most NIE MOZE dzialac bez pci_reset_function (caly cykl bez
+ * rebootu stoi na SBR), wiec SYMBOL jest wymuszony przez wskaznik:
+ *  (a) modul ZAWSZE go referuje => kernel bez tego symbolu NIE ZALADUJE modulu
+ *      (insmod: unresolved symbol) -- to jest wlasciwa, glosna bramka,
+ *  (b) test `!om_reset_fn` wykonuje sie przy kazdym wywolaniu i NIE znika
+ *      w optymalizacji, a przy tym nie generuje -Waddress (bezposrednie
+ *      `!pci_reset_function` gcc redukuje do stalej i OSTRZEGA -- bramka builda
+ *      wymaga zera ostrzezen). */
+static int (*const om_reset_fn)(struct pci_dev *) = pci_reset_function;
+
+/* parametr modulu: JEDYNA nowa opcja (wymaganie 5) -- polowa podwojnej bramki D11 */
+static bool d11_ok;
+module_param(d11_ok, bool, 0644);
+MODULE_PARM_DESC(d11_ok,
+	"omwifi_bridge: dopuszcza JEDEN dostep do strony rdzenia D11 0x18001000 (seed maccontrol 0x18001120). HARD RULE CLAUDE.md p.7 (fire #21 = zwis maszyny): bez tego parametru ORAZ bez tokenu `d11-ok` w samej komendzie maccontrol modul ODMOWUJE przed jakimkolwiek MMIO. (1=dopusc, 0=odmawiaj (domyslnie))");
+
+/* ============================================================== log/odpowiedz
+ *
+ * Kazda linia idzie JEDNOCZESNIE do logu jadra (z prefiksem omwifi_bridge:)
+ * i do bufora czytanego przez `cat /dev/omwifi`. Tresc jest ta sama -- raport
+ * z fire'a i odpowiedz na komende to ten sam tekst (bez prefiksu w odpowiedzi).
+ * Kolejne poziomy: 0 = pr_info (normalny krok), 1 = pr_err (blad/odmowa),
+ * 2 = pr_emerg (linia PRZED operacja na sprzecie -- ostatnia, jezeli operacja
+ * zamrozi maszyne; konwencja z pcie.c test.3xx).
+ */
+
+static void om_linia(struct om_bridge *b, int poziom, const char *fmt, ...)
+	__attribute__((format(printf, 3, 4)));
+
+static void om_linia(struct om_bridge *b, int poziom, const char *fmt, ...)
+{
+	char tmp[OM_LOG_MAX];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vscnprintf(tmp, sizeof(tmp), fmt, ap);
+	va_end(ap);
+
+	/* Zapas OM_RESP_ZAPAS trzymamy na JEDNA linie-markier uciecia: klient
+	 * userspace musi wiedziec, ze odpowiedz jest niepelna (kontrakt:
+	 * kazda komenda cos odpowiada, a odpowiedz konczy sie \n). */
+	if (b && b->resp && b->resp_len + (size_t)n <= OM_RESP_MAX - OM_RESP_ZAPAS) {
+		memcpy(b->resp + b->resp_len, tmp, n);
+		b->resp_len += n;
+	} else if (b && b->resp && !b->resp_uciete) {
+		const char *marker = "[...] odpowiedz ucieta na limicie bufora -- pelna tresc linii jest w dmesg\n";
+		size_t dl = strlen(marker);
+
+		b->resp_uciete = true;
+		if (b->resp_len + dl < OM_RESP_MAX) {
+			memcpy(b->resp + b->resp_len, marker, dl);
+			b->resp_len += dl;
+		}
+	}
+	if (poziom >= 2)
+		pr_emerg(OM_NAZWA ": %s", tmp);
+	else if (poziom == 1)
+		pr_err(OM_NAZWA ": %s", tmp);
+	else
+		pr_info(OM_NAZWA ": %s", tmp);
+}
+
+#define om_odp(b, fmt, ...)	om_linia((b), 0, fmt, ##__VA_ARGS__)
+#define om_blad(b, fmt, ...)	om_linia((b), 1, fmt, ##__VA_ARGS__)
+#define om_emrg(b, fmt, ...)	om_linia((b), 2, fmt, ##__VA_ARGS__)
+
+/* ================================================================ okno / TCM */
+
+/* Predykat 1:1 z bcm4360_t328_is_d11_page() (pcie.c:2784-2792): porownanie
+ * stron 4-KB, czyli dokladnie 0x18001000..0x18001FFF. */
+static bool om_jest_strona_d11(u32 addr)
+{
+	return (addr & OM_PAGE_MASK) == (OM_D11_BASE & OM_PAGE_MASK);
+}
+
+static void om_odmowa_d11(struct om_bridge *b, u32 addr, const char *co)
+{
+	if (!b->odmowa_d11_log) {
+		b->odmowa_d11_log = true;
+		om_blad(b, "ODMOWA: strona D11 0x%08x (%s) -- HARD RULE CLAUDE.md p.7 (fire #21 = zwis maszyny); zero dotkniecia BAR0\n",
+			addr, co);
+	}
+}
+
+/* Okno backplane na PCIE2 -- stan spoczynkowy po KAZDEJ operacji (wymaganie 3;
+ * wzorzec: minihost.c:331-337 `okno_restore`). */
+static void om_okno_restore(struct om_bridge *b)
+{
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW,
+			       OM_PCIE2_BASE & OM_PAGE_MASK);
+}
+
+/* Czy strona docelowa jest OBCA (poza PCIE2)? BAR0 jest OKNEM -- znaczenie jego
+ * rejestrow zalezy od strony wpisanej w config 0x80. */
+static bool om_okno_obce(u32 page)
+{
+	return page != (OM_PCIE2_BASE & OM_PAGE_MASK);
+}
+
+/* WYSCIG Z ISR (znaleziony w audycie 11.09.2026, po biegu 19:44): `om_isr_szybki`
+ * czyta, a `om_isr_watek` W1C-PISZE BAR0+0x48/+0x4C, i ZADEN z nich nie bierze
+ * om_lock (komentarz przy om_isr_watek). Dopoki okno stoi na PCIE2, to jest ten
+ * sam rejestr co zawsze -- ale gdy `_ogon` przestawia okno na inna strone, ISR
+ * trafia w OBCY rejestr: na stronie D11 0x18001048 to ZLAMANIE HARD RULE
+ * (fire #21 = zwis), a W1C pod obcym adresem to niekontrolowany zapis.
+ * Sciezka jest realna takze w sekwencji kanonicznej: `status` chodzi PO `irq on`
+ * i czyta ChipCommon oraz ARM wrap, a `reset` NIE zwalnia linii, wiec powtorka
+ * sekwencji bez przeladowania modulu ma uzbrojony ISR na `d11release`/`maccontrol`.
+ * Na czas obcego okna maskujemy linie: `disable_irq` czeka na handler w locie,
+ * wiec po powrocie nikt nie dotyka BAR0 (a przerwanie dostarczone w tym oknie
+ * jest obslugiwane po `enable_irq`, juz z oknem na PCIE2). */
+static void om_okno_irq_maskuj(struct om_bridge *b, bool maskuj, u32 page)
+{
+	if (!maskuj)
+		return;
+	if (!b->okno_mask_log) {
+		b->okno_mask_log = true;
+		om_odp(b, "okno: strona 0x%08x != PCIE2 0x%08x -- linia przerwania ZAMASKOWANA na czas dostepu (ISR dotyka BAR0+0x%03x/+0x%03x bez om_lock, a BAR0 jest oknem)\n",
+		       page, OM_PCIE2_BASE, OM_R_MAILBOXINT, OM_R_MAILBOXMASK);
+	}
+	disable_irq(b->pdev->irq);
+}
+
+static void om_okno_irq_odmaskuj(struct om_bridge *b, bool maskuj)
+{
+	if (maskuj)
+		enable_irq(b->pdev->irq);
+}
+
+/* Ogon dostepu do backplane: strona do config 0x80 + KONTROLA ODCZYTU, dopiero
+ * potem BAR0 (wzorzec bcm4360_t328_bp_read32, pcie.c:2796-2817). Zwraca 0 albo
+ * -EIO (okno sie nie ustawilo -- BAR0 NIE dotkniete).
+ * UWAGA: ta funkcja NIE MA predykatu strony D11 -- o dopuszczeniu strony decyduje
+ * WYLACZNIE wolajacy. Wolno ja wolac tylko z dwoch miejsc nizej. */
+static int om_bp_read32_ogon(struct om_bridge *b, u32 addr, u32 *val)
+{
+	u32 page = addr & OM_PAGE_MASK;
+	bool maskuj = om_okno_obce(page) && b->irq_on;
+	u32 win = 0;
+
+	om_okno_irq_maskuj(b, maskuj, page);
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW, page);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	if (win != page) {
+		om_blad(b, "okno 0x%08x != strona 0x%08x (dla 0x%08x) -- dostep POMINIETY, zero dotkniecia BAR0\n",
+			win, page, addr);
+		om_okno_restore(b);
+		om_okno_irq_odmaskuj(b, maskuj);
+		return -EIO;
+	}
+	*val = ioread32(b->bar0 + (addr & (OM_BAR0_REG_SIZE - 1)));
+	om_okno_restore(b);
+	om_okno_irq_odmaskuj(b, maskuj);
+	return 0;
+}
+
+static int om_bp_write32_ogon(struct om_bridge *b, u32 addr, u32 val)
+{
+	u32 page = addr & OM_PAGE_MASK;
+	bool maskuj = om_okno_obce(page) && b->irq_on;
+	u32 win = 0;
+
+	om_okno_irq_maskuj(b, maskuj, page);
+	pci_write_config_dword(b->pdev, OM_BAR0_WINDOW, page);
+	pci_read_config_dword(b->pdev, OM_BAR0_WINDOW, &win);
+	if (win != page) {
+		om_blad(b, "okno 0x%08x != strona 0x%08x (dla 0x%08x) -- zapis POMINIETY, zero dotkniecia BAR0\n",
+			win, page, addr);
+		om_okno_restore(b);
+		om_okno_irq_odmaskuj(b, maskuj);
+		return -EIO;
+	}
+	iowrite32(val, b->bar0 + (addr & (OM_BAR0_REG_SIZE - 1)));
+	om_okno_restore(b);
+	om_okno_irq_odmaskuj(b, maskuj);
+	return 0;
+}
+
+/* Domyslny dostep do backplane: strona D11 ODRZUCONA (HARD RULE). Zwraca 0 albo
+ * -EPERM (strona D11) / -EIO (okno sie nie ustawilo) -- w obu przypadkach BAR0
+ * NIE jest dotkniete. */
+static int om_bp_read32(struct om_bridge *b, u32 addr, u32 *val)
+{
+	if (om_jest_strona_d11(addr)) {
+		om_odmowa_d11(b, addr, "odczyt backplane");
+		return -EPERM;
+	}
+	return om_bp_read32_ogon(b, addr, val);
+}
+
+static int om_bp_write32(struct om_bridge *b, u32 addr, u32 val)
+{
+	if (om_jest_strona_d11(addr)) {
+		om_odmowa_d11(b, addr, "zapis backplane");
+		return -EPERM;
+	}
+	return om_bp_write32_ogon(b, addr, val);
+}
+
+/* JEDYNE wejscie na STRONE RDZENIA D11 (0x18001000..0x18001FFF) w calym module.
+ * Uzywa go WYLACZNIE `om_op_maccontrol` i WYLACZNIE po podwojnej bramce:
+ * parametr `d11_ok=1` + token `d11-ok` w komendzie + swiezy odczyt wrappera
+ * mowiacy, ze D11 jest POZA RESETEM (bramka FAIL-CLOSED). HARD RULE
+ * CLAUDE.md p.7 -- kazde inne uzycie to blad (patrz verify.sh sekcja [C]).
+ *
+ * HISTORIA (11.09.2026, bieg mostu o 19:44): `maccontrol` wolal `om_bp_read32`/
+ * `om_bp_write32` i dostawal `-EPERM` z predykatu -- wyjatek "pod podwojna
+ * bramka" byl opisany w komentarzu i w `help`, ale NIE ISTNIAL w kodzie, wiec
+ * zapis nigdy nie poszedl, a fw zostal bez seedu `maccontrol`. Stad te funkcje. */
+static int om_bp_read32_d11(struct om_bridge *b, u32 addr, u32 *val)
+{
+	return om_bp_read32_ogon(b, addr, val);
+}
+
+static int om_bp_write32_d11(struct om_bridge *b, u32 addr, u32 val)
+{
+	return om_bp_write32_ogon(b, addr, val);
+}
+
+/* Odczyt TCM (BAR2 = RAM fw). To pamiec, nie rejestry -- zero okna. */
+static int om_tcm_read32(struct om_bridge *b, u32 off, u32 *val)
+{
+	if (off + 4 > OM_RAMSIZE || off + 4 > b->bar2_len) {
+		om_blad(b, "TCM: odczyt 0x%05x poza ramsize 0x%05x\n", off, OM_RAMSIZE);
+		return -EINVAL;
+	}
+	*val = ioread32(b->bar2 + off);
+	return 0;
+}
+
+/* Zapis TCM -- WYLACZNIE 32-bitowy (wymog 4360 z patcha 0003: 64-bit
+ * memcpy_toio wiesza magistrale -- pcie.c brcmf_pcie_copy_mem_to_dev).
+ * Adres moze byc NIEWYROWNANY -- to celowe, patrz om_tcm_zero(). */
+static int om_tcm_write32(struct om_bridge *b, u32 off, u32 val)
+{
+	if (off + 4 > OM_RAMSIZE || off + 4 > b->bar2_len) {
+		om_blad(b, "TCM: zapis 0x%05x poza ramsize 0x%05x\n", off, OM_RAMSIZE);
+		return -EINVAL;
+	}
+	iowrite32(val, b->bar2 + off);
+	return 0;
+}
+
+/* Kopia bajtow do TCM dword po dwordzie (LE), ostatni dword dopelniony zerami
+ * -- 1:1 z minihost.c:378-401 i brcmf_pcie_copy_mem_to_dev (pcie.c). Dla
+ * loadfw/vars ogon jest bezpieczny: lezy w TCM tuz za tekstem, ktorego
+ * dlugosc odbiorca zna z pola rozmiaru (+0x20 dla vars; dla obrazu -- z rozmiaru
+ * obrazu). */
+static void om_tcm_copy(struct om_bridge *b, u32 off, const u8 *src, u32 len)
+{
+	u32 i;
+
+	for (i = 0; i + 4 <= len; i += 4) {
+		u32 w = (u32)src[i] | ((u32)src[i + 1] << 8) |
+			((u32)src[i + 2] << 16) | ((u32)src[i + 3] << 24);
+
+		om_tcm_write32(b, off + i, w);
+	}
+	if (len & 3u) {
+		u32 baza = len & ~3u;
+		u32 w = 0;
+
+		for (i = 0; i < (len & 3u); i++)
+			w |= (u32)src[baza + i] << (8 * i);
+		om_tcm_write32(b, off + baza, w);
+	}
+}
+
+/* Zerowanie zakresu [from,to) TCM -- klasa z patcha 0036
+ * (bcm4360_ol77_zero_range, pcie.c:5658-5696: porcje 4 KiB, zapis 32-bitowy,
+ * jeden wspolny bufor zer). MINIHOST TEGO NIE UMIE: jego tcm_write32()
+ * odrzuca zapis niewyrownany (minihost.c:367-374), a zakres z luki 7 ma
+ * poczatek 0x6E322 (0x6E322 % 4 = 2) -- realne `zero 0x6e322 0x9a080`
+ * w userspace konczyloby sie `blad()` BEZ wyzerowania czegokolwiek. Modul
+ * (patch 0036) i ten most zapisuja 32-bitowo pod adresem niewyrownanym, bo to
+ * wlasnie zostalo ZMIERZONE w test.345.
+ *
+ * CALY ZAKRES MUSI BYC POKRYTY: petla dwordowa idzie od `from` skokiem 4 i przy
+ * dlugosci niepodzielnej przez 4 zostawia na koncu ogon 1..3 B -- dla zakresu
+ * domyslnego [0x6e322,0x9a080) sa to 2 B [0x9a07e,0x9a080), a to jest ogon
+ * obszaru-heapy, ktory luka 7 kazala czyscic (test.345 / patch 0036 zerowal
+ * CALY zakres; SBR tych smieci nie czysci, wiec zostawienie ich = jedyne
+ * odejscie od zmierzonego podloza).
+ * Ogon domykamy dwordem pod (to - 4): lezy on CALY w zakresie (jego dolne
+ * 2-3 B byly juz zerowane -- nadpisujemy je zerem, co jest nieszkodliwe),
+ * a GORNE 2-3 B to wlasnie ogon. To jest lepsze niz patch 0036, ktory kopiuje
+ * ostatnia porcje z dopelnieniem i tym samym siega 2 B ZA `to` (w kontrakt,
+ * ktory pozniej nadpisuje komenda `contract`): tu `to` i wszystko za nim
+ * zostaje NIETKNIETE. Zakres krotszy niz dword (to - from < 4) nadal da sie
+ * pokryc tylko wyjsciem za `to`, wiec jest POMIJANY i ZALOGOWANY.
+ * Zwraca liczbe bajtow POKRYTYCH (to - from, gdy ogon domkniety). */
+static u32 om_tcm_zero(struct om_bridge *b, u32 from, u32 to)
+{
+	u32 off;
+	u32 zapisane;
+
+	for (off = from; off + 4 <= to; off += 4)
+		om_tcm_write32(b, off, 0);
+	zapisane = off - from;
+
+	if (off == to)
+		return zapisane;		/* dlugosc podzielna przez 4 */
+
+	if (to - from >= 4) {
+		om_tcm_write32(b, to - 4, 0);
+		om_odp(b, "zero: ogon %u B [0x%05x,0x%05x) domkniety dwordem pod 0x%05x (caly w zakresie; `to` i wszystko za nim NIETKNIETE)\n",
+		       to - off, off, to, to - 4);
+		return to - from;
+	}
+	om_blad(b, "zero: zakres %u B [0x%05x,0x%05x) krotszy niz dword -- POMINIETY (zapis TCM jest tylko 32-bitowy, a pokrycie wymagaloby wyjscia za `to`; wymog 4360)\n",
+		 to - from, from, to);
+	return zapisane;
+}
+
+/* ================================================================ bufor DMA */
+
+/* Bramka adresu bufora dla fw 7.77 -- warunek 1:1 z minihost.c:517-521.
+ * UZASADNIENIE (binarium fw, notes/ par. 1.3):
+ *   0x3a7c ldr r3,[r2,#4]           (fw czyta z kontraktu TYLKO dolny dword)
+ *   0x3a7e bic.w r3,r3,#0xfc000000  (okno 64 MiB)
+ *   0x3a82 orr.w r3,r3,#0x8000000   (baza okna SB->PCIE 0x08000000)
+ *   0x3a90-0x3a98 sbtopcie0 := (low & 0xFC000000) | 0xC
+ * Adres >= 4 GiB jest bezuzyteczny (fragment +0x8 nie jest czytany), a okno
+ * przechodzace przez granice 64 MiB podstawia koniec pierscienia pod POCZATEK
+ * okna -- a fw tam PISZE (pierscien D2H) => uszkodzenie cudzej pamieci hosta. */
+static bool om_dma_adres_ok(dma_addr_t dma)
+{
+	return (u64)dma < 0x100000000ULL &&
+	       ((((u64)dma & 0x3ffffffULL) + OM_DMA_ROZMIAR) <= 0x4000000ULL);
+}
+
+static void om_buf_wr32(struct om_bridge *b, u32 off, u32 val)
+{
+	u32 *p = (u32 *)b->dma_va;
+
+	p[off / 4] = val;
+}
+
+static u32 om_buf_rd32(struct om_bridge *b, u32 off)
+{
+	const u32 *p = (const u32 *)b->dma_va;
+
+	return p[off / 4];
+}
+
+/* =========================================================== operacje: TCM */
+
+static void om_op_zero(struct om_bridge *b, int argc, char **argv)
+{
+	u32 from = OM_ZERO_OD_777;
+	u32 to = OM_ZERO_DO_777;
+	u32 zapisane;
+	u32 v0 = 0, v1 = 0;
+
+	if (argc >= 3) {
+		if (kstrtouint(argv[1], 0, &from) || kstrtouint(argv[2], 0, &to)) {
+			om_blad(b, "zero: uzycie `zero <od_hex> <do_hex>` (domyslnie 0x%05x 0x%05x)\n",
+				OM_ZERO_OD_777, OM_ZERO_DO_777);
+			return;
+		}
+	}
+	if (to <= from || to > OM_RAMSIZE) {
+		om_blad(b, "zero: zakres niepoprawny (0x%05x..0x%05x, ramsize 0x%05x)\n",
+			from, to, OM_RAMSIZE);
+		return;
+	}
+	om_emrg(b, "zero TCM [0x%05x,0x%05x) = %u B, klasa z patcha 0036 (porcje 4 KiB, zapis 32-bitowy) -- start\n",
+		from, to, to - from);
+	zapisane = om_tcm_zero(b, from, to);
+	(void)om_tcm_read32(b, from, &v0);
+	(void)om_tcm_read32(b, to - 4, &v1);
+	om_odp(b, "zero: zapisane %u B z %u; kontrola TCM[0x%05x]=0x%08x TCM[0x%05x]=0x%08x (oczekiwane 0x0 0x0)\n",
+	       zapisane, to - from, from, v0, to - 4, v1);
+	om_odp(b, "zero: TCM NIE czysci sie rebootem (CLAUDE.md p.5) -- ta komenda zastepuje reboot\n");
+}
+
+/* loadfw: obraz do TCM od 0 (32-bit, ostatni dword dopelniony zerami).
+ * NIE piszemy TCM[ramsize-4] (R2 z notes/; patch 0037
+ * robi to samo na sciezce 7.77). */
+static void om_op_loadfw(struct om_bridge *b, int argc, char **argv)
+{
+	struct file *f;
+	ssize_t n;
+	loff_t pos = 0;
+	u8 *dane;
+	u32 len;
+	u32 v0 = 0, v1 = 0;
+
+	if (argc < 2) {
+		om_blad(b, "loadfw: uzycie `loadfw <sciezka>`\n");
+		return;
+	}
+	f = filp_open(argv[1], O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		om_blad(b, "loadfw: nie moge otworzyc %s (%ld)\n", argv[1], PTR_ERR(f));
+		return;
+	}
+	len = (u32)i_size_read(file_inode(f));
+	if (len == 0 || len > OM_KONTRAKT) {
+		om_blad(b, "loadfw: rozmiar %u B poza zakresem (1..0x%05x = podstawa kontraktu)\n",
+			len, OM_KONTRAKT);
+		filp_close(f, NULL);
+		return;
+	}
+	dane = vmalloc(len);
+	if (!dane) {
+		om_blad(b, "loadfw: brak pamieci na %u B obrazu\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	n = kernel_read(f, dane, len, &pos);
+	filp_close(f, NULL);
+	if (n != (ssize_t)len) {
+		om_blad(b, "loadfw: odczytano %zd z %u B\n", n, len);
+		vfree(dane);
+		return;
+	}
+	om_emrg(b, "loadfw: %s = %u B -> TCM[0x00000..), zapis 32-bitowy -- start\n", argv[1], len);
+	om_tcm_copy(b, OM_RAMBASE, dane, len);
+	b->rstvec = (u32)dane[0] | ((u32)dane[1] << 8) |
+		    ((u32)dane[2] << 16) | ((u32)dane[3] << 24);
+	b->rstvec_znamy = true;
+	vfree(dane);
+	(void)om_tcm_read32(b, 0, &v0);
+	(void)om_tcm_read32(b, OM_RAMSIZE - 4, &v1);
+	om_odp(b, "loadfw: kontrola TCM[0x00000]=0x%08x (exp 0x%08x = rstvec); TCM[0x%05x]=0x%08x (tego pola NIE piszemy -- R2)\n",
+	       v0, b->rstvec, OM_RAMSIZE - 4, v1);
+	if (len == OM_OBRAZ_ROZMIAR_777)
+		om_odp(b, "loadfw: rstvec = 0x%08x (pierwszy dword obrazu 7.77.0.0; uzyje go `release`)\n",
+		       b->rstvec);
+	else
+		om_odp(b, "loadfw: UWAGA rozmiar != 0x%05x (obraz 7.77.0.0) -- rstvec = 0x%08x z tego pliku\n",
+		       OM_OBRAZ_ROZMIAR_777, b->rstvec);
+}
+
+/* ================================================ operacje: kontrakt i vars */
+
+/* Kontrakt: 12 pol. Kolejnosc i wartosci jak w minihost.c:1129-1197 i pcie.c
+ * (patch 0036 + 0037). Semafory piszemy ZERAMI (zasada 7 w naglowku pliku);
+ * Apple pisze 0 do +0x14/+0x18 (_wlc_ol_up, full.dis 0x73a3d/0x73a42), turn
+ * zostawia -- my zerujemy takze turn (minihost.c:1156), bo przy flag[0]=0
+ * warunek petli fw i tak nie zachodzi, a TCM nie czysci sie rebootem. */
+static void om_op_contract(struct om_bridge *b, int argc, char **argv)
+{
+	u32 rb[12];
+	u32 hb = 0, fl = 0, rec = 0, me = 0;
+	u32 i;
+
+	om_emrg(b, "contract: 12 pol @0x%05x (TCM_end - 0x5F80) -- start zapisu\n", OM_KONTRAKT);
+	(void)om_tcm_write32(b, OM_KONTRAKT + 0x0000, OM_MARKER_BEGIN_VAL);
+	if (b->dma_ok) {
+		(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUFADDR_LO,
+				     (u32)(b->dma_fiz & 0xffffffffu));
+		(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUFADDR_HI,
+				     (u32)((u64)b->dma_fiz >> 32));
+	} else {
+		om_blad(b, "contract: pola +0x%04x/+0x%04x POMINIETE -- adres bufora DMA 0x%llx NIE przechodzi bramki fw 7.77 (<4 GiB i okno 64 MiB); nie wymyslamy adresu\n",
+			OM_K_MSGBUFADDR_LO, OM_K_MSGBUFADDR_HI,
+			(unsigned long long)b->dma_fiz);
+	}
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MSGBUF_SZ, OM_MSGBUF_SZ);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_FLAG0, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_FLAG1, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TURN, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_HEARTBEAT, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_TRAP_REC, 0);
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_MARKER_END, OM_MARKER_END_VAL);
+
+	for (i = 0; i < 12; i++)
+		(void)om_tcm_read32(b, OM_KONTRAKT + i * 4, &rb[i]);
+	om_odp(b, "contract: +0x0 marker=0x%08x (exp 0x%08x)  +0x4 msgbuf_lo=0x%08x  +0x8 msgbuf_hi=0x%08x  +0xc sz=0x%08x\n",
+	       rb[0], OM_MARKER_BEGIN_VAL, rb[1], rb[2], rb[3]);
+	om_odp(b, "contract: +0x10 konsola_ptr=0x%08x (pisze FW)  +0x14 flag[0]=0x%08x  +0x18 flag[1]=0x%08x  +0x1c turn=0x%08x (exp 0 0 0)\n",
+	       rb[4], rb[5], rb[6], rb[7]);
+	om_odp(b, "contract: +0x20 vars_size=0x%08x (0 = vars jeszcze nie wgrane)\n", rb[8]);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_FLAG, &fl);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_TRAP_REC, &rec);
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_MARKER_END, &me);
+	om_odp(b, "contract: +0x5028 hb=0x%08x  +0x502c trap=0x%08x  +0x5ed8 rec=0x%08x  +0x5f5c marker_end=0x%08x (exp 0x%08x)\n",
+	       hb, fl, rec, me, OM_MARKER_END_VAL);
+	if (rb[0] != OM_MARKER_BEGIN_VAL || me != OM_MARKER_END_VAL)
+		om_blad(b, "contract: UWAGA markery NIE zapisaly sie (walidator hosta @0x774e2/_wlc_ol_validate_shared_info je sprawdza; fw ich NIE waliduje)\n");
+	if (fl == OM_TRAP_FLAG_VAL)
+		om_blad(b, "contract: UWAGA trap_flag bylo 0xDEADBEEF -- fw na zastanym 0xDEADBEEF wchodzi w wieczny spin (die() 0x344c -> b.n 0x3466), dlatego zerujemy to pole PRZED releasem\n");
+}
+
+/* vars: rozmiar @+0x20, tekst @+0x24 + odczyt zwrotny CALOSCI -- 1:1 z
+ * bcm4360_ol77_write_vars (pcie.c:5699-5760) i z komenda `vars` minihosta
+ * (minihost.c:1201-1245). Bramka rozmiaru: MAXSZ_NVRAM_VARS 0x4000. */
+static void om_op_vars(struct om_bridge *b, int argc, char **argv)
+{
+	struct file *f;
+	ssize_t n;
+	loff_t pos = 0;
+	u8 *dane;
+	u32 len, i, niezgodne = 0;
+	u32 rozmiar_rb = 0;
+
+	if (argc < 2) {
+		om_blad(b, "vars: uzycie `vars <sciezka>`\n");
+		return;
+	}
+	f = filp_open(argv[1], O_RDONLY, 0);
+	if (IS_ERR(f)) {
+		om_blad(b, "vars: nie moge otworzyc %s (%ld)\n", argv[1], PTR_ERR(f));
+		return;
+	}
+	len = (u32)i_size_read(file_inode(f));
+	if (len == 0 || len > OM_VARS_MAX) {
+		om_blad(b, "vars: rozmiar %u B poza zakresem 1..0x%x (MAXSZ_NVRAM_VARS)\n",
+			len, OM_VARS_MAX);
+		filp_close(f, NULL);
+		return;
+	}
+	if (OM_K_VARS + len > 0x5f80u) {
+		om_blad(b, "vars: %u B nie miesci sie w strukturze hosta (0x5F80 B)\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	dane = vmalloc(len);
+	if (!dane) {
+		om_blad(b, "vars: brak pamieci na %u B\n", len);
+		filp_close(f, NULL);
+		return;
+	}
+	n = kernel_read(f, dane, len, &pos);
+	filp_close(f, NULL);
+	if (n != (ssize_t)len) {
+		om_blad(b, "vars: odczytano %zd z %u B\n", n, len);
+		vfree(dane);
+		return;
+	}
+	om_emrg(b, "vars: %s = %u B -> kontrakt+0x%02x (TCM[0x%05x..0x%05x]) -- start\n",
+		argv[1], len, OM_K_VARS, OM_KONTRAKT + OM_K_VARS,
+		OM_KONTRAKT + OM_K_VARS + len - 1);
+	/* Kolejnosc jak w module i minihoscie: NAJPIERW rozmiar, potem tekst */
+	(void)om_tcm_write32(b, OM_KONTRAKT + OM_K_VARS_SIZE, len);
+	om_tcm_copy(b, OM_KONTRAKT + OM_K_VARS, dane, len);
+	for (i = 0; i < len; i += 4) {
+		u32 rb = 0;
+		u32 k;
+
+		(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_VARS + i, &rb);
+		for (k = 0; k < 4; k++) {
+			u32 idx = i + k;
+			u8 oczek = (idx < len) ? dane[idx] : 0;
+
+			if ((u8)(rb >> (8 * k)) != oczek)
+				niezgodne++;
+		}
+	}
+	(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_VARS_SIZE, &rozmiar_rb);
+	om_odp(b, "vars: readback vars_size=0x%08x (exp 0x%x) bajtow-niezgodnych=%u\n",
+	       rozmiar_rb, len, niezgodne);
+	vfree(dane);
+}
+
+/* ===================================== D11: zdjecie resetu przez WRAPPER (0x18101000)
+ *
+ * PO CO: fw 7.77 w attachu czyta `clk_ctl_st` = D11+0x1e0 (`ldr.w r2,[r3,#0x1e0]`
+ * @pc 0x12cc2 przy r3 = 0x18001000 => dfar 0x180011e0) i dostaje **AXI timeout**,
+ * bo **D11 jest W RESECIE i jego przestrzen rejestrow nie odpowiada na szynie**.
+ * To ten sam objaw i ta sama przyczyna, co w fire #20 (TRAP 4 @pc 0xe40a na
+ * 0x180011e0). Zmierzone w pierwszym biegu mostu: `dfar 0x180011e0`, `pc 0x12cc2`
+ * (notes/ par.2).
+ *
+ * PRZEPIS 1:1 z brcmfmac `brcmf_chip_ai_resetcore` (chip.c:434-489) -- ta sama
+ * droga, ktora w FIRE #23 (test.329, patch 0027) uwolnila D11 i wypuscila fw za
+ * pc=0xe40a. Pomiar z tamtego fire (notes/):
+ *     BEFORE: IOCTL(0x18101408) = 0x7   RESET_CTL(0x18101800) = 0x1
+ *     AFTER : IOCTL             = 0x5   RESET_CTL              = 0x0
+ * Trojak dla D11: prereset = PHYRESET|PHYCLOCKEN (0xc), reset = postreset =
+ * PHYCLOCKEN (0x4) -- ten sam, ktory sterownik podaje dla D11 na innych chipach
+ * (chip.c:1288-1291, :1360-1363).
+ *
+ * GRANICA: dotykamy WYLACZNIE strony WRAPPERA 0x18101000 (+0x408/+0x800/+0x804/
+ * +0x1e0) -- tak samo, jak `om_reset_internal_mem` dotyka wrappera SOCRAM, a
+ * `release` wrappera ARM. Strona rdzenia 0x18001000 pozostaje ZAKAZANA (HARD
+ * RULE, fire #21) -- i tak nie odpowiada, dopoki RESET_CTL b0 = 1. Zero zapisow
+ * do rdzenia; kazda petla jest ograniczona, kazdy zapis ma readback.
+ */
+static int om_d11_w_reset_ctl(struct om_bridge *b, u32 *val)
+{
+	return om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, val);
+}
+
+static void om_op_d11release(struct om_bridge *b, int argc, char **argv)
+{
+	const u32 prereset = OM_BCMA_IOCTL_PHYRESET | OM_BCMA_IOCTL_PHYCLOCKEN;	/* 0xc */
+	const u32 reset = OM_BCMA_IOCTL_PHYCLOCKEN;				/* 0x4 */
+	const u32 postreset = OM_BCMA_IOCTL_PHYCLOCKEN;				/* 0x4 */
+	u32 ioctl_przed = 0, reset_przed = 0, st_przed = 0, clk_przed = 0;
+	u32 ioctl_cfg = 0, ioctl_po = 0, reset_po = 0, st_po = 0, clk_po = 0;
+	u32 reset_ost = 0;	/* ostatni UDANY odczyt RESET_CTL = podstawa werdyktu */
+	bool po_ok = false;	/* czy odczyt RESET_CTL po zdjeciu resetu sie udal */
+	u32 i;
+
+	(void)argc;
+	(void)argv;
+	om_emrg(b, "d11release: wrapper D11 0x%08x -- zapisy TYLKO do strony wrappera; rdzen 0x%08x ZAKAZANY (HARD RULE, fire #21)\n",
+		OM_D11_WRAP, OM_D11_BASE);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_przed);
+	if (om_d11_w_reset_ctl(b, &reset_przed) != 0) {
+		om_blad(b, "d11release: odczyt RESET_CTL wrappera nieudany -- backplane nie odpowiada; PRZERYWAM (zero zapisow)\n");
+		return;
+	}
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_ST, &st_przed);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_CLKCTLST, &clk_przed);
+	om_odp(b, "d11release: PRZED: IOCTL(+0x%03x)=0x%08x RESET_CTL(+0x%03x)=0x%08x RESET_ST=0x%08x CLKCTLST(+0x%03x)=0x%08x => %s\n",
+	       OM_BCMA_IOCTL, ioctl_przed, OM_BCMA_RESET_CTL, reset_przed, st_przed,
+	       OM_BCMA_CLKCTLST, clk_przed,
+	       (reset_przed & OM_BCMA_RESET_CTL_RESET) ?
+	       "D11 W RESECIE (przestrzen rdzenia NIE odpowiada -- stad AXI timeout fw)" :
+	       "D11 poza resetem (jesli fw i tak traci szyne, przyczyna jest inna)");
+
+	/* krok 1 -- tylko gdy rdzen NIE jest w resecie (chip.c:360-375): wstaw w reset,
+	 * bo inaczej nie ma czego zwalniac. */
+	if (!(reset_przed & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL,
+				    prereset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_cfg);
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, OM_BCMA_RESET_CTL_RESET);
+		usleep_range(10, 20);
+		for (i = 0; i < 300; i++) {
+			u32 v = 0;
+
+			if (om_d11_w_reset_ctl(b, &v) != 0)
+				break;
+			if (v == OM_BCMA_RESET_CTL_RESET)
+				break;
+			udelay(1);
+		}
+		om_odp(b, "d11release: krok 1 (wstawienie w reset): IOCTL := 0x%08x (readback 0x%08x), RESET_CTL := 0x%08x\n",
+		       prereset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK, ioctl_cfg,
+		       OM_BCMA_RESET_CTL_RESET);
+	}
+	/* krok 2 -- konfiguracja w resecie (chip.c:378-381). Oczekiwane 0x7 = fire #23 BEFORE. */
+	(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL,
+			    reset | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_cfg);
+	om_odp(b, "d11release: krok 2 (konfiguracja w resecie): IOCTL := 0x%08x (wzorzec fire #23: 0x7)\n",
+	       ioctl_cfg);
+	/* krok 3 -- zdjecie resetu, petla OGRANICZONA (chip.c:459-470: max 50 prob). */
+	for (i = 0; i < 50; i++) {
+		if (om_d11_w_reset_ctl(b, &reset_po) != 0)
+			break;
+		reset_ost = reset_po;
+		po_ok = true;
+		if (!(reset_ost & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(40, 60);
+	}
+	/* Krok 3 mial dotad ZADNEJ linii w logu (uwaga z audytu 11.09.2026) --
+	 * a to on jest sedno werdyktu, wiec raportujemy wyjscie z petli. */
+	om_odp(b, "d11release: krok 3 (zdjecie resetu): RESET_CTL := 0 w petli <= 50; wyjscie na iteracji %u, RESET_CTL = 0x%08x%s\n",
+	       i, reset_ost,
+	       po_ok ? "" : " (zaden odczyt RESET_CTL sie nie udal)");
+	/* krok 4 -- postreset (chip.c:483-485). Oczekiwane 0x5 = fire #23 AFTER. */
+	(void)om_bp_write32(b, OM_D11_WRAP + OM_BCMA_IOCTL, postreset | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_IOCTL, &ioctl_po);
+	/* Werdykt wylacznie z UDANEGO odczytu: nieudany odczyt = stan NIEZNANY, a nie
+	 * "TAK" z niezainicjowanej zmiennej (ta sama klasa bledu, co statyczny werdykt
+	 * w `read rings` -- 11.09.2026). Ostatni udany odczyt = stan biezacy. */
+	if (om_d11_w_reset_ctl(b, &reset_po) == 0) {
+		reset_ost = reset_po;
+		po_ok = true;
+	} else {
+		om_blad(b, "d11release: odczyt RESET_CTL po postresecie NIEUDANY -- werdykt z ostatniego udanego odczytu (0x%08x)\n",
+			reset_ost);
+	}
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_RESET_ST, &st_po);
+	(void)om_bp_read32(b, OM_D11_WRAP + OM_BCMA_CLKCTLST, &clk_po);
+	om_odp(b, "d11release: PO: IOCTL=0x%08x RESET_CTL=0x%08x (udany odczyt: %s) RESET_ST=0x%08x CLKCTLST(+0x%03x)=0x%08x\n",
+	       ioctl_po, reset_ost, po_ok ? "tak" : "NIE -- stan NIEZNANY", st_po,
+	       OM_BCMA_CLKCTLST, clk_po);
+	om_odp(b, "d11release: WERDYKT D11 wyszlo z resetu: %s (RESET_CTL b0: 0x%x -> 0x%x); IOCTL 0x%x -> 0x%x (wzorzec fire #23: 0x7 -> 0x5)\n",
+	       !po_ok ? "NIEZNANE (zaden odczyt RESET_CTL sie nie udal)" :
+	       (reset_ost & OM_BCMA_RESET_CTL_RESET) ? "NIE" : "TAK",
+	       reset_przed & 1u, reset_ost & 1u, ioctl_cfg, ioctl_po);
+	om_odp(b, "d11release: kolejnosc ZMIERZONA (test.342/345; pcie.c:5874 obraz, :5883 TCM): ten krok po `zero`/`loadfw`/`contract`/`vars`, a przed `maccontrol` i `release` -- obie sciany sa niezalezne: najpierw szyna (reset), potem predykat clk (maccontrol)\n");
+}
+
+/* ==================================================== maccontrol (strona D11)
+ *
+ * PODWOJNA BRAMKA: parametr modulu `d11_ok=1` ORAZ token `d11-ok` w samej
+ * komendzie -- OBA sprawdzane PRZED jakimkolwiek MMIO (wymagania 3 i 5
+ * zlecenia; HARD RULE CLAUDE.md p.7). Wartosc: seed kextu 0x04000400
+ * (MCTL_IHR_EN b10 | MCTL_WAKE b26) -- notes/;
+ * zmierzone w test.341/342: wypuszcza fw z asercji `clk == 0`. */
+static void om_op_maccontrol(struct om_bridge *b, int argc, char **argv)
+{
+	u32 addr = OM_D11_BASE + OM_D11_MACCONTROL_OFF;
+	u32 wartosc = OM_D11_MACCONTROL_SEED;
+	u32 przed = 0, po = 0;
+	bool token = false;
+	int i;
+
+	for (i = 1; i < argc; i++)
+		if (!strcmp(argv[i], "d11-ok"))
+			token = true;
+
+	if (!d11_ok) {
+		om_blad(b, "ODMOWA: maccontrol dotyka strony D11 0x%08x, a modul nie zostal zaladowany z `d11_ok=1` -- HARD RULE CLAUDE.md p.7 (fire #21 = zwis maszyny). Zero MMIO.\n",
+			addr);
+		return;
+	}
+	if (!token) {
+		om_blad(b, "ODMOWA: maccontrol wymaga tokenu `d11-ok` w samej komendzie (np. `maccontrol 0x04000400 d11-ok`), mimo d11_ok=1. Zero MMIO.\n");
+		return;
+	}
+	if (argc >= 2 && strcmp(argv[1], "d11-ok") && kstrtouint(argv[1], 0, &wartosc)) {
+		om_blad(b, "maccontrol: uzycie `maccontrol [<hex>] d11-ok` (bez wartosci biore seed kextu 0x%08x)\n",
+			OM_D11_MACCONTROL_SEED);
+		return;
+	}
+	/* BLOKADA BEZPIECZENSTWA (doszla 11.09.2026): dopoki D11 jest W RESECIE, jego
+	 * przestrzen rejestrow nie odpowiada na szynie -- kazdy dostep do niej to AXI
+	 * timeout, a przy odczycie z hosta realny zwis maszyny (fire #21). Stan czytamy
+	 * z WRAPPERA (0x18101000), ktory odpowiada ZAWSZE.
+	 * BRAMKA FAIL-CLOSED (11.09.2026, po audycie): NIEUDANY odczyt wrappera to NIE
+	 * "brak dowodu na reset", a "stan NIEZNANY" -- i taki przypadek tez konczy sie
+	 * odmowa. Poprzednia wersja przepuszczala wtedy zapis na strone rdzenia (jedyna
+	 * egzekucja HARD RULE byla fail-open). */
+	{
+		u32 rc = 0;
+
+		if (om_d11_w_reset_ctl(b, &rc) != 0) {
+			om_blad(b, "ODMOWA: odczyt RESET_CTL wrappera 0x%08x NIEUDANY -- stan D11 NIEZNANY, a przy D11 w resecie strona rdzenia 0x%08x nie odpowiada na szynie (AXI timeout/zwis, fire #21). Bramka jest FAIL-CLOSED. Zero MMIO na rdzeniu.\n",
+				OM_D11_WRAP + OM_BCMA_RESET_CTL, addr);
+			return;
+		}
+		if (rc & OM_BCMA_RESET_CTL_RESET) {
+			om_blad(b, "ODMOWA: D11 jest W RESECIE (wrapper 0x%08x RESET_CTL=0x%08x) -- strona rdzenia 0x%08x NIE odpowiada na szynie; dostep = AXI timeout/zwis (fire #21). Najpierw `d11release`. Zero MMIO na rdzeniu.\n",
+				OM_D11_WRAP, rc, addr);
+			return;
+		}
+		om_odp(b, "maccontrol: wrapper D11 RESET_CTL=0x%08x => rdzen poza resetem, dostep do strony 0x%08x ma sens\n",
+		       rc, addr);
+	}
+	om_emrg(b, "maccontrol: D11 0x%08x := 0x%08x -- SWIADOMY dostep do STRONY D11 (d11_ok=1 + token d11-ok + bramka FAIL-CLOSED; jedyne wejscie: om_bp_*_d11)\n",
+		addr, wartosc);
+	if (om_bp_read32_d11(b, addr, &przed) == 0)
+		om_odp(b, "maccontrol: PRZED = 0x%08x\n", przed);
+	if (om_bp_write32_d11(b, addr, wartosc) == 0 && om_bp_read32_d11(b, addr, &po) == 0)
+		om_odp(b, "maccontrol: po zapisie 0x%08x (readback 0x%08x) -- %s; predykat fw (mctrl & 0x404) = 0x%03x => %s\n",
+		       wartosc, po, po == wartosc ? "zapis siadl" : "ZAPIS NIE SIADL",
+		       po & 0x404u,
+		       (po & 0x404u) == 0x400u ? "D11 obecny dla fw (clk != 0)" :
+						 "fw uzna D11 za nieobecny (clk = 0)");
+}
+
+/* ============================================ reset SOCRAM + release ARM */
+
+/* Reset rdzenia INTERNAL_MEM (0x81a) przed releasem -- pcie.c:4076-4081,
+ * chip.c:350-486 (ai_coredisable + petla zdjecia resetu + IOCTL := postreset|CLK). */
+static void om_reset_internal_mem(struct om_bridge *b)
+{
+	u32 v = 0, i;
+
+	om_emrg(b, "release: reset rdzenia INTERNAL_MEM (SOCRAM, wrap 0x%08x) -- brcmf_chip_resetcore(core,0,0,0)\n",
+		OM_SOCRAM_WRAP);
+	if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+		return;
+	om_odp(b, "release: SOCRAM RESET_CTL przed = 0x%08x\n", v);
+	if (!(v & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL,
+				    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, &v);
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL,
+				    OM_BCMA_RESET_CTL_RESET);
+		usleep_range(15, 30);
+	}
+	(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL,
+			    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	for (i = 0; i < 50; i++) {
+		if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+			break;
+		if (!(v & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(50, 60);
+	}
+	(void)om_bp_write32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, OM_BCMA_IOCTL_CLK);
+	if (om_bp_read32(b, OM_SOCRAM_WRAP + OM_BCMA_IOCTL, &v) == 0)
+		om_odp(b, "release: SOCRAM po resecie IOCTL = 0x%08x\n", v);
+}
+
+/* Release ARM -- sekwencja 1:1 z minihosta (op_release, minihost.c:1309-1364):
+ * ops->activate = TCM[0] := rstvec (pcie.c brcmf_pcie_buscore_activate) +
+ * brcmf_chip_resetcore(core_arm_cr4, CPUHALT, 0, 0) (chip.c:1351-1362).
+ * Efekt = RMW kextu `wrapper[0x408] &= ~0x20` (notes/:213):
+ * ostatni zapis IOCTL to CLK bez CPUHALT => ARM rusza. */
+static void om_op_release(struct om_bridge *b, int argc, char **argv)
+{
+	u32 v = 0, i;
+	u32 rstvec;
+
+	if (b->rstvec_znamy) {
+		rstvec = b->rstvec;
+		om_odp(b, "release: rstvec = 0x%08x (z ostatniego `loadfw`)\n", rstvec);
+	} else {
+		(void)om_tcm_read32(b, 0, &rstvec);
+		om_odp(b, "release: UWAGA bez `loadfw` w tej sesji -- biore rstvec z TCM[0x00000] = 0x%08x (moze byc smiec z poprzedniego przebiegu; `reset` nie czysci TCM)\n",
+		       rstvec);
+	}
+	om_reset_internal_mem(b);
+	om_emrg(b, "release: TCM[0x00000] := 0x%08x + wrapper ARM 0x%08x (RESET_CTL, IOCTL, petla, IOCTL := CLK bez CPUHALT) -- start\n",
+		rstvec, OM_ARM_WRAP);
+	(void)om_tcm_write32(b, OM_RAMBASE, rstvec);
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) != 0) {
+		om_blad(b, "release: nie moge odczytac RESET_CTL ARM -- PRZERWANE (zero dalszych zapisow)\n");
+		return;
+	}
+	om_odp(b, "release: ARM RESET_CTL przed = 0x%08x (w resecie: %s)\n", v,
+	       (v & OM_BCMA_RESET_CTL_RESET) ? "TAK" : "NIE");
+	if (!(v & OM_BCMA_RESET_CTL_RESET)) {
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL,
+				    OM_ARMCR4_IOCTL_CPUHALT | OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+		(void)om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v);
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, OM_BCMA_RESET_CTL_RESET);
+		usleep_range(15, 30);
+	}
+	(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL,
+			    OM_BCMA_IOCTL_FGC | OM_BCMA_IOCTL_CLK);
+	(void)om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v);
+	for (i = 0; i < 50; i++) {
+		if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) != 0)
+			break;
+		if (!(v & OM_BCMA_RESET_CTL_RESET))
+			break;
+		(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, 0);
+		usleep_range(50, 60);
+	}
+	(void)om_bp_write32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, OM_BCMA_IOCTL_CLK);
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_IOCTL, &v) == 0) {
+		om_odp(b, "release: ARM IOCTL po releasie = 0x%08x (CPUHALT b5 = %u => %s)\n",
+		       v, (v >> 5) & 1u,
+		       (v & OM_ARMCR4_IOCTL_CPUHALT) ? "ARM nadal w halt" : "ARM RUSZYL");
+		b->arm_wypuszczony = !(v & OM_ARMCR4_IOCTL_CPUHALT);
+	}
+	if (om_bp_read32(b, OM_ARM_WRAP + OM_BCMA_RESET_CTL, &v) == 0)
+		om_odp(b, "release: ARM RESET_CTL po releasie = 0x%08x\n", v);
+}
+
+/* ============================================== bramka gotowosci i konsola fw */
+
+/* Poll kontrakt+0x5028 co 1 ms, limit 2000 (domyslnie; argument zmienia limit).
+ * Po timeoucie LOG i KONTYNUACJA -- nigdy blad (Apple robi dokladnie to:
+ * kext 0x73d3a-0x73d63; notes/ par.2.1). */
+static void om_op_gate(struct om_bridge *b, int argc, char **argv)
+{
+	u32 limit = OM_GATE_ITERACJE;
+	u32 i, hb = 0;
+
+	if (argc >= 2) {
+		if (kstrtouint(argv[1], 0, &limit) || limit == 0)
+			limit = OM_GATE_ITERACJE;
+	}
+	om_odp(b, "gate: poll TCM[0x%05x] (heartbeat = kontrakt+0x%04x) co 1 ms, limit %u\n",
+	       OM_KONTRAKT + OM_K_HEARTBEAT, OM_K_HEARTBEAT, limit);
+	for (i = 0; i < limit; i++) {
+		(void)om_tcm_read32(b, OM_KONTRAKT + OM_K_HEARTBEAT, &hb);
+		if (hb)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (hb)
+		om_odp(b, "gate: heartbeat = 0x%08x po %u iteracjach -- FW ZYJE\n", hb, i + 1);
+	else
+		om_odp(b, "gate: TIMEOUT po %u ms, heartbeat nadal 0 -- KONTYNUUJE (Apple tez nie przerywa bootu; brak galezi bledu)\n",
+		       limit);
+}
+
+/* Wskaznik struktury konsoli fw (kontrakt+0x10) i jej pola
+ * {buf @+0, size @+4, wr_idx @+8} -- notatka par.5.2; publikuje je FW. */
+static int om_konsola(struct om_bridge *b, u32 *ptr, u32 *buf, u32 *size, u32 *wr)
+{
+	if (om_tcm_read32(b, OM_KONTRAKT + OM_K_CONSOLE_PTR, ptr) != 0)
+		return -EIO;
+	if (!*ptr || *ptr >= OM_RAMSIZE)
+		return -ENODATA;
+	if (om_tcm_read32(b, *ptr + 0x0, buf) || om_tcm_read32(b, *ptr + 0x4, size) ||
+	    om_tcm_read32(b, *ptr + 0x8, wr))
+		return -EIO;
+	if (!*buf || *buf >= OM_RAMSIZE || !*size || *size > OM_RAMSIZE)
+		return -ENODATA;
+	return 0;
+}
+
+static bool om_konsola_ma(struct om_bridge *b, const char *szukana)
+{
+	u32 ptr, buf, size, wr, n, i, k, dl;
+
+	if (om_konsola(b, &ptr, &buf, &size, &wr) != 0)
+		return false;
+	dl = (u32)strlen(szukana);
+	n = (wr > size) ? size : wr;	/* wr > size => licznik przebiegl ring */
+	if (!dl || n < dl || buf + n > b->bar2_len)
+		return false;
+	for (i = 0; i + dl <= n; i++) {
+		for (k = 0; k < dl; k++) {
+			u8 c = ioread8(b->bar2 + buf + i + k);
+
+			if (c != (u8)szukana[k])
+				break;
+		}
+		if (k == dl)
+			return true;
+	}
+	return false;
+}
+
+/* Doczekanie linii `pciedngl_open called` przed doorbellem (nota par.6 p. 5).
+ * Bez niej doorbell moze zostac zatrzasniety i nieobsluzony -- fw czyta ring
+ * WYLACZNIE w ISR. Po ~2 s idziemy dalej (pomiar: linia jest po 0,052 s). */
+static void om_czekaj_pciedngl_open(struct om_bridge *b)
+{
+	u32 i, cierpliwosc = OM_KONSOLA_CZEKAJ_MS / 10u;
+
+	om_odp(b, "doczekanie linii `%s` w konsoli fw (kontrakt+0x%04x -> P+0/4/8), max ~%u ms\n",
+	       OM_KONSOLA_LINIA, OM_K_CONSOLE_PTR, OM_KONSOLA_CZEKAJ_MS);
+	for (i = 0; i < cierpliwosc; i++) {
+		if (om_konsola_ma(b, OM_KONSOLA_LINIA)) {
+			om_odp(b, "konsola fw: `%s` JEST (po ~%u ms) -- fw uzbrojony na doorbell\n",
+			       OM_KONSOLA_LINIA, (i + 1) * 10u);
+			return;
+		}
+		usleep_range(10000, 11000);
+	}
+	om_odp(b, "konsola fw: `%s` NIE pojawila sie w ~%u ms -- wysylam mimo to (doorbell moze zostac nieobsluzony; ISR fw przy pustym ringu drukuje tylko `pktlen: 0`)\n",
+	       OM_KONSOLA_LINIA, OM_KONSOLA_CZEKAJ_MS);
+}
+
+/* =========================================================== pierscienie DMA */
+
+static void om_op_ringinit(struct om_bridge *b, int argc, char **argv)
+{
+	static const struct {
+		u32 off, val;
+		const char *opis;
+	} h[8] = {
+		{ OM_RING_HDR_H2D + 0x0, OM_RING_DATA_H2D, "H2D data_off" },
+		{ OM_RING_HDR_H2D + 0x4, OM_RING_ROZMIAR, "H2D size" },
+		{ OM_RING_HDR_H2D + 0x8, 0, "H2D rd (pisze FW: zuzycie)" },
+		{ OM_RING_HDR_H2D + 0xc, 0, "H2D wr (pisze HOST: publikacja)" },
+		{ OM_RING_HDR_D2H + 0x0, OM_RING_DATA_D2H, "D2H data_off" },
+		{ OM_RING_HDR_D2H + 0x4, OM_RING_ROZMIAR, "D2H size" },
+		{ OM_RING_HDR_D2H + 0x8, 0, "D2H rd (pisze HOST)" },
+		{ OM_RING_HDR_D2H + 0xc, 0, "D2H wr (pisze FW)" },
+	};
+	u32 i;
+
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "ringinit: brak zweryfikowanego bufora DMA (adres 0x%llx) -- naglowki pierscieni nie maja gdzie powstac\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	om_emrg(b, "ringinit: naglowki obu pierscieni olmsg w buforze DMA 0x%llx (RAM hosta, zero MMIO; rownowazne z bcm_olmsg_init @0x4f38) -- start\n",
+		(unsigned long long)b->dma_fiz);
+	for (i = 0; i < 8; i++) {
+		om_buf_wr32(b, h[i].off, h[i].val);
+		om_odp(b, "ringinit: buf+0x%02x := 0x%08x (%s)\n", h[i].off, h[i].val, h[i].opis);
+	}
+	wmb();
+	om_odp(b, "ringinit: readback %08x %08x %08x %08x | %08x %08x %08x %08x\n",
+	       om_buf_rd32(b, 0x00), om_buf_rd32(b, 0x04), om_buf_rd32(b, 0x08),
+	       om_buf_rd32(b, 0x0c), om_buf_rd32(b, 0x10), om_buf_rd32(b, 0x14),
+	       om_buf_rd32(b, 0x18), om_buf_rd32(b, 0x1c));
+}
+
+/* Zapis komunikatu olmsg do pierscienia H2D: naglowek {type,seq,len} po 4 B LE
+ * pod `off`, potem `len` bajtow payloadu -- 1:1 z bcm4360_olmsg_write
+ * (pcie.c:1570-1576) i z `olmsg_peek_len` @0x4d48 w fw (total = len + 12).
+ * `seq` fw NIE waliduje (olmsg_readmsg @0x4e24) => 0, jak u Apple. */
+static void om_ring_msg(struct om_bridge *b, u32 off, u32 typ, u32 seq,
+			u32 len, const u8 *payload)
+{
+	u32 i;
+
+	om_buf_wr32(b, off + 0, typ);
+	om_buf_wr32(b, off + 4, seq);
+	om_buf_wr32(b, off + 8, len);
+	for (i = 0; i < len; i++)
+		((u8 *)b->dma_va)[off + OM_OLMSG_HDR + i] = payload[i];
+}
+
+/* Skan pierscienia D2H z NASZEGO bufora (RAM hosta, zero MMIO) + przesuniecie
+ * rd na wr. Wolane z watku przerwania ORAZ tuz po doorbellu (R7 z notes/
+ * dma-irq-adresy-audyt.md par. 4: RMW na 0x48 moze skasowac OBCE oczekujace
+ * zgloszenie D2H -- bit 8 jest W1C -- wiec po wlasnym zapisie trzeba od razu
+ * przejrzec pierscien, zeby tego zgloszenia nie zgubic). */
+static void om_d2h_scan(struct om_bridge *b, const char *skad)
+{
+	u32 rd = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD);
+	u32 wr = om_buf_rd32(b, OM_RING_HDR_D2H + OM_RING_D2H_WR);
+	u32 n = (wr >= rd) ? (wr - rd) : (OM_RING_ROZMIAR - rd + wr);
+	u32 off;
+
+	om_odp(b, "d2h (%s): rd=%u wr=%u (%u B)\n", skad, rd, wr, n);
+	if (!n || wr > OM_RING_ROZMIAR)
+		return;
+	for (off = 0; off + OM_OLMSG_HDR <= n; ) {
+		u32 typ = om_buf_rd32(b, OM_RING_DATA_D2H + off);
+		u32 seq = om_buf_rd32(b, OM_RING_DATA_D2H + off + 4);
+		u32 len = om_buf_rd32(b, OM_RING_DATA_D2H + off + 8);
+
+		if (off + OM_OLMSG_HDR + len > OM_RING_ROZMIAR) {
+			om_blad(b, "d2h (%s): naglowek @+0x%04x niespojny (len %u) -- przerywam\n",
+				skad, OM_RING_DATA_D2H + off, len);
+			break;
+		}
+		om_odp(b, "d2h (%s): @buf+0x%04x type=0x%08x seq=%u len=%u\n",
+		       skad, OM_RING_DATA_D2H + off, typ, seq, len);
+		off += OM_OLMSG_HDR + len;
+		if (off == n)
+			break;
+	}
+	om_buf_wr32(b, OM_RING_HDR_D2H + OM_RING_D2H_RD, wr);
+}
+
+/* Doorbell H2D: BAR0+0x48 |= 0x1 -- RMW jak Apple (`_wlc_ol_msg_send`
+ * 0x76e3c-0x76e5a: read + orl $0x1 + zapis) i jak nasz modul. Rejestr lezy
+ * w PCIE2 (0x18003048), NIE w D11 (notes/); bit 0 =>
+ * fw widzi bit 8 swojego intstatus i wchodzi w `pciedngl_isr`. */
+static void om_doorbell(struct om_bridge *b, const char *skad)
+{
+	u32 przed = 0, po = 0;
+
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, &przed) != 0) {
+		om_blad(b, "doorbell (%s): nie moge odczytac BAR0+0x%03x -- POMINIETY\n",
+			skad, OM_R_MAILBOXINT);
+		return;
+	}
+	om_emrg(b, "doorbell (%s): BAR0+0x%03x: 0x%08x |= 0x1 -- start\n",
+		skad, OM_R_MAILBOXINT, przed);
+	if (om_bp_write32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, przed | OM_DB_H2D) != 0) {
+		om_blad(b, "doorbell (%s): zapis nie udal sie\n", skad);
+		return;
+	}
+	if (om_bp_read32(b, OM_PCIE2_BASE + OM_R_MAILBOXINT, &po) == 0)
+		om_odp(b, "doorbell (%s): readback 0x%08x (bit0 %s, bit8 %s)\n", skad, po,
+		       (po & OM_DB_H2D) ? "zatrzasniety (fw go jeszcze nie zdjal)" : "juz zdjety przez fw",
+		       (po & OM_INT_D2H) ? "USTAWIONY -- fw ma zgloszenie D2H" : "czysty");
+	if (po & OM_INT_D2H)
+		om_d2h_scan(b, "po doorbellu (R7)");
+}
+
+/* =============================================================== send/sendtrio */
+
+static void om_op_send(struct om_bridge *b, int argc, char **argv)
+{
+	u8 payload[OM_OLMSG_MAX_TOTAL];
+	u32 typ, len = 0, total, wr, off;
+	int i;
+
+	if (argc < 4) {
+		om_blad(b, "send: uzycie `send <typ_hex> <len_hex> <payload_hex|->`\n");
+		return;
+	}
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "send: brak zweryfikowanego bufora DMA (adres 0x%llx) -- nie ma gdzie zbudowac pierscienia H2D\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	if (kstrtouint(argv[1], 0, &typ) || kstrtouint(argv[2], 0, &len)) {
+		om_blad(b, "send: typ i len musza byc liczbami (hex z 0x)\n");
+		return;
+	}
+	if (len > sizeof(payload) || len + OM_OLMSG_HDR > OM_OLMSG_MAX_TOTAL) {
+		om_blad(b, "send: len %u B przekracza limit fw (total = len + 12 <= 0x%x; wiekszy komunikat zawiesza ISR fw w petli)\n",
+			len, OM_OLMSG_MAX_TOTAL);
+		return;
+	}
+	if (strcmp(argv[3], "-") != 0) {
+		const char *h = argv[3];
+
+		if (strlen(h) != (size_t)len * 2) {
+			om_blad(b, "send: payload ma %zu znakow, a len = %u B (oczekuje %u znakow hex)\n",
+				strlen(h), len, len * 2);
+			return;
+		}
+		for (i = 0; i < (int)len; i++) {
+			u8 hi = (h[i * 2] >= '0' && h[i * 2] <= '9') ? h[i * 2] - '0' :
+				(h[i * 2] >= 'a' && h[i * 2] <= 'f') ? h[i * 2] - 'a' + 10 :
+				(h[i * 2] >= 'A' && h[i * 2] <= 'F') ? h[i * 2] - 'A' + 10 : 0xff;
+			u8 lo = (h[i * 2 + 1] >= '0' && h[i * 2 + 1] <= '9') ? h[i * 2 + 1] - '0' :
+				(h[i * 2 + 1] >= 'a' && h[i * 2 + 1] <= 'f') ? h[i * 2 + 1] - 'a' + 10 :
+				(h[i * 2 + 1] >= 'A' && h[i * 2 + 1] <= 'F') ? h[i * 2 + 1] - 'A' + 10 : 0xff;
+
+			if (hi == 0xff || lo == 0xff) {
+				om_blad(b, "send: payload nie jest hexem (znak %d)\n", i * 2);
+				return;
+			}
+			payload[i] = (u8)((hi << 4) | lo);
+		}
+	}
+	total = OM_OLMSG_HDR + len;
+	wr = om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR);
+	if (wr + total > OM_RING_ROZMIAR) {
+		om_blad(b, "send: pierscien H2D pelny (wr=%u + %u B > 0x%x) -- zawijania nie implementujemy; poczekaj, az fw zuzyje (rd), albo `ringinit`\n",
+			wr, total, OM_RING_ROZMIAR);
+		return;
+	}
+	off = OM_RING_DATA_H2D + wr;
+	om_czekaj_pciedngl_open(b);
+	om_ring_msg(b, off, typ, 0, len, payload);
+	/* bariera przed publikacja indeksu -- odpowiednik __sync_synchronize()
+	 * z minihost.c:1765-1767; bez niej fw moglby zobaczyc `wr` przed danymi */
+	wmb();
+	om_buf_wr32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR, wr + total);
+	wmb();
+	om_odp(b, "send: typ 0x%08x len %u -> buf+0x%04x, publikacja wr = %u (bylo %u)\n",
+	       typ, len, off, wr + total, wr);
+	om_doorbell(b, "po send");
+}
+
+static void om_op_sendtrio(struct om_bridge *b, int argc, char **argv)
+{
+	static const u32 ltr[5] = { 60, 100, 3, 50, 20 };
+	u8 p1[OM_TRIO_TS_LEN], p2[OM_TRIO_EWT_LEN], p3[OM_TRIO_LTR_LEN];
+	u32 uptime;
+	u32 o1 = OM_RING_DATA_H2D;
+	u32 o2 = OM_RING_DATA_H2D + OM_OLMSG_HDR + OM_TRIO_TS_LEN;
+	u32 o3 = OM_RING_DATA_H2D + 2u * (OM_OLMSG_HDR + OM_TRIO_TS_LEN);
+	u32 i, k;
+	u32 wr_przed;
+
+	if (!b->dma_va || !b->dma_ok) {
+		om_blad(b, "sendtrio: brak zweryfikowanego bufora DMA (adres 0x%llx) -- nie ma gdzie zbudowac pierscienia H2D\n",
+			(unsigned long long)b->dma_fiz);
+		return;
+	}
+	/* uptime hosta w ms -- Apple bierze go bezposrednio przed wysylka
+	 * (`_osl_sysuptime()` @0x759c9); minihost: CLOCK_MONOTONIC
+	 * (minihost.c:894-905). ktime_get() = ten sam zegar. Payload liczymy
+	 * PO bramkach (doczekanie konsoli moze zajac sekundy). */
+	wr_przed = om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR);
+	om_emrg(b, "sendtrio: 3 komunikaty pod buf+0x%04x/0x%04x/0x%04x, publikacja wr = %u, JEDEN doorbell -- start\n",
+		o1, o2, o3, OM_TRIO_WR);
+	if (wr_przed)
+		om_blad(b, "sendtrio: UWAGA pierscien H2D nie byl pusty (wr = %u) -- trio Apple zaklada pusty pierscien i NADPISUJE jego poczatek; publikuje %u\n",
+			wr_przed, OM_TRIO_WR);
+	om_czekaj_pciedngl_open(b);
+	uptime = (u32)ktime_to_ms(ktime_get());
+	for (i = 0; i < 4; i++)
+		p1[i] = (u8)(uptime >> (8 * i));
+	for (i = 0; i < 4; i++)
+		p2[i] = (u8)(OM_TRIO_EWT_VAL >> (8 * i));
+	p3[0] = 0;	/* ltr_enabled  = 0 -- nasz host nie ma LTR (nota par.5.5) */
+	p3[1] = 0;	/* obff_enabled = 0 */
+	for (i = 0; i < 5; i++)
+		for (k = 0; k < 4; k++)
+			p3[2 + i * 4 + k] = (u8)(ltr[i] >> (8 * k));
+
+	om_ring_msg(b, o1, OM_TRIO_TYP_TS, 0, OM_TRIO_TS_LEN, p1);
+	om_ring_msg(b, o2, OM_TRIO_TYP_EWT, 0, OM_TRIO_EWT_LEN, p2);
+	om_ring_msg(b, o3, OM_TRIO_TYP_LTR, 0, OM_TRIO_LTR_LEN, p3);
+	om_odp(b, "sendtrio: #1 0x%08x len %u payload u32 = %u (0x%08x) = uptime hosta w ms\n",
+	       OM_TRIO_TYP_TS, OM_TRIO_TS_LEN, uptime, uptime);
+	om_odp(b, "sendtrio: #2 0x%08x len %u payload u32 = %u (iovar wowl_excess_wake_timeout)\n",
+	       OM_TRIO_TYP_EWT, OM_TRIO_EWT_LEN, OM_TRIO_EWT_VAL);
+	om_odp(b, "sendtrio: #3 0x%08x len %u payload 22 B: [0]=0 [1]=0 potem u32 %u %u %u %u %u\n",
+	       OM_TRIO_TYP_LTR, OM_TRIO_LTR_LEN, ltr[0], ltr[1], ltr[2], ltr[3], ltr[4]);
+	wmb();
+	om_buf_wr32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR, OM_TRIO_WR);
+	wmb();
+	om_odp(b, "sendtrio: publikacja wr = %u (readback %u) -- 16+16+34, NIE 50 (przy 50 fw czytalby uciety trzeci komunikat)\n",
+	       OM_TRIO_WR, om_buf_rd32(b, OM_RING_HDR_H2D + OM_RING_H2D_WR));
+	om_doorbell(b, "po trio");
+}
