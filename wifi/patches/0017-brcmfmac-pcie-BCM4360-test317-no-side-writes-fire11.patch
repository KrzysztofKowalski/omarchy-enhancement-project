+				    t277_ptr < devinfo->ci->ramsize) {
 					for (t277_j = 0;
 					     t277_j < BCM4360_T277_STRUCT_DWORDS;
 					     t277_j++)
@@ -4096,6 +4127,27 @@ static void brcmf_pcie_setup(struct device *dev, int ret,
 			goto fail;
 	}
 
+	/* BCM4360 test.317 fire #11 (no_olmsg): skip the ENTIRE post-release
+	 * olmsg side -- select_core, request_irq (incl. the test.312b MBM RMW
+	 * |=0x100), commonring hookup, brcmf_attach (preinit dcmds + the first
