+/* ==== BCM4360 test.315 R3a: strip the "boardtype=" var from NVRAM ====
+ * The buffer handed to brcmf_pcie_download_fw_nvram as (nvram, nvram_len)
+ * is the brcmf_fw_nvram_strip() output -- NUL-terminated "key=value"
+ * entries, zero padding up to a 4 B boundary, then a 4 B end token
+ * (firmware.c; the vars in the .txt file are the only NVRAM source here,
+ * there is no vars table in pcie.c). The fw consumes it as vars/varsz,
+ * both through the TCM copy (address = rambase+ramsize-nvram_len, token
+ * lands at TCM[ramsize-4]) and through the test276 shared_info snapshot
+ * (+0x020 varsz, +0x024..0x033 first 16 B). Stripping happens HERE, once,
+ * before both consumers; the buffer only SHRINKS (in-place compaction,
+ * the kzalloc'd parser buffer is larger than the stripped size), the
+ * padding and the end token are recomputed with the exact firmware.c
+ * formula. CPU-only, zero MMIO. */
+static void bcm4360_t315_strip_boardtype_var(u8 *nvram, u32 *nvram_len)
+{
+	u32 content_len;
+	u32 i = 0, j = 0;
+	bool found = false;
+
+	if (!nvram || *nvram_len < BCM4360_T315_BOARDTYPE_KEYLEN + 4)
+		return;
+
+	content_len = *nvram_len - sizeof(u32);	/* exclude the end token */
+
+	while (i < content_len && nvram[i]) {
+		u32 start = i;
+		u32 elen;
+
+		while (i < content_len && nvram[i])
+			i++;
+		/* entry = [start, i) plus its terminating NUL, when that NUL
+		 * is still inside the content region */
+		elen = (i < content_len) ? (i - start + 1) : (i - start);
+
+		if (elen >= BCM4360_T315_BOARDTYPE_KEYLEN &&
+		    !memcmp(&nvram[start], BCM4360_T315_BOARDTYPE_KEY,
+			    BCM4360_T315_BOARDTYPE_KEYLEN)) {
+			found = true;
+		} else {
+			memmove(&nvram[j], &nvram[start], elen);
+			j += elen;
+		}
+		if (i < content_len)
+			i++;		/* step over the entry NUL */
+	}
+
+	if (!found) {
+		pr_emerg("BCM4360 test.315: R3a no \"boardtype=\" var in the NVRAM buffer (len=%u) -- vars unchanged\n",
+			 *nvram_len);
+		return;
+	}
+
+	/* zero the compacted tail (removed entry, old terminator, old
+	 * padding), re-pad and rewrite the end token with the exact
+	 * brcmf_fw_nvram_strip() formula. */
+	memset(&nvram[j], 0, content_len - j);
+	{
+		u32 padded = roundup(j + 1, 4);
+		u32 token = padded / 4;
+
+		token = (~token << 16) | (token & 0x0000FFFF);
+		put_unaligned_le32(token, &nvram[padded]);
+		pr_emerg("BCM4360 test.315: R3a boardtype STRIPPED from NVRAM vars: len %u -> %u (token 0x%08x rewritten; vars16 = first 16 B unchanged region, varsz shrinks -- wlc_bmac_attach takes the err-15 branch, fw stays in dngl/offload)\n",
+			 *nvram_len, padded + sizeof(u32), token);
+		*nvram_len = padded + sizeof(u32);
+	}
+}
