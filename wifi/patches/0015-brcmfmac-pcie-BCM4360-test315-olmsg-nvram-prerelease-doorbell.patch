+/* ==== BCM4360 test.315: P3 pre-release read + P1 pre-release doorbell ====
+ * Called from brcmf_pcie_exit_download_state immediately BEFORE
+ * brcmf_chip_set_active, i.e. AFTER the test276 shared_info write and with
+ * the ARM core still halted/reset. The ONLY window in which the fw ever
+ * answered a host H2D doorbell (kimptoc test.28: MAILBOXINT:=0xFFFFFFFF
+ * inside pcie_mask_irqs, pre-release; the fw answered intstatus=0x300,
+ * mailboxint=0x03, console 1404 B -- the only such reaction in the whole
+ * project, ours included). Every MMIO op is a single windowed access
+ * bracketed by pr_emerg before/after (the "now" print is the last line
+ * when the machine dies on that op); the pre-release BAR0 read/write
+ * class is proven on the live device in experiment #1 fire 2 (T305
+ * pre-release MAILBOXMASK write + readback, WRITE_LANDED) and by every
+ * later windowed single (fires #6/#7). */
+static void bcm4360_t315_prerelease_probe(struct brcmf_pciedev_info *devinfo,
+					  u32 db_val)
+{
+	u32 t315_mbmask;
+	u32 t315_rd;
+
+	/* (P3) reset-state MAILBOXMASK, read-only: kimptoc T284 read
+	 * 0x318 here PRE-set_active (anomaly A0, kimptoc-test28-comparison
+	 * sec.4-A0) and 0 post-set_active (the ARM release clears the
+	 * mask); reproduce the read on our substrate. */
+	pr_emerg("BCM4360 test.315: P3 MAILBOXMASK read (BAR0+0x4C, ARM halted) now\n");
+	t315_mbmask = brcmf_pcie_read_reg32(devinfo,
+					    BRCMF_PCIE_PCIE2REG_MAILBOXMASK);
+	pr_emerg("BCM4360 test.315: P3 MAILBOXMASK=0x%08x (0x318 = kimptoc anomaly A0 reproduced; 0 = reset state)\n",
+		 t315_mbmask);
+
+	/* (P1) pre-release H2D doorbell: PLAIN write, NOT the |= RMW of
+	 * 0008/0013 (test.28 wrote MAILBOXINT:=value absolute, pre-release).
+	 * It latches into the fw-side mailbox while the ARM is halted and
+	 * the fw consumes it in the first milliseconds of boot -- the
+	 * T279 post-poll doorbell was dead in every test, fire #7
+	 * included. */
+	pr_emerg("BCM4360 test.315: P1 pre-release doorbell MAILBOXINT (BAR0+0x48) := 0x%08x now (LAST LINE if this write kills the machine)\n",
+		 db_val);
+	brcmf_pcie_write_reg32(devinfo, BRCMF_PCIE_PCIE2REG_MAILBOXINT,
+			       db_val);
+	pr_emerg("BCM4360 test.315: P1 doorbell posted -- readback now\n");
+	t315_rd = brcmf_pcie_read_reg32(devinfo,
+					BRCMF_PCIE_PCIE2REG_MAILBOXINT);
+	pr_emerg("BCM4360 test.315: P1 readback=0x%08x (db_val=0x%08x; ==db_val => latched unconsumed; 0 => cleared/consumed)\n",
+		 t315_rd, db_val);
+}
+
+/* ==== BCM4360 test.315: DISCRIMINATOR (immediately after set_active) ====
+ * The fire #9 verdict: single windowed BAR0 reads of the SB-side PCIe2
+ * intstatus/intmask (BAR0+0x20/0x24, pcie_core.h sbpcieregs; PCIE2 sits
+ * at BAR0@0 on this chip) and of the mailbox int/mask (BAR0+0x48/0x4C),
+ * plus one test277-class TCM read of the fw console wr_idx (si[+0x010]
+ * -> struct+0x08). Runs ALWAYS when test315=1, before the test.312 gate
+ * and before any 0012/0013 doorbell, so the evidence exists even if
+ * everything later wedges. SUCCESS (R3a hypothesis): intstatus latches
+ * D2H doorbell bits (~0x300, test.28), intmask armed by pciedngl_intrs_on
+ * (0x100, the ONLY fw-side writer, fw-boot-stall-analysis Q1) and/or
+ * console wr_idx > 0x27d. FAIL: intmask 0 + wr_idx 0x27d (637) = the
+ * frozen WFI state of fires #6-#8. */
+static void bcm4360_t315_discriminator(struct brcmf_pciedev_info *devinfo)
+{
+	u32 t315_intstatus;
+	u32 t315_intmask;
+	u32 t315_mbint;
+	u32 t315_mbmask;
+	u32 t315_wr = 0xFFFFFFFF;	/* 0xffffffff = ptr invalid at t~0 */
+	u32 t276_base = devinfo->ci->ramsize -
+			BCM4360_T276_SHARED_INFO_OFFSET;
+	u32 t315_ptr;
+
+	pr_emerg("BCM4360 test.315: discriminator SB intstatus read (BAR0+0x20) now\n");
+	t315_intstatus = brcmf_pcie_read_reg32(devinfo,
+					       BCM4360_OLMSG_SB_INTSTATUS);
+	pr_emerg("BCM4360 test.315: discriminator SB intstatus=0x%08x\n",
+		 t315_intstatus);
+
+	pr_emerg("BCM4360 test.315: discriminator SB intmask read (BAR0+0x24) now\n");
+	t315_intmask = brcmf_pcie_read_reg32(devinfo,
+					     BCM4360_OLMSG_SB_INTMASK);
+	pr_emerg("BCM4360 test.315: discriminator SB intmask=0x%08x (0x100 = pciedngl_intrs_on armed it => fw alive in dngl/offload)\n",
+		 t315_intmask);
+
+	pr_emerg("BCM4360 test.315: discriminator MAILBOXINT read (BAR0+0x48) now\n");
+	t315_mbint = brcmf_pcie_read_reg32(devinfo,
+					   BRCMF_PCIE_PCIE2REG_MAILBOXINT);
+	pr_emerg("BCM4360 test.315: discriminator MAILBOXINT=0x%08x\n",
+		 t315_mbint);
+
+	pr_emerg("BCM4360 test.315: discriminator MAILBOXMASK read (BAR0+0x4C) now\n");
+	t315_mbmask = brcmf_pcie_read_reg32(devinfo,
+					    BRCMF_PCIE_PCIE2REG_MAILBOXMASK);
+	pr_emerg("BCM4360 test.315: discriminator MAILBOXMASK=0x%08x\n",
+		 t315_mbmask);
+
+	/* console wr_idx, test277 mechanism (ptr from si[+0x010], wr_idx at
+	 * struct+0x08; TCM/BAR1 class proven in fires #6/#7). At t~0 the
+	 * ptr is often 0 (the fw publishes it ~10 ms later; the T276 poll
+	 * reports the t+2 s state). An invalid ptr skips only the second
+	 * read -- the DISCRIMINATOR line below prints regardless. */
+	pr_emerg("BCM4360 test.315: discriminator console ptr read (TCM si[+0x010]) now\n");
+	t315_ptr = brcmf_pcie_read_ram32(devinfo,
+					 t276_base +
+					 BCM4360_T276_SI_FW_STATUS);
+	pr_emerg("BCM4360 test.315: discriminator console ptr=0x%08x\n",
+		 t315_ptr);
+	if (t315_ptr && t315_ptr < devinfo->ci->ramsize) {
+		pr_emerg("BCM4360 test.315: discriminator console wr_idx read (TCM struct+0x08) now\n");
