+/* The vars pair in the host struct: the size @+0x20, the text @+0x24 (writer items
+ * 8/9 of the Apple host). 1:1 what test.338 did (patch 0031) -- the same
+ * content (bcm4360_vars_rev11_apple: 176 keys / 3783 B from the chip SPROM), the
+ * same full-text readback as proof the write LANDED. It differs
+ * only in the gate: here it enters via bcm4360_ol77_path(), with no parameter.
+ * base = offset RELATIVE to rambase. Returns the number of mismatched readback
+ * bytes (0 = OK; UINT_MAX = the block did not run -- gates). */
+static u32 bcm4360_ol77_write_vars(struct brcmf_pciedev_info *devinfo, u32 base)
+{
+	size_t len = sizeof(bcm4360_vars_rev11_apple);
+	u32 dwords = 0;
+	u32 mism = 0;
+	u32 i;
+
+	/* Gates BEFORE the first MMIO (as in test.338). */
+	if (len > BCM4360_T338_VARS_MAX) {
+		pr_emerg("BCM4360 patch 0036: sizeof(vars)=%zu > 0x%x (MAXSZ_NVRAM_VARS) -- SKIP, zero MMIO\n",
+			 len, BCM4360_T338_VARS_MAX);
+		return UINT_MAX;
+	}
+	if (BCM4360_OL77_VARS_OFF + len > BCM4360_OL77_CONTRACT_SIZE) {
+		pr_emerg("BCM4360 patch 0036: vars (+0x%x, %zu B) do not fit in the host struct (0x%x B) -- SKIP, zero MMIO\n",
+			 BCM4360_OL77_VARS_OFF, len,
+			 BCM4360_OL77_CONTRACT_SIZE);
+		return UINT_MAX;
+	}
+	if (base + BCM4360_OL77_VARS_OFF + len > devinfo->ci->ramsize) {
+		pr_emerg("BCM4360 patch 0036: vars at 0x%05x+0x%x exceed ramsize 0x%05x -- SKIP, zero MMIO\n",
+			 base, BCM4360_OL77_VARS_OFF, devinfo->ci->ramsize);
+		return UINT_MAX;
+	}
+
+	pr_emerg("BCM4360 patch 0036 (gap 3): vars into the apple contract: vars_size=0x%zx @TCM[0x%05x], text @TCM[0x%05x..0x%05x] (176 keys from the chip SPROM; no top-of-TCM write)\n",
+		 len, base + BCM4360_OL77_VARS_SIZE_OFF,
+		 base + BCM4360_OL77_VARS_OFF,
+		 base + BCM4360_OL77_VARS_OFF + (u32)len - 1);
+
+	brcmf_pcie_write_ram32(devinfo, base + BCM4360_OL77_VARS_SIZE_OFF,
+			       (u32)len);
+
+	/* Text dword by dword; the last dword is assembled from 3 bytes +
+	 * one zero that ALREADY lies beyond the length given in +0x20 -- the
+	 * fw knows the length from +0x20, not from a NUL scan. */
+	for (i = 0; i < (u32)len; i += 4) {
+		u32 w = 0;
+		u32 k;
+
+		for (k = 0; k < 4; k++) {
+			size_t idx = (size_t)i + k;
+
+			if (idx < len)
+				w |= (u32)(u8)bcm4360_vars_rev11_apple[idx]
+				     << (8 * k);
+		}
+		brcmf_pcie_write_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF + i, w);
+		dwords++;
+	}
+
+	/* Full-text readback and comparison against the table: proof the write
+	 * LANDED, not just that it was issued. */
+	for (i = 0; i < (u32)len; i += 4) {
+		u32 rb = brcmf_pcie_read_ram32(devinfo,
+					       base + BCM4360_OL77_VARS_OFF + i);
+		u32 k;
+
+		for (k = 0; k < 4; k++) {
+			size_t idx = (size_t)i + k;
+			u8 b = 0;
+
+			if (idx < len)
+				b = (u8)bcm4360_vars_rev11_apple[idx];
+			if ((u8)(rb >> (8 * k)) != b)
+				mism++;
+		}
+	}
+
+	pr_emerg("BCM4360 patch 0036 (gap 3): readback: vars_size@+0x20=0x%08x (exp 0x%zx) dwords=0x%x mismatched-bytes=%u first=0x%08x last=0x%08x\n",
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_SIZE_OFF),
+		 len, dwords, mism,
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF),
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF +
+				       (((u32)len - 1) & ~3u)));
+
+	return mism;
+}
