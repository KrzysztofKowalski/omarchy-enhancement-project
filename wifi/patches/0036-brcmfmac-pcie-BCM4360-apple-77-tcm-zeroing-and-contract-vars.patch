+ *      EXACTLY the TRAP record slot (+0x5ED8..+0x5F5C) and marker_end (+0x5F5C),
+ *      the contract fields the fw reads and validates in
+ *      _wlc_ol_validate_shared_info. That is why on the 7.77 path the write at
+ *      the top of TCM is SKIPPED and vars go to contract+0x24 -- with the same content,
+ *      as in test.338 (3783 B from the chip SPROM, not 212 B of .txt filler).
+ *
+ * Gate: bcm4360_ol77_path() = chip 4360 + 7.77 image (test321_fw_apple 2/3).
+ * For images 0/1 (original 6.30.223 and 7.15.124.12) the code is bit-for-bit old.
+ * ZERO D11 access (HARD RULE, project rulebook item 7). */
+#define BCM4360_OL77_CONTRACT_SIZE	(BCM4360_T336_HOST_SHARED_SIZE)	/* 0x5F80 */
+#define BCM4360_OL77_VARS_SIZE_OFF	(BCM4360_T336_SI_VARS_SIZE)	/* +0x20 */
+#define BCM4360_OL77_VARS_OFF		(BCM4360_T336_SI_VARS)		/* +0x24 */
+#define BCM4360_OL77_ZERO_CHUNK		4096	/* B per one zeroing write */
