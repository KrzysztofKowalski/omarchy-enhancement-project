+/* Para vars w strukturze hosta: rozmiar @+0x20, tekst @+0x24 (writer items
+ * 8/9 hosta Apple). 1:1 to samo, co robil test.338 (patch 0031) -- ta sama
+ * tresc (bcm4360_vars_rev11_apple: 176 kluczy / 3783 B z SPROMu ukladu), ten
+ * sam odczyt zwrotny calego tekstu jako dowod, ze zapis DOTARL. Rozni sie
+ * tylko bramka: tu wchodzi sie z bcm4360_ol77_path(), bez parametru.
+ * base = offset WZGLEDNY wobec rambase. Zwraca liczbe niezgodnych bajtow
+ * odczytu zwrotnego (0 = OK; UINT_MAX = blok nie wszedl -- bramki). */
+static u32 bcm4360_ol77_write_vars(struct brcmf_pciedev_info *devinfo, u32 base)
+{
+	size_t len = sizeof(bcm4360_vars_rev11_apple);
+	u32 dwords = 0;
+	u32 mism = 0;
+	u32 i;
+
+	/* Bramki PRZED pierwszym MMIO (jak w tescie.338). */
+	if (len > BCM4360_T338_VARS_MAX) {
+		pr_emerg("BCM4360 patch 0036: sizeof(vars)=%zu > 0x%x (MAXSZ_NVRAM_VARS) -- SKIP, zero MMIO\n",
+			 len, BCM4360_T338_VARS_MAX);
+		return UINT_MAX;
+	}
+	if (BCM4360_OL77_VARS_OFF + len > BCM4360_OL77_CONTRACT_SIZE) {
+		pr_emerg("BCM4360 patch 0036: vars (+0x%x, %zu B) nie mieszcza sie w strukturze hosta (0x%x B) -- SKIP, zero MMIO\n",
+			 BCM4360_OL77_VARS_OFF, len,
+			 BCM4360_OL77_CONTRACT_SIZE);
+		return UINT_MAX;
+	}
+	if (base + BCM4360_OL77_VARS_OFF + len > devinfo->ci->ramsize) {
+		pr_emerg("BCM4360 patch 0036: vars na 0x%05x+0x%x przekraczaja ramsize 0x%05x -- SKIP, zero MMIO\n",
+			 base, BCM4360_OL77_VARS_OFF, devinfo->ci->ramsize);
+		return UINT_MAX;
+	}
+
+	pr_emerg("BCM4360 patch 0036 (luka 3): vars do kontraktu apple: vars_size=0x%zx @TCM[0x%05x], tekst @TCM[0x%05x..0x%05x] (176 kluczy ze SPROMu ukladu; bez zapisu na czubku TCM)\n",
+		 len, base + BCM4360_OL77_VARS_SIZE_OFF,
+		 base + BCM4360_OL77_VARS_OFF,
+		 base + BCM4360_OL77_VARS_OFF + (u32)len - 1);
+
+	brcmf_pcie_write_ram32(devinfo, base + BCM4360_OL77_VARS_SIZE_OFF,
+			       (u32)len);
+
+	/* Tekst dword po dwordzie; ostatni dword jest skladany z 3 bajtow +
+	 * jednego zera, ktore lezy JUZ ZA dlugoscia podana w +0x20 -- fw zna
+	 * dlugosc z +0x20, nie ze skanu NUL. */
+	for (i = 0; i < (u32)len; i += 4) {
+		u32 w = 0;
+		u32 k;
+
+		for (k = 0; k < 4; k++) {
+			size_t idx = (size_t)i + k;
+
+			if (idx < len)
+				w |= (u32)(u8)bcm4360_vars_rev11_apple[idx]
+				     << (8 * k);
+		}
+		brcmf_pcie_write_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF + i, w);
+		dwords++;
+	}
+
+	/* Odczyt zwrotny CALEGO tekstu i porownanie z tablica: dowod, ze zapis
+	 * DOTARL, a nie tylko ze zostal wydany. */
+	for (i = 0; i < (u32)len; i += 4) {
+		u32 rb = brcmf_pcie_read_ram32(devinfo,
+					       base + BCM4360_OL77_VARS_OFF + i);
+		u32 k;
+
+		for (k = 0; k < 4; k++) {
+			size_t idx = (size_t)i + k;
+			u8 b = 0;
+
+			if (idx < len)
+				b = (u8)bcm4360_vars_rev11_apple[idx];
+			if ((u8)(rb >> (8 * k)) != b)
+				mism++;
+		}
+	}
+
+	pr_emerg("BCM4360 patch 0036 (luka 3): readback: vars_size@+0x20=0x%08x (exp 0x%zx) dwordow=0x%x bajtow-niezgodnych=%u pierwszy=0x%08x ostatni=0x%08x\n",
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_SIZE_OFF),
+		 len, dwords, mism,
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF),
+		 brcmf_pcie_read_ram32(devinfo,
+				       base + BCM4360_OL77_VARS_OFF +
+				       (((u32)len - 1) & ~3u)));
+
+	return mism;
+}
