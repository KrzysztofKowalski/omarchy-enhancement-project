+/* ==== BCM4360 patch 0036: 7.77 substrate (gaps 7 and 3) ==== */
+
+/* 7.77 path: the Apple image (test321_fw_apple = 2 = 7.77.0.0, 3 = 7.77.61.0)
+ * on our card. Only there does the Apple host contract apply -- and only there
+ * may we move the TCM substrate. For images 0 (original) and 1 (7.15)
+ * this function returns false and all patch 0036 code is inactive (behaviour
+ * bit for bit as in patch 0035). */
+static bool bcm4360_ol77_path(struct brcmf_pciedev_info *devinfo)
+{
+	return devinfo->ci->chip == BRCM_CC_4360_CHIP_ID &&
+	       (bcm4360_test321_fw_apple == 2 || bcm4360_test321_fw_apple == 3);
+}
+
+/* Zero the TCM range [from, to) (offsets RELATIVE to rambase, the same
+ * convention as brcmf_pcie_read_ram32/write_ram32; the image copy uses
+ * absolute offsets, because brcmf_pcie_copy_mem_to_dev does not add rambase -- for
+ * 4360 rambase = 0, but we stick to the convention). Write path the same as the
+ * image copy (brcmf_pcie_copy_mem_to_dev: 32-bit iowrite32, the 4360 requirement
+ * from patch 0003 -- 64-bit memcpy_toio hangs the bus). The zero buffer is a
+ * SINGLE 4 KiB one, so zeroing the extra ~179 KB of TCM costs no range-sized
+ * allocation. Returns the number of bytes written (0 = failed / empty range). */
+static u32 bcm4360_ol77_zero_range(struct brcmf_pciedev_info *devinfo,
+				   u32 from, u32 to)
+{
+	u8 *zero;
+	u32 left;
+	u32 done = 0;
+	u32 chunk;
+
+	if (to <= from)
+		return 0;
+
+	left = to - from;
+	chunk = min_t(u32, left, BCM4360_OL77_ZERO_CHUNK);
+	zero = kzalloc(chunk, GFP_KERNEL);
+	if (!zero) {
+		pr_emerg("BCM4360 patch 0036: kzalloc(%u) FAILED -- range [0x%05x,0x%05x) NOT zeroed (the fw will see garbage from the previous run)\n",
+			 chunk, from, to);
+		return 0;
+	}
+
+	while (left) {
+		chunk = min_t(u32, left, BCM4360_OL77_ZERO_CHUNK);
+		brcmf_pcie_copy_mem_to_dev(devinfo,
+					   devinfo->ci->rambase + from + done,
+					   zero, chunk);
+		done += chunk;
+		left -= chunk;
+	}
+
+	kfree(zero);
+
+	return done;
+}
