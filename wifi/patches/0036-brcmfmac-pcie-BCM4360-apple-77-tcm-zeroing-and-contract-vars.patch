+/* ==== BCM4360 patch 0036: podloze 7.77 (luki 7 i 3) ==== */
+
+/* Sciezka 7.77: obraz Apple (test321_fw_apple = 2 = 7.77.0.0, 3 = 7.77.61.0)
+ * na naszej karcie. Tylko tam obowiazuje kontrakt hosta Apple -- i tylko tam
+ * wolno nam przestawic podloze TCM. Dla obrazow 0 (oryginal) i 1 (7.15)
+ * funkcja zwraca false i caly kod patch 0036 jest nieaktywny (zachowanie bit
+ * w bit jak patch 0035). */
+static bool bcm4360_ol77_path(struct brcmf_pciedev_info *devinfo)
+{
+	return devinfo->ci->chip == BRCM_CC_4360_CHIP_ID &&
+	       (bcm4360_test321_fw_apple == 2 || bcm4360_test321_fw_apple == 3);
+}
+
+/* Zerowanie zakresu [from, to) TCM (offsety WZGLEDNE wobec rambase, ta sama
+ * umowa co brcmf_pcie_read_ram32/write_ram32; kopia obrazu uzywa offsetow
+ * absolutnych, bo brcmf_pcie_copy_mem_to_dev nie dodaje rambase -- dla 4360
+ * rambase = 0, ale trzymamy sie umowy). Droga zapisu ta sama, co kopia obrazu
+ * (brcmf_pcie_copy_mem_to_dev: 32-bit iowrite32, wymog 4360 z patcha 0003 --
+ * 64-bit memcpy_toio wiesza magistrale). Bufor zer jest JEDEN, 4 KiB, wiec
+ * zero dodatkowych ~179 KB TCM nie kosztuje alokacji rozmiaru zakresu.
+ * Zwraca liczbe zapisanych bajtow (0 = nie udalo sie / zakres pusty). */
+static u32 bcm4360_ol77_zero_range(struct brcmf_pciedev_info *devinfo,
+				   u32 from, u32 to)
+{
+	u8 *zero;
+	u32 left;
+	u32 done = 0;
+	u32 chunk;
+
+	if (to <= from)
+		return 0;
+
+	left = to - from;
+	chunk = min_t(u32, left, BCM4360_OL77_ZERO_CHUNK);
+	zero = kzalloc(chunk, GFP_KERNEL);
+	if (!zero) {
+		pr_emerg("BCM4360 patch 0036: kzalloc(%u) FAILED -- zakres [0x%05x,0x%05x) NIE wyzerowany (fw zobaczy smieci z poprzedniego przebiegu)\n",
+			 chunk, from, to);
+		return 0;
+	}
+
+	while (left) {
+		chunk = min_t(u32, left, BCM4360_OL77_ZERO_CHUNK);
+		brcmf_pcie_copy_mem_to_dev(devinfo,
+					   devinfo->ci->rambase + from + done,
+					   zero, chunk);
+		done += chunk;
+		left -= chunk;
+	}
+
+	kfree(zero);
+
+	return done;
+}
