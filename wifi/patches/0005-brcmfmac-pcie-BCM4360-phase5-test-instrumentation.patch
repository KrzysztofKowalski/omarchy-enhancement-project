+/* Forward decls for the BCM4360 probe helpers below (defined later in
+ * this file, after the register-access helpers). */
+static void brcmf_pcie_select_core(struct brcmf_pciedev_info *devinfo,
+				   u16 coreid);
+static void brcmf_pcie_intr_enable(struct brcmf_pciedev_info *devinfo);
