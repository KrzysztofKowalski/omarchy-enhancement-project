+/* BCM4360 test.278: re-read console struct at struct_ptr, validate, dump
+ * [buf_addr + *prev_idx .. buf_addr + write_idx) as ASCII-escaped 128 B
+ * chunks (capped at 1024 B per call), advance *prev_idx. On any validation
+ * failure or empty delta, log a one-line reason and return. */
+static void
+bcm4360_t278_dump_console_delta(struct brcmf_pciedev_info *devinfo,
+				const char *stage_tag,
+				u32 struct_ptr,
+				u32 *prev_idx_p)
+{
+	u32 t278_struct[BCM4360_T277_STRUCT_DWORDS];
+	u32 buf_addr, buf_size, write_idx;
+	u32 prev = *prev_idx_p;
+	u32 delta, to_dump, i, off;
+
+	if (struct_ptr == 0 || struct_ptr >= devinfo->ci->ramsize) {
+		pr_emerg("BCM4360 test.278: %s struct_ptr 0x%08x invalid; skipping\n",
+			 stage_tag, struct_ptr);
+		return;
+	}
+	for (i = 0; i < BCM4360_T277_STRUCT_DWORDS; i++)
+		t278_struct[i] = brcmf_pcie_read_ram32(devinfo,
+						       struct_ptr + i * 4);
+	buf_addr  = t278_struct[0];
+	buf_size  = t278_struct[1];
+	write_idx = t278_struct[2];
+	if (buf_addr == 0 || buf_addr >= devinfo->ci->ramsize ||
+	    buf_size == 0 || buf_size > devinfo->ci->ramsize ||
+	    write_idx > buf_size) {
+		pr_emerg("BCM4360 test.278: %s struct invalid (buf_addr=0x%08x buf_size=0x%08x wr_idx=0x%08x); skipping\n",
+			 stage_tag, buf_addr, buf_size, write_idx);
+		return;
+	}
+	if (write_idx == prev) {
+		pr_emerg("BCM4360 test.278: %s no new log (wr_idx=%u unchanged)\n",
+			 stage_tag, write_idx);
+		return;
+	}
+	if (write_idx < prev) {
+		/* Ring wrapped or reset. Log and restart from 0. */
+		pr_emerg("BCM4360 test.278: %s wr_idx=%u < prev=%u (wrap or reset); restarting cursor at 0\n",
+			 stage_tag, write_idx, prev);
+		prev = 0;
+	}
+	delta = write_idx - prev;
+	to_dump = min_t(u32, delta, (u32)BCM4360_T278_MAX_BYTES_PER_CALL);
+	pr_emerg("BCM4360 test.278: %s wr_idx=%u prev=%u delta=%u dumping=%u bytes\n",
+		 stage_tag, write_idx, prev, delta, to_dump);
+
+	for (off = 0; off < to_dump; off += BCM4360_T278_CHUNK_BYTES) {
+		u8 chunk[BCM4360_T278_CHUNK_BYTES];
+		u32 *u32p = (u32 *)chunk;
+		u32 this_bytes = min_t(u32, (u32)BCM4360_T278_CHUNK_BYTES,
+				       to_dump - off);
+		u32 this_dwords = (this_bytes + 3) / 4;
+		u32 j;
+
+		for (j = 0; j < this_dwords; j++)
+			u32p[j] = brcmf_pcie_read_ram32(
+				devinfo, buf_addr + prev + off + j * 4);
+		pr_emerg("BCM4360 test.278: %s chunk@+%u (%u B): %*pE\n",
+			 stage_tag, prev + off, this_bytes,
+			 this_bytes, chunk);
+	}
+	if (delta > BCM4360_T278_MAX_BYTES_PER_CALL)
+		pr_emerg("BCM4360 test.278: %s ... truncated %u bytes (wr_idx=%u, dumped up to %u)\n",
+			 stage_tag, delta - BCM4360_T278_MAX_BYTES_PER_CALL,
+			 write_idx,
+			 prev + BCM4360_T278_MAX_BYTES_PER_CALL);
+	*prev_idx_p = write_idx;
+}
+
+/* BCM4360 test.298: walk the RTE scheduler ISR list at TCM[0x629A4],
+ * log each node {next, fn, arg, mask}, then sched_ctx[+0xCC] and the
+ * pending-events word. BAR2-only (no BAR0/select_core/wrapper MMIO). */
+#define BCM4360_T298_ISR_WALK(tag) do { \
+	if (bcm4360_test298_isr_walk) { \
+		u32 _t298_head = brcmf_pcie_read_ram32(devinfo, \
+			BCM4360_T298_LIST_HEAD_ADDR); \
+		u32 _t298_sched = brcmf_pcie_read_ram32(devinfo, \
+			BCM4360_T298_SCHED_PTR_ADDR); \
+		u32 _t298_node = _t298_head; \
+		u32 _t298_n; \
+		u32 _t298_cc = 0xFFFFFFFF; \
+		u32 _t298_evp = 0, _t298_pending = 0; \
+		pr_emerg("BCM4360 test.298: %s head=0x%08x sched_ctx=0x%08x\n", \
+			 tag, _t298_head, _t298_sched); \
+		for (_t298_n = 0; _t298_n < BCM4360_T298_MAX_NODES; _t298_n++) { \
+			u32 _t298_next, _t298_fn, _t298_arg, _t298_mask; \
+			if (_t298_node == 0 || \
+			    _t298_node >= BCM4360_T298_RAMSIZE_BOUND) { \
+				pr_emerg("BCM4360 test.298: %s node[%u] end ptr=0x%08x\n", \
+					 tag, _t298_n, _t298_node); \
+				break; \
+			} \
+			_t298_next = brcmf_pcie_read_ram32(devinfo, \
+				_t298_node + 0x0); \
+			_t298_fn   = brcmf_pcie_read_ram32(devinfo, \
+				_t298_node + 0x4); \
+			_t298_arg  = brcmf_pcie_read_ram32(devinfo, \
+				_t298_node + 0x8); \
+			_t298_mask = brcmf_pcie_read_ram32(devinfo, \
+				_t298_node + 0xC); \
+			pr_emerg("BCM4360 test.298: %s node[%u]@0x%08x next=0x%08x fn=0x%08x arg=0x%08x mask=0x%08x\n", \
+				 tag, _t298_n, _t298_node, _t298_next, \
+				 _t298_fn, _t298_arg, _t298_mask); \
+			_t298_node = _t298_next; \
+		} \
+		if (_t298_sched != 0 && \
+		    _t298_sched < BCM4360_T298_RAMSIZE_BOUND) { \
+			_t298_cc = brcmf_pcie_read_ram32(devinfo, \
+				_t298_sched + 0xCC); \
+			_t298_evp = brcmf_pcie_read_ram32(devinfo, \
+				_t298_sched + 0x358); \
+			if (_t298_evp != 0 && \
+			    _t298_evp < BCM4360_T298_RAMSIZE_BOUND) \
+				_t298_pending = brcmf_pcie_read_ram32(devinfo, \
+					_t298_evp + 0x100); \
+		} \
+		pr_emerg("BCM4360 test.298: %s SUMMARY count=%u sched_cc=0x%08x events_p=0x%08x pending=0x%08x\n", \
+			 tag, _t298_n, _t298_cc, _t298_evp, _t298_pending); \
+	} \
+} while (0)
+
+/* BCM4360 test.305: pre-set_active MAILBOXMASK enable with explicit
+ * select_core(PCIE2) before brcmf_pcie_intr_enable (bcmdhd pattern:
+ * si_corereg selects the bus core before writing PCIMailBoxMask). */
+static void bcm4360_t305_premask_probe(struct brcmf_pciedev_info *devinfo)
+{
+	u32 win_before, win_after, mbm_pre, mbm_post;
+	u32 expected = devinfo->reginfo->int_d2h_db |
+		       devinfo->reginfo->int_fn0;
+	const char *verdict;
+
+	pci_read_config_dword(devinfo->pdev, BRCMF_PCIE_BAR0_WINDOW,
+			      &win_before);
+	brcmf_pcie_select_core(devinfo, BCMA_CORE_PCIE2);
+	pci_read_config_dword(devinfo->pdev, BRCMF_PCIE_BAR0_WINDOW,
+			      &win_after);
+	pr_emerg("BCM4360 test.305: BAR0_WINDOW before=0x%08x after=0x%08x (expect PCIE2 core base 0x18102000)\n",
+		 win_before, win_after);
+	mbm_pre = brcmf_pcie_read_reg32(devinfo,
+					devinfo->reginfo->mailboxmask);
+	pr_emerg("BCM4360 test.305: pre-enable MAILBOXMASK=0x%08x (expect 0x318 if PCIE2 reachable)\n",
+		 mbm_pre);
+	brcmf_pcie_intr_enable(devinfo);
+	mbm_post = brcmf_pcie_read_reg32(devinfo,
+					 devinfo->reginfo->mailboxmask);
+	if (mbm_post == expected)
+		verdict = "WRITE_LANDED";
+	else if (mbm_post == mbm_pre)
+		verdict = "WRITE_DROPPED";
+	else
+		verdict = "UNEXPECTED_VALUE";
+	pr_emerg("BCM4360 test.305: SUMMARY win_before=0x%08x win_after=0x%08x mbm_pre=0x%08x mbm_post=0x%08x verdict=%s\n",
+		 win_before, win_after, mbm_pre, mbm_post, verdict);
+}
+
+/* BCM4360 test.306: read-only PCI config dump 0x40..0xFF (48 dwords) with
+ * the vendor-area 0x94/0xB4/0xB8 highlighted; three stages. */
+static void bcm4360_t306_cfg_dump(struct brcmf_pciedev_info *devinfo,
+				  const char *stage)
+{
+	static u32 s_cfg94[3], s_cfgB4[3], s_cfgB8[3];
+	static int s_idx;
+	u32 cfg94, cfgB4, cfgB8;
+	int i, j;
+
+	for (i = 0; i < 6; i++) {
+		u32 d[8];
+		u32 base = 0x40 + i * 0x20;
+
+		for (j = 0; j < 8; j++)
+			pci_read_config_dword(devinfo->pdev, base + j * 4,
+					      &d[j]);
+		pr_emerg("BCM4360 test.306: %s cfg[0x%02x..0x%02x] %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 stage, base, base + 0x1c, d[0], d[1], d[2], d[3],
+			 d[4], d[5], d[6], d[7]);
+	}
+	pci_read_config_dword(devinfo->pdev, 0x94, &cfg94);
+	pci_read_config_dword(devinfo->pdev, 0xB4, &cfgB4);
+	pci_read_config_dword(devinfo->pdev, 0xB8, &cfgB8);
+	if (s_idx < 3) {
+		s_cfg94[s_idx] = cfg94;
+		s_cfgB4[s_idx] = cfgB4;
+		s_cfgB8[s_idx] = cfgB8;
+	}
+	s_idx++;
+	pr_emerg("BCM4360 test.306: %s SUMMARY cfg94=0x%08x cfgB4=0x%08x cfgB8=0x%08x\n",
+		 stage, cfg94, cfgB4, cfgB8);
+	if (s_idx >= 3)
+		pr_emerg("BCM4360 test.306: SUMMARY cfg94=[0x%08x/0x%08x/0x%08x] cfgB4=[0x%08x/0x%08x/0x%08x] cfgB8=[0x%08x/0x%08x/0x%08x] (stages: pre-set_active/post-set_active/post-T276-poll)\n",
+			 s_cfg94[0], s_cfg94[1], s_cfg94[2],
+			 s_cfgB4[0], s_cfgB4[1], s_cfgB4[2],
+			 s_cfgB8[0], s_cfgB8[1], s_cfgB8[2]);
+}
+
+
 static void
 brcmf_pcie_copy_dev_tomem(struct brcmf_pciedev_info *devinfo, u32 mem_offset,
 			  void *dstaddr, u32 len)
@@ -1750,6 +2050,127 @@ static int brcmf_pcie_download_fw_nvram(struct brcmf_pciedev_info *devinfo,
 			  devinfo->nvram_name);
 	}
 
+	/* ==== BCM4360 phase5 test instrumentation: pre-ARM-release ==== */
+	if (devinfo->ci->chip == BRCM_CC_4360_CHIP_ID) {
+		if (bcm4360_test276_shared_info) {
+			u32 t276_base = devinfo->ci->ramsize -
+					BCM4360_T276_SHARED_INFO_OFFSET;
+			void *t276_buf = NULL;
+			dma_addr_t t276_dma = 0;
+			u32 t276_i;
+
+			/* test.277: pre-write dump of the Phase 4B observed
+			 * console struct pointer 0x9af88. */
+			if (bcm4360_test277_console_decode) {
+				u32 t277_struct[BCM4360_T277_STRUCT_DWORDS];
+				u32 t277_j;
+
+				for (t277_j = 0;
+				     t277_j < BCM4360_T277_STRUCT_DWORDS;
+				     t277_j++)
+					t277_struct[t277_j] =
+						brcmf_pcie_read_ram32(
+							devinfo,
+							0x9af88 +
+							t277_j * 4);
+				pr_emerg("BCM4360 test.277: PRE-WRITE struct@0x9af88 buf_addr=0x%08x buf_size=0x%08x write_idx=0x%08x read_addr=0x%08x\n",
+					 t277_struct[0], t277_struct[1],
+					 t277_struct[2], t277_struct[3]);
+			}
+
+			t276_buf = dma_alloc_coherent(&devinfo->pdev->dev,
+						      BCM4360_T276_OLMSG_BUF_SIZE,
+						      &t276_dma, GFP_KERNEL);
+			if (!t276_buf) {
+				pr_emerg("BCM4360 test.276: dma_alloc_coherent FAILED; skipping shared_info write\n");
+			} else {
+				__le32 *p = (__le32 *)t276_buf;
+
+				memset(t276_buf, 0, BCM4360_T276_OLMSG_BUF_SIZE);
+				/* olmsg ring header: ring0 (host->fw),
+				 * ring1 (fw->host). Each {data_off, size,
