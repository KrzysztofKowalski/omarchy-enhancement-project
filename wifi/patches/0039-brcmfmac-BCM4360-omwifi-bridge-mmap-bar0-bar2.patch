+/* =============================================== mmap of BAR0/BAR2 for userspace
+ *
+ * WHY THROUGH THE MODULE, NOT THROUGH sysfs: the kernel is built with
+ * CONFIG_STRICT_DEVMEM=y AND CONFIG_IO_STRICT_DEVMEM=y, and there is no
+ * `iomem=relaxed` in the cmdline. Result: an mmap on the card's /sys/bus/pci/devices/.../resourceN,
+ * which is BUSY -- and it is, because in probe we do pci_request_regions() -- ends
+ * in -EINVAL (drivers/pci/pci-sysfs.c:1132-1134 -> iomem_is_exclusive ->
+ * kernel/resource.c:1918-1924; `strict_iomem_checks = 1` from CONFIG_STRICT_DEVMEM).
+ * Measured 12.09.2026: the userspace tool died on
+ * "mmap resource2: Invalid argument" BEFORE the first MMIO (nothing
+ * went to the card). The bridge therefore exposes THE SAME BARs through mmaps of its own nodes:
+ * that is the driver path, without the strict-devm gate, and without weakening the kernel.
+ *
+ * Agreement (the other side: the userspace tool, open_card()):
+ *   /dev/omwifi      + mmap(offset 0) = BAR0 (0x8000 B: PCIE2 + backplane window)
+ *   /dev/omwifi-tcm  + mmap(offset 0) = BAR2 (0x200000 B: RAM fw / TCM)
+ *
+ * BAR0 GATE: only with `irq off`. The ISR (om_isr_*) reads and W1C-writes BAR0 WITHOUT
+ * om_lock, and BAR0 is a WINDOW onto the backplane -- if an armed interrupt hit
+ * at a moment when userspace has the window switched to another core (e.g. the D11 page),
+ * the ISR would read and W1C-write THAT core's register. Hence both ways:
+ * the BAR0 mmap refuses at `irq on`, and `irq on` refuses while any
+ * BAR0 mmap is alive. BAR2 (TCM) has no gate -- it is plain memory, without a window and without
+ * any ISR involvement.
+ */
+
+static void om_vma_zamknij(struct vm_area_struct *vma)
+{
+	mutex_lock(&om_lock);
+	if (om && om->bar0_mapy > 0)
+		om->bar0_mapy--;
+	mutex_unlock(&om_lock);
+}
+
+static const struct vm_operations_struct om_vm_ops = {
+	.close = om_vma_zamknij,
+};
+
+static int om_mmap_bar(struct file *f, struct vm_area_struct *vma, int bar)
+{
+	struct om_bridge *b;
+	unsigned long len = vma->vm_end - vma->vm_start;
+	resource_size_t rozmiar = 0;
+	int err = 0;
+
+	if (mutex_lock_interruptible(&om_lock))
+		return -ERESTARTSYS;
+	b = om;
+	if (!b || !b->bar0 || !b->bar2) {
+		mutex_unlock(&om_lock);
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: the bridge does not hold the card\n", bar);
+		return -ENODEV;
+	}
+	rozmiar = pci_resource_len(b->pdev, bar);
+	if (vma->vm_pgoff || !len || len > rozmiar) {
+		err = -EINVAL;
+		goto wyjdz;
+	}
+	if (bar == 0 && b->irq_on) {
+		err = -EBUSY;
+		goto wyjdz;
+	}
+	/* pgprot_device: the same memory type as pci_iomap above (x86: UC-), otherwise
+	 * x86/PAT would refuse the second mapping (-EBUSY "conflicting memory types"). */
+	if (remap_pfn_range(vma, vma->vm_start,
+			    (unsigned long)(pci_resource_start(b->pdev, bar) >> PAGE_SHIFT),
+			    len, pgprot_device(vma->vm_page_prot))) {
+		err = -EAGAIN;
+		goto wyjdz;
+	}
+	vma->vm_ops = &om_vm_ops;
+	if (bar == 0)
+		b->bar0_mapy++;
+	/* Log without the response buffer (b = NULL): mmap is not a command and cannot
+	 * eat a response waiting for `cat /dev/omwifi`. */
+	om_linia(NULL, 2, OM_NAZWA ": mmap: BAR%d 0x%lx B -> userspace%s\n",
+		 bar, len,
+		 bar == 0 ? " (BAR0 = window: as long as this mapping lives, `irq on` will refuse)"
+			  : " (TCM)");
+	mutex_unlock(&om_lock);
+	return 0;
+
+wyjdz:
+	if (err == -EBUSY)
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR0: REFUSAL -- the IRQ is armed (`irq on`), and BAR0 is a window the ISR reads and W1C-writes without om_lock. Do `irq off` and retry.\n");
+	else if (err == -EINVAL)
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: bad parameters (pgoff=0x%lx, len=0x%lx, the BAR has 0x%llx B) -- agreement: offset 0, len <= the BAR size\n",
+			 bar, vma->vm_pgoff, len, (unsigned long long)rozmiar);
+	else
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: remap_pfn_range failed (0x%lx B @0x%llx)\n",
+			 bar, len, (unsigned long long)pci_resource_start(b->pdev, bar));
+	mutex_unlock(&om_lock);
+	return err;
+}
+
+static int om_mmap_bar0(struct file *f, struct vm_area_struct *vma)
+{
+	return om_mmap_bar(f, vma, 0);
+}
+
+static int om_mmap_bar2(struct file *f, struct vm_area_struct *vma)
+{
+	return om_mmap_bar(f, vma, 2);
+}
+
 static const struct file_operations om_fops = {
 	.owner = THIS_MODULE,
 	.read = om_fop_read,
 	.write = om_fop_write,
+	.mmap = om_mmap_bar0,
+	.llseek = noop_llseek,
+};
+
+/* A separate node for BAR2 (TCM): the mmap on /dev/omwifi has a fixed meaning
+ * (BAR0), and recognizing the BAR by offset would be a guessing game. This node
+ * serves ONLY mmap -- read/write do not exist on it. */
+static const struct file_operations om_fops_tcm = {
+	.owner = THIS_MODULE,
+	.mmap = om_mmap_bar2,
 	.llseek = noop_llseek,
 };
 
