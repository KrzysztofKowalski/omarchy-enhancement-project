+/* =============================================== mmap BAR0/BAR2 dla userspace
+ *
+ * DLACZEGO PRZEZ MODUL, A NIE PRZEZ sysfs: jadro jest zbudowane z
+ * CONFIG_STRICT_DEVMEM=y ORAZ CONFIG_IO_STRICT_DEVMEM=y, a w cmdline nie ma
+ * `iomem=relaxed`. Skutek: mmap na /sys/bus/pci/devices/.../resourceN karty,
+ * ktora jest BUSY -- a jest, bo w probe robimy pci_request_regions() -- konczy
+ * sie -EINVAL (drivers/pci/pci-sysfs.c:1132-1134 -> iomem_is_exclusive ->
+ * kernel/resource.c:1918-1924; `strict_iomem_checks = 1` z CONFIG_STRICT_DEVMEM).
+ * Zmierzone 12.09.2026: `minihost d11 d11-ok --wykonaj` padl na
+ * "minihost: mmap resource2: Invalid argument" PRZED pierwszym MMIO (nic nie
+ * poszlo na karte). Most wystawia wiec TE SAME BAR-y przez mmap wlasnych wezlow:
+ * to droga sterownika, bez bramki strict-devm, i bez oslabiania jadra.
+ *
+ * Umowa (druga strona: minihost.c, otworz_karte()):
+ *   /dev/omwifi      + mmap(offset 0) = BAR0 (0x8000 B: PCIE2 + okno backplane)
+ *   /dev/omwifi-tcm  + mmap(offset 0) = BAR2 (0x200000 B: RAM fw / TCM)
+ *
+ * BRAMKA BAR0: tylko przy `irq off`. ISR (om_isr_*) czyta i W1C-pisze BAR0 BEZ
+ * om_lock, a BAR0 jest OKNEM na backplane -- gdyby uzbrojone przerwanie trafilo
+ * w chwile, gdy userspace ma okno przestawione na inny rdzen (np. strona D11),
+ * ISR czytalby i W1C-pisal rejestr TEGO rdzenia. Dlatego w obie strony:
+ * mmap BAR0 odmawia przy `irq on`, a `irq on` odmawia, gdy zyje jakikolwiek
+ * mmap BAR0. BAR2 (TCM) bramki nie ma -- to zwykla pamiec, bez okna i bez
+ * udzialu ISR.
+ */
+
+static void om_vma_zamknij(struct vm_area_struct *vma)
+{
+	mutex_lock(&om_lock);
+	if (om && om->bar0_mapy > 0)
+		om->bar0_mapy--;
+	mutex_unlock(&om_lock);
+}
+
+static const struct vm_operations_struct om_vm_ops = {
+	.close = om_vma_zamknij,
+};
+
+static int om_mmap_bar(struct file *f, struct vm_area_struct *vma, int bar)
+{
+	struct om_bridge *b;
+	unsigned long len = vma->vm_end - vma->vm_start;
+	resource_size_t rozmiar = 0;
+	int err = 0;
+
+	if (mutex_lock_interruptible(&om_lock))
+		return -ERESTARTSYS;
+	b = om;
+	if (!b || !b->bar0 || !b->bar2) {
+		mutex_unlock(&om_lock);
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: most nie trzyma karty\n", bar);
+		return -ENODEV;
+	}
+	rozmiar = pci_resource_len(b->pdev, bar);
+	if (vma->vm_pgoff || !len || len > rozmiar) {
+		err = -EINVAL;
+		goto wyjdz;
+	}
+	if (bar == 0 && b->irq_on) {
+		err = -EBUSY;
+		goto wyjdz;
+	}
+	/* pgprot_device: ten sam typ pamieci co pci_iomap wyzej (x86: UC-), inaczej
+	 * x86/PAT odmowilby drugiego mapowania (-EBUSY "conflicting memory types"). */
+	if (remap_pfn_range(vma, vma->vm_start,
+			    (unsigned long)(pci_resource_start(b->pdev, bar) >> PAGE_SHIFT),
+			    len, pgprot_device(vma->vm_page_prot))) {
+		err = -EAGAIN;
+		goto wyjdz;
+	}
+	vma->vm_ops = &om_vm_ops;
+	if (bar == 0)
+		b->bar0_mapy++;
+	/* Log bez bufora odpowiedzi (b = NULL): mmap nie jest komenda i nie moze
+	 * zjadac odpowiedzi czekajacej na `cat /dev/omwifi`. */
+	om_linia(NULL, 2, OM_NAZWA ": mmap: BAR%d 0x%lx B -> userspace%s\n",
+		 bar, len,
+		 bar == 0 ? " (BAR0 = okno: dopoki to mapowanie zyje, `irq on` odmowi)"
+			  : " (TCM)");
+	mutex_unlock(&om_lock);
+	return 0;
+
+wyjdz:
+	if (err == -EBUSY)
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR0: ODMOWA -- IRQ jest uzbrojone (`irq on`), a BAR0 jest oknem, ktore ISR czyta i W1C-pisze bez om_lock. Zrob `irq off` i powtorz.\n");
+	else if (err == -EINVAL)
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: zle parametry (pgoff=0x%lx, len=0x%lx, BAR ma 0x%llx B) -- umowa: offset 0, len <= rozmiar BAR-u\n",
+			 bar, vma->vm_pgoff, len, (unsigned long long)rozmiar);
+	else
+		om_linia(NULL, 1, OM_NAZWA ": mmap BAR%d: remap_pfn_range nieudane (0x%lx B @0x%llx)\n",
+			 bar, len, (unsigned long long)pci_resource_start(b->pdev, bar));
+	mutex_unlock(&om_lock);
+	return err;
+}
+
+static int om_mmap_bar0(struct file *f, struct vm_area_struct *vma)
+{
+	return om_mmap_bar(f, vma, 0);
+}
+
+static int om_mmap_bar2(struct file *f, struct vm_area_struct *vma)
+{
+	return om_mmap_bar(f, vma, 2);
+}
+
 static const struct file_operations om_fops = {
 	.owner = THIS_MODULE,
 	.read = om_fop_read,
 	.write = om_fop_write,
+	.mmap = om_mmap_bar0,
+	.llseek = noop_llseek,
+};
+
+/* Osobny wezel dla BAR2 (TCM): mmap na /dev/omwifi ma z gory ustalone znaczenie
+ * (BAR0), a rozpoznawanie BAR-u po offsecie byloby zgadywanka. Ten wezel
+ * obsluguje WYLACZNIE mmap -- read/write na nim nie istnieja. */
+static const struct file_operations om_fops_tcm = {
+	.owner = THIS_MODULE,
+	.mmap = om_mmap_bar2,
 	.llseek = noop_llseek,
 };
 
