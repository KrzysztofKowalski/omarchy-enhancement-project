+	 * (printk records cap at ~1 KB); the first line carries the
+	 * "LEN=<n> vars=<...>" prefix the fire script greps for, the
+	 * rest are continuation chunks. */
+	if (pos == 0) {
+		pr_emerg("BCM4360 test.320: LEN=<%u> vars=<> (empty vars text -- %u B incl. token; fallback to the .txt kit)\n",
+			 (u32)(padded + sizeof(token_le)), *out_len);
+		kfree(buf);
+		return NULL;
+	}
