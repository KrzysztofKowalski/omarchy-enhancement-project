+static uint bcm4360_test320_sprom_nvram;
+module_param(bcm4360_test320_sprom_nvram, uint, 0644);
+MODULE_PARM_DESC(bcm4360_test320_sprom_nvram, "BCM4360 test.320 (M2, fire #15; notes/ sec.4 M2 -- full NVRAM from the chip's own SROM instead of the 13/15-var .txt kit): (a) PRE-release inside download_fw_nvram (ARM halted, BAR0 window) select PCIE2 core and read the WHOLE SROM/CIS shadow at PCIe core +0x800 (256 dwords = 1024 B -- kimptoc test.36-42: contains REAL Apple board data and is writable), log it as hex dumps (interleaved with printk -- the safe class, <=8 dwords per pr_emerg line; the 25-dword burst that killed printk in fire #10 is forbidden), then a raw CIS tuple walk (tag/len, kimptoc test.40 style) and a best-effort SROM rev 8/11 field extraction (SSB-style rev8 word offsets per include/linux/ssb/ssb_regs.h AND wl-style SROM11 dword offsets per kimptoc level-3 write test; fields: boardtype, boardrev, boardflags[0..1], sromrev, ccode, macaddr; the layout with a valid sromrev [4..12] wins, both interpretations are logged with the raw words; unparseable fields are logged raw, marked zero and warned -- nothing is invented). (b) Build the FULL vars text on the CFE pattern (boardtype/boardrev/boardflags/sromrev from the shadow, xtalfreq raw (0 when absent -- warned, NOT defaulted to 25000/40000), clkfreq=800,666 (CFE AC68U default), devpath=pci/<bus>/<dev> from pdev, wl0_macaddr + macaddr (from the shadow when valid -- nonzero, unicast -- else the .txt value with a warning), ccode (same rule), + wlunit=0 + the remaining keys kept byte-for-byte from the .txt kit (boardflags2/3, boardnum, regrev, vendid, devid, aa2g, aa5g)) -- then insert it at the EXACT same path the current vars use (download_fw_nvram: copy to rambase+ramsize-len, end token at TCM[ramsize-4], test276 varsz/vars16 snapshot follows the same buffer). Log: one 'test320: LEN=<n> vars=<full varbuf>' pr_emerg line (space-separated keys) + per-key lines with the layout and SROM source. test316 (R3b zero-NVRAM) takes precedence with a log line; test315 (R3a strip) is subsumed by the full replacement. Everything default (0) = byte-identical behavior. Fire discriminator: console wr_idx >0x27d (637) or new console output => the vars content (not the absence/wrongness of it) is the boot lever. (1=enable, 0=off)");
+
 static int bcm4360_test308_olmsg_cdc;
 module_param(bcm4360_test308_olmsg_cdc, int, 0644);
 MODULE_PARM_DESC(bcm4360_test308_olmsg_cdc, "BCM4360 test.308: PCI-CDC (olmsg) transport, phase 1+2. Phase 1: replace the msgbuf sharedram-ptr handshake poll (TCM[ramsize-4], guaranteed -ENODEV on this fw) with a best-effort si[+0x2028] poll (10 ms x 200, then CONTINUE), skip msgbuf shared-struct/ring setup, proto_type=BCDC. Phase 2: txctl/rxctl over the olmsg ring (T276 DMA buffer -- requires bcm4360_test276_shared_info=1), D2H drain in the threaded ISR on BAR0+0x48 bit 8, per-cycle mask BAR0+0x4C |= 0x100. txdata stays a stub until phase 3. Gated: only for chip 4360; all other chips keep the msgbuf path. (1=enable, 0=off)");
@@ -1696,6 +1700,473 @@
 }
 
 
+/* ==== BCM4360 test.320 (M2): SPROM-shadow NVRAM vars ====
+ * The .txt vars kit (brcmf_fw_nvram_strip output) is replaced by vars
+ * built from the chip's OWN SROM/CIS shadow at PCIe core +0x800
+ * (kimptoc test.36-42: REAL Apple board data, writable, first 28 dwords
+ * = CIS tuples). Format of the replacement = EXACTLY the strip output:
+ * NUL-separated "key=value" entries, zero padding to a 4 B boundary and
+ * the end token (~len/4 << 16 | len/4, LE) that lands at TCM[ramsize-4].
+ * If the shadow is unparseable (or fields read zero -- the shadow is
+ * mostly zero beyond the first 28 dwords on the 4360), the fields are
+ * logged raw, marked zero/warned -- never invented. */
+#define BCM4360_T320_SPROM_SHADOW_BYTES	1024	/* PCIe core +0x800, 256 dwords */
+#define BCM4360_T320_SPROM_DWORDS	(BCM4360_T320_SPROM_SHADOW_BYTES / 4)
+#define BCM4360_T320_VARBUF_MAX		2048	/* built text + padding + token */
+
+/* Word offsets (16-bit LE words of the shadow) -- SSB-style rev8 per
+ * include/linux/ssb/ssb_regs.h (SPOFF = byte/2). */
+#define BCM4360_T320_W_REV_SSB		0x003f	/* byte 0x7e: revision/CRC */
+#define BCM4360_T320_W_BOARDTYPE_SSB	0x0002	/* byte 0x04 (SPROM1_SPID) */
+#define BCM4360_T320_W_BOARDREV_SSB	0x0041	/* byte 0x82 */
+#define BCM4360_T320_W_BFLLO_SSB	0x0042	/* byte 0x84 */
+#define BCM4360_T320_W_BFLHI_SSB	0x0043	/* byte 0x86 */
+#define BCM4360_T320_W_BFL2LO_SSB	0x0044	/* byte 0x88 */
+#define BCM4360_T320_W_BFL2HI_SSB	0x0045	/* byte 0x8a */
+#define BCM4360_T320_W_MAC_SSB		0x0046	/* byte 0x8c: 6 B IL0MAC */
+#define BCM4360_T320_W_CCODE_SSB	0x0049	/* byte 0x92: 2 B alpha2 */
+/* Dword offsets -- wl-style SROM11 per kimptoc level-3 write test
+ * (bcm4360_test.c: sromrev at word 48, boardtype/boardrev at dword 33,
+ * boardflags at dword 35, ccode at dword 44, antenna at dword 49). */
+#define BCM4360_T320_D_REV		0x18	/* dword 24 = word 48 */
+#define BCM4360_T320_D_SVID_DEVID	0x20	/* dword 32 = subvid|devid */
+#define BCM4360_T320_D_BOARDTYPE	0x21	/* dword 33 = boardtype|boardrev */
+#define BCM4360_T320_D_BFL		0x23	/* dword 35 = boardflags */
+#define BCM4360_T320_D_BFL2		0x24	/* dword 36 */
+#define BCM4360_T320_D_CCODE		0x2c	/* dword 44 */
+
+struct bcm4360_t320_fields {
+	enum {
+		BCM4360_T320_LAYOUT_NONE = 0,
+		BCM4360_T320_LAYOUT_SSB8,
+		BCM4360_T320_LAYOUT_WL11
+	} layout;
+	u16 sromrev;
+	u16 boardtype;
+	u16 boardrev;
+	u32 boardflags;
+	u32 boardflags2;
+	u8 mac[6];
+	bool mac_valid;
+	char ccode[3];
+	bool ccode_valid;
+	u16 xtalfreq;
+	u32 subvid;
+	u32 devid;
+};
+
+static u16 bcm4360_t320_word(const u32 *shadow, u32 word)
+{
+	return (u16)(shadow[word >> 1] >> ((word & 1) << 4));
+}
+
+static bool bcm4360_t320_sromrev_ok(u16 rev)
+{
+	return rev >= 4 && rev <= 12;
+}
+
+/* Whole shadow read: select PCIE2 in the BAR0 window (the SROM/CIS
+ * shadow lives in the PCIe core at +0x800) and read 256 dwords; every
+ * 8-dword line is printed IMMEDIATELY after it is read (interleaved
+ * read/print -- the class that survived all fires; no buffered burst).
+ * ARM is halted here (host side) -- same access class as the proven
+ * T305/P1 PRE-release BAR0 reads. */
+static void bcm4360_t320_shadow_read(struct brcmf_pciedev_info *devinfo,
+				     u32 *shadow)
+{
+	u32 i;
+
+	pr_emerg("BCM4360 test.320: SROM/CIS shadow read START (PCIe core +0x800, %u dwords = %u B, BAR0 win select, ARM halted)\n",
+		 BCM4360_T320_SPROM_DWORDS, BCM4360_T320_SPROM_SHADOW_BYTES);
+	brcmf_pcie_select_core(devinfo, BCMA_CORE_PCIE2);
+	for (i = 0; i < BCM4360_T320_SPROM_DWORDS; i++)
+		shadow[i] = brcmf_pcie_read_reg32(devinfo, 0x800 + i * 4);
+	pr_emerg("BCM4360 test.320: SROM/CIS shadow read END (%u dwords)\n",
+		 BCM4360_T320_SPROM_DWORDS);
+	for (i = 0; i < BCM4360_T320_SPROM_DWORDS; i += 8) {
+		pr_emerg("BCM4360 test.320: srom[%03x..%03x]: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 i, i + 7, shadow[i], shadow[i + 1], shadow[i + 2],
+			 shadow[i + 3], shadow[i + 4], shadow[i + 5],
+			 shadow[i + 6], shadow[i + 7]);
+	}
+	/* raw byte view (dword LE), first 128 B */
+	pr_emerg("BCM4360 test.320: CIS bytes (dword LE), first 128 B:\n");
+	for (i = 0; i < 128; i += 16)
+		pr_emerg("BCM4360 test.320: CIS %03x: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			 i,
+			 (unsigned int)((shadow[(i + 0) >> 2] >> (((i + 0) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 1) >> 2] >> (((i + 1) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 2) >> 2] >> (((i + 2) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 3) >> 2] >> (((i + 3) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 4) >> 2] >> (((i + 4) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 5) >> 2] >> (((i + 5) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 6) >> 2] >> (((i + 6) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 7) >> 2] >> (((i + 7) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 8) >> 2] >> (((i + 8) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 9) >> 2] >> (((i + 9) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 10) >> 2] >> (((i + 10) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 11) >> 2] >> (((i + 11) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 12) >> 2] >> (((i + 12) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 13) >> 2] >> (((i + 13) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 14) >> 2] >> (((i + 14) & 3) * 8)) & 0xff),
+			 (unsigned int)((shadow[(i + 15) >> 2] >> (((i + 15) & 3) * 8)) & 0xff));
+}
+
+/* Raw CIS tuple walk over the shadow bytes (kimptoc test.40 style:
+ * tag/len pairs, 0xff = END, len==0 or overrun = break; one pr_emerg
+ * line per tuple with the first <=16 data bytes in hex). */
+static void bcm4360_t320_cis_walk(const u32 *shadow)
+{
+	u32 i = 0;
+	u8 line[96];
+	u32 nl;
+
+	pr_emerg("BCM4360 test.320: CIS tuple walk START\n");
+	while (i + 1 < BCM4360_T320_SPROM_SHADOW_BYTES) {
+		u32 tag, tlen, d;
+
+		tag = (shadow[i >> 2] >> ((i & 3) * 8)) & 0xff;
+		if (tag == 0xff) {
+			pr_emerg("BCM4360 test.320: CIS @%03x: END\n", i);
+			break;
+		}
+		tlen = (shadow[(i + 1) >> 2] >> (((i + 1) & 3) * 8)) & 0xff;
+		if (tlen == 0 ||
+		    i + 2 + tlen > BCM4360_T320_SPROM_SHADOW_BYTES) {
+			pr_emerg("BCM4360 test.320: CIS @%03x: tag=0x%02x len=%u (break)\n",
+				 i, tag, tlen);
+			break;
+		}
+		nl = 0;
+		for (d = 0; d < tlen && d < 16; d++) {
+			u32 bj = i + 2 + d;
+
+			nl += snprintf(&line[nl], sizeof(line) - nl, "%02x ",
+				       (unsigned int)((shadow[bj >> 2] >>
+						      ((bj & 3) * 8)) & 0xff));
+		}
+		pr_emerg("BCM4360 test.320: CIS @%03x: tag=0x%02x len=%u data: %s\n",
+			 i, tag, tlen, line);
+		i += 2 + tlen;
+	}
+	pr_emerg("BCM4360 test.320: CIS tuple walk END\n");
+}
+
+static bool bcm4360_t320_mac_valid(const u8 *mac)
+{
+	u32 i;
+	bool nz = false;
+
+	for (i = 0; i < 6; i++) {
+		if (mac[i])
+			nz = true;
+		if (mac[i] == 0xff)
+			return false;	/* 0xff = unset byte */
+	}
+	return nz && !(mac[0] & 0x01);	/* not all-zero, unicast */
+}
+
+/* Field extraction -- both candidate layouts are decoded from the raw
+ * shadow words; the one whose sromrev validates [4..12] wins (SSB: word
+ * 63, wl-SROM11: word 48). Fields that the chosen layout does not
+ * define (mac: SSB only; xtalfreq: neither) are filled from the SSB
+ * offsets / zeroed and flagged in the per-field logs here (the builder
+ * re-warns). */
+static void bcm4360_t320_extract(const u32 *shadow,
+				 struct bcm4360_t320_fields *f)
+{
+	u16 rev_ssb, rev_wl, w;
+	u32 i;
+
+	memset(f, 0, sizeof(*f));
+	rev_ssb = bcm4360_t320_word(shadow, BCM4360_T320_W_REV_SSB) & 0xff;
+	rev_wl = bcm4360_t320_word(shadow, BCM4360_T320_D_REV * 2) & 0xff;
+	pr_emerg("BCM4360 test.320: sromrev candidates -- SSB word %u=0x%02x, wl word %u=0x%02x\n",
+		 BCM4360_T320_W_REV_SSB, rev_ssb,
+		 BCM4360_T320_D_REV * 2, rev_wl);
+	if (bcm4360_t320_sromrev_ok(rev_ssb))
+		f->layout = BCM4360_T320_LAYOUT_SSB8;
+	else if (bcm4360_t320_sromrev_ok(rev_wl))
+		f->layout = BCM4360_T320_LAYOUT_WL11;
+	else
+		f->layout = BCM4360_T320_LAYOUT_NONE;
+
+	if (f->layout == BCM4360_T320_LAYOUT_SSB8) {
+		f->sromrev = rev_ssb;
+		f->boardtype = bcm4360_t320_word(shadow,
+						 BCM4360_T320_W_BOARDTYPE_SSB);
+		f->boardrev = bcm4360_t320_word(shadow,
+						BCM4360_T320_W_BOARDREV_SSB);
+		w = bcm4360_t320_word(shadow, BCM4360_T320_W_BFLLO_SSB);
+		f->boardflags = w;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_W_BFLHI_SSB);
+		f->boardflags |= (u32)w << 16;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_W_BFL2LO_SSB);
+		f->boardflags2 = w;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_W_BFL2HI_SSB);
+		f->boardflags2 |= (u32)w << 16;
+		for (i = 0; i < 3; i++) {
+			w = bcm4360_t320_word(shadow,
+					      BCM4360_T320_W_MAC_SSB + i * 2);
+			/* ssb sprom_get_mac: BE within each word */
+			f->mac[i * 2] = w >> 8;
+			f->mac[i * 2 + 1] = w & 0xff;
+		}
+		f->mac_valid = bcm4360_t320_mac_valid(f->mac);
+		w = bcm4360_t320_word(shadow, BCM4360_T320_W_CCODE_SSB);
+		f->ccode[0] = (w >> 8) & 0xff;
+		f->ccode[1] = w & 0xff;
+		f->ccode[2] = '\0';
+		f->ccode_valid = f->ccode[0] >= 0x21 && f->ccode[0] <= 0x7e &&
+				 f->ccode[1] >= 0x21 && f->ccode[1] <= 0x7e;
+	} else if (f->layout == BCM4360_T320_LAYOUT_WL11) {
+		f->sromrev = rev_wl;
+		f->boardtype = bcm4360_t320_word(shadow,
+						 BCM4360_T320_D_BOARDTYPE * 2);
+		f->boardrev = bcm4360_t320_word(shadow,
+						BCM4360_T320_D_BOARDTYPE * 2 + 1);
+		w = bcm4360_t320_word(shadow, BCM4360_T320_D_BFL * 2);
+		f->boardflags = w;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_D_BFL * 2 + 1);
+		f->boardflags |= (u32)w << 16;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_D_BFL2 * 2);
+		f->boardflags2 = w;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_D_BFL2 * 2 + 1);
+		f->boardflags2 |= (u32)w << 16;
+		w = bcm4360_t320_word(shadow, BCM4360_T320_D_CCODE * 2);
+		f->ccode[0] = (w >> 8) & 0xff;
+		f->ccode[1] = w & 0xff;
+		f->ccode[2] = '\0';
+		f->ccode_valid = f->ccode[0] >= 0x21 && f->ccode[0] <= 0x7e &&
+				 f->ccode[1] >= 0x21 && f->ccode[1] <= 0x7e;
+		f->subvid = bcm4360_t320_word(shadow,
+					      BCM4360_T320_D_SVID_DEVID * 2);
+		f->devid = bcm4360_t320_word(shadow,
+					     BCM4360_T320_D_SVID_DEVID * 2 + 1);
+		/* mac: SSB-style offset only (layout-specific offset
+		 * unknown for wl11 -- fall back to the byte-0x8c guess). */
+		for (i = 0; i < 3; i++) {
+			w = bcm4360_t320_word(shadow,
+					      BCM4360_T320_W_MAC_SSB + i * 2);
+			/* ssb sprom_get_mac: BE within each word */
+			f->mac[i * 2] = w >> 8;
+			f->mac[i * 2 + 1] = w & 0xff;
+		}
+		f->mac_valid = bcm4360_t320_mac_valid(f->mac);
+	}
+	/* xtalfreq: no SROM field in either documented layout (it's an
+	 * nvram var on this silicon) -- 0 + warned, per the test spec. */
+	pr_emerg("BCM4360 test.320: extract layout=%s sromrev=%u boardtype=0x%04x boardrev=0x%04x boardflags=0x%08x boardflags2=0x%08x ccode='%s' mac=%pM%s subvid=0x%04x devid=0x%04x xtalfreq=0x0\n",
+		 f->layout == BCM4360_T320_LAYOUT_SSB8 ? "SSB8" :
+		 f->layout == BCM4360_T320_LAYOUT_WL11 ? "WL11" : "NONE",
+		 f->sromrev, f->boardtype, f->boardrev, f->boardflags,
+		 f->boardflags2, f->ccode_valid ? f->ccode : "??",
+		 f->mac, f->mac_valid ? "" : " (invalid -> txt fallback)",
+		 f->subvid, f->devid);
+}
+
+/* Look up a key in the original strip-output vars (text region only --
+ * the last 4 B are the end token). Returns the value (NUL-terminated
+ * copy). */
+static bool bcm4360_t320_txt_get(const u8 *txt, u32 txtlen, const char *key,
+				 char *out, u32 outsz)
+{
+	u32 content = txtlen > sizeof(u32) ? txtlen - sizeof(u32) : 0;
+	u32 i = 0;
+	u32 klen = strlen(key);
+
+	while (i < content) {
+		u32 start = i;
+		u32 elen;
+
+		while (i < content && txt[i])
+			i++;
+		elen = i - start;	/* bytes up to (not incl.) NUL */
+		if (elen > klen + 1 &&
+		    !strncmp((const char *)&txt[start], key, klen) &&
+		    txt[start + klen] == '=') {
+			u32 vlen = elen - klen - 1;
+
+			if (vlen + 1 > outsz)
+				vlen = outsz - 1;
+			memcpy(out, &txt[start + klen + 1], vlen);
+			out[vlen] = '\0';
+			return true;
+		}
+		if (i < content)
+			i++;		/* skip the NUL */
+	}
+	return false;
+}
+
+/* Build the replacement vars buffer (strip-exact format with the end
+ * token) and log it. txt = original .txt vars (fallback), txtlen = its
+ * len incl. token. */
+static u8 *bcm4360_t320_build_nvram(struct brcmf_pciedev_info *devinfo,
+				    const struct bcm4360_t320_fields *f,
+				    const u8 *txt, u32 txtlen, u32 *out_len)
+{
+	u8 *buf;
+	u32 pos = 0, padded, token;
+	__le32 token_le;
+	char val[64];
+	char mac[32];
+	char ccode[8];
+	char txtval[64];
+	u32 i;
+
+	buf = kzalloc(BCM4360_T320_VARBUF_MAX, GFP_KERNEL);
+	if (!buf)
+		return NULL;
+
+	if (f->ccode_valid)
+		snprintf(ccode, sizeof(ccode), "%c%c", f->ccode[0],
+			 f->ccode[1]);
+	else
+		snprintf(ccode, sizeof(ccode), "??");
+
+	#define T320_ADD(fmt, ...) do {						\
+		int t320_n = snprintf((char *)&buf[pos],			\
+				      BCM4360_T320_VARBUF_MAX - pos,		\
+				      fmt, ##__VA_ARGS__);			\
+		if (t320_n > 0 && (u32)t320_n < BCM4360_T320_VARBUF_MAX - pos)	\
+			pos += t320_n + 1;					\
+		else								\
+			pos = BCM4360_T320_VARBUF_MAX;				\
+	} while (0)
+
+	/* SROM primary fields (as-is, zero => warned), then the txt kit. */
+	T320_ADD("sromrev=%u", f->sromrev);
+	if (!f->sromrev)
+		pr_emerg("BCM4360 test.320: WARNING sromrev=0 (no valid SROM rev word -- raw shadow value, not defaulted)\n");
+	T320_ADD("boardtype=0x%04x", f->boardtype);
+	if (!f->boardtype || f->boardtype == 0xffff)
+		pr_emerg("BCM4360 test.320: WARNING boardtype=0x%04x (no valid SROM boardtype -- raw value kept)\n",
+			 f->boardtype);
