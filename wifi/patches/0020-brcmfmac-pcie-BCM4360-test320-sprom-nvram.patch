+		u32 t320_off = 0;
+		bool t320_first = true;
+
+		while (t320_off < pos) {
+			u32 t320_n = min_t(u32, pos - t320_off, 400);
+			u32 t320_k;
+
+			for (t320_k = 0; t320_k < t320_n; t320_k++)
+				t320_line[t320_k] = buf[t320_off + t320_k] ?
+					buf[t320_off + t320_k] : ' ';
+			t320_line[t320_n] = '\0';
+			if (t320_first) {
+				pr_emerg("BCM4360 test.320: LEN=<%u> vars=<%s",
+					 *out_len, t320_line);
+				t320_first = false;
+			} else {
+				pr_emerg("BCM4360 test.320: varscont=<%s", t320_line);
+			}
+			t320_off += t320_n;
+		}
+		if (t320_first)	/* pos == 0 guarded above */
+			pr_emerg("BCM4360 test.320: LEN=<%u> vars=<>\n", *out_len);
+		else
+			pr_emerg("BCM4360 test.320: end of vars (token 0x%08x at +0x%u, total %u B)\n",
+				 (u32)le32_to_cpu(token_le), padded, *out_len);
+	}
+	return buf;
+}
