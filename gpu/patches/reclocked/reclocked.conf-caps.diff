 # v4.1: "preferred" window titles (substring, case-insensitive). Discord/YouTube
 # are browser tabs (the window class = the browser) — the content is visible in
 # the title. Discord web: the title contains "Discord". YouTube: "YouTube" / " - YouTube".
+# v4.4: applies ONLY to browser tabs (chromium/firefox etc. class) — the desktop
+# Discord (Electron or PWA Chrome) is handled by [caps].
 [preferred-titles]
 Discord
 YouTube
  - YouTube
 
+# v4.4: per-class policy. Key = window class; value = floor=…, max=…, busy-up=…
+#   floor    — resting state (IDLE never drops below), hex pstate (e.g. 0a)
+#   max      — ceiling (never above this), hex pstate (e.g. 0e)
+#   busy-up  — own UP-LOAD threshold (%), instead of the global busy-up (80)
+# A class with an entry = preferred (when focused) and does NOT take title-priority.
+# Desktop Discord — two possible classes (unclear which the user uses):
+#   - Electron:  "discord"
+#   - PWA Chrome: "chrome-discord.com__channels_@me-Default"
+# Policy: base 0a (idle holds 0a), busy > 50% → 0e, busy drops → back to 0a.
+# TERMAL stays top priority (may go below the floor). A Discord tab in the browser
+# (chromium/firefox etc.) is NOT in [caps] → title force-0e unchanged.
+[caps]
+discord = floor=0a, max=0e, busy-up=50
+chrome-discord.com__channels_@me-Default = floor=0a, max=0e, busy-up=50
+
 # v4.1: "low-power" window classes (terminals). Window focus from this list →
 # forces the default profile (cap=07) with priority over preferred — even if
 # Discord/YouTube generates background load, the focused terminal holds 07.
